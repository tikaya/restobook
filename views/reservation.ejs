<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  .resa-hero {
    background: var(--bordeaux); padding: 4rem 2rem 5rem;
    text-align: center; position: relative; overflow: hidden;
  }
  .resa-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(201,168,76,0.1), transparent); }
  .resa-hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 50px; background: var(--creme); clip-path: ellipse(55% 100% at 50% 100%); }
  .resa-hero-content { position: relative; z-index: 1; }
  .resa-hero-eyebrow { font-family: 'DM Sans', sans-serif; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--or); margin-bottom: 0.75rem; }
  .resa-hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 5vw, 3.5rem); color: #fff; font-weight: 700; margin-bottom: 0.5rem; }
  .resa-hero h1 em { font-style: italic; color: var(--or); }
  .resa-hero p { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; color: rgba(255,255,255,0.65); font-style: italic; }

  .resa-page { background: var(--creme); padding: 3rem 2rem 5rem; }
  .resa-layout { max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 1.5rem; align-items: start; }

  .resa-card { background: #fff; border: 1px solid var(--creme-dark); border-radius: 16px; padding: 2rem; box-shadow: 0 4px 24px rgba(61,43,31,0.06); }
  .resa-card-eyebrow { font-family: 'DM Sans', sans-serif; font-size: 0.68rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--or); margin-bottom: 0.4rem; }
  .resa-card-title { font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--bordeaux); margin-bottom: 0.3rem; }
  .resa-card-line { width: 36px; height: 2px; background: var(--or); margin-bottom: 1.5rem; border-radius: 2px; }

  .resa-msg { display: none; padding: 0.875rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.85rem; font-weight: 500; line-height: 1.5; }
  .resa-msg.success { background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); }
  .resa-msg.error   { background: #fdecea; color: #c62828; border: 1px solid rgba(198,40,40,0.2); }
  .resa-msg.warning { background: #fff3e0; color: #e65100; border: 1px solid rgba(230,81,0,0.2); }

  .resa-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-label { font-family: 'DM Sans', sans-serif; font-size: 0.72rem; font-weight: 500; color: var(--brun-light); text-transform: uppercase; letter-spacing: 0.08em; }
  .form-input { width: 100%; padding: 0.7rem 0.9rem; border: 1.5px solid var(--creme-dark); border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 0.875rem; color: var(--brun); background: var(--creme); transition: border-color 0.2s, box-shadow 0.2s; outline: none; resize: vertical; }
  .form-input:focus { border-color: var(--bordeaux); background: #fff; box-shadow: 0 0 0 3px rgba(107,26,42,0.08); }
  .form-input.invalid { border-color: #c62828; background: #fff8f8; }
  .form-hint { font-size: 0.7rem; color: var(--brun-light); font-style: italic; margin-top: 0.2rem; }
  .form-hint.error-hint { color: #c62828; }

  .emplacement-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .emplacement-pills { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .emplacement-pill { display: flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; border: 1.5px solid var(--creme-dark); border-radius: 50px; background: var(--creme); font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 500; color: var(--brun-light); cursor: pointer; transition: all 0.2s; user-select: none; }
  .emplacement-pill:hover { border-color: var(--bordeaux); color: var(--bordeaux); }
  .emplacement-pill.active { background: var(--bordeaux); color: #fff; border-color: var(--bordeaux); }
  .emplacement-pill input { display: none; }
  .emplacement-note { font-size: 0.72rem; color: var(--brun-light); font-style: italic; margin-top: 0.15rem; }

  .form-section-title { font-family: 'Playfair Display', serif; font-size: 0.9rem; color: var(--bordeaux); font-weight: 600; padding-bottom: 0.5rem; border-bottom: 1px solid var(--creme-dark); margin-top: 0.5rem; }

  .btn-submit { width: 100%; padding: 0.9rem; background: var(--bordeaux); color: #fff; border: none; border-radius: 8px; font-family: 'DM Sans', sans-serif; font-size: 0.9rem; font-weight: 600; letter-spacing: 0.04em; cursor: pointer; transition: all 0.2s; margin-top: 0.5rem; }
  .btn-submit:hover { background: #8B2A3A; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(107,26,42,0.3); }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .resa-sidebar { display: flex; flex-direction: column; gap: 1rem; }
  .sidebar-card { background: #fff; border: 1px solid var(--creme-dark); border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(61,43,31,0.04); }
  .sidebar-card-title { font-family: 'Playfair Display', serif; font-size: 1rem; color: var(--bordeaux); margin-bottom: 0.3rem; }
  .sidebar-card-line { width: 28px; height: 2px; background: var(--or); margin-bottom: 1rem; border-radius: 2px; }

  .info-item { display: flex; gap: 0.75rem; align-items: flex-start; margin-bottom: 0.9rem; font-family: 'DM Sans', sans-serif; font-size: 0.8rem; color: var(--brun-light); line-height: 1.5; }
  .info-item:last-child { margin-bottom: 0; }
  .info-icon { font-size: 1rem; flex-shrink: 0; margin-top: 0.1rem; }
  .info-item strong { color: var(--brun); display: block; margin-bottom: 0.1rem; }
  .info-item.ferme strong { color: #c62828; }

  .auth-chip { display: flex; align-items: center; gap: 0.5rem; background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); border-radius: 8px; padding: 0.6rem 0.9rem; font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 500; }
  .auth-chip-warn { background: #fdf6e3; color: #7a5c00; border-color: rgba(201,168,76,0.3); }

  @media (max-width: 768px) { .resa-layout { grid-template-columns: 1fr; } .form-row-3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .form-row-2, .form-row-3 { grid-template-columns: 1fr; } .emplacement-pills { flex-direction: column; } }
</style>

<section class="resa-hero">
  <div class="resa-hero-content">
    <p class="resa-hero-eyebrow">Le Gourmet Parisien</p>
    <h1>Reserver une <em>table</em></h1>
    <p>Quelques clics pour une experience inoubliable</p>
  </div>
</section>

<div class="resa-page">
  <div class="resa-layout">

    <div class="resa-card">
      <p class="resa-card-eyebrow">Formulaire</p>
      <h2 class="resa-card-title">Votre reservation</h2>
      <div class="resa-card-line"></div>

      <div class="resa-msg" id="message"></div>

      <form id="reservation-form" class="resa-form">

        <p class="form-section-title">Vos coordonnees</p>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">Nom *</label>
            <input type="text" name="nom" class="form-input" placeholder="Dupont" required>
          </div>
          <div class="form-group">
            <label class="form-label">Prenom *</label>
            <input type="text" name="prenom" class="form-input" placeholder="Jean" required>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">Email *</label>
            <input type="email" name="email" class="form-input" placeholder="jean@email.com" required>
          </div>
          <div class="form-group">
            <label class="form-label">Telephone *</label>
            <input type="tel" name="telephone" class="form-input" placeholder="06 00 00 00 00" required>
          </div>
        </div>

        <p class="form-section-title">Details de la reservation</p>

        <div class="form-row-3">
          <div class="form-group">
            <label class="form-label">Date *</label>
            <input type="date" name="date_reservation" id="input-date" class="form-input" required>
            <span class="form-hint" id="hint-date">Nous sommes fermes le lundi</span>
          </div>
          <div class="form-group">
            <label class="form-label">Heure *</label>
            <input type="time" name="heure_reservation" id="input-heure" class="form-input" required>
            <span class="form-hint" id="hint-heure">Choisir une date d'abord</span>
          </div>
          <div class="form-group">
            <label class="form-label">Personnes *</label>
            <input type="number" name="nb_personnes" class="form-input" min="1" max="20" value="2" required>
          </div>
        </div>

        <div class="emplacement-group">
          <label class="form-label">Emplacement souhaite</label>
          <div class="emplacement-pills" id="emplacement-pills">
            <label class="emplacement-pill active" onclick="selectEmplacement(this, '')">
              <input type="radio" name="emplacement_table" value="" checked>
              Pas de preference
            </label>
            <label class="emplacement-pill" onclick="selectEmplacement(this, 'interieur')">
              <input type="radio" name="emplacement_table" value="interieur">
              Interieur
            </label>
            <label class="emplacement-pill" onclick="selectEmplacement(this, 'terrasse')">
              <input type="radio" name="emplacement_table" value="terrasse">
              Terrasse
            </label>
            <label class="emplacement-pill" onclick="selectEmplacement(this, 'salon_prive')">
              <input type="radio" name="emplacement_table" value="salon_prive">
              Salon prive
            </label>
          </div>
          <p class="emplacement-note">Si l'emplacement souhaite n'est pas disponible, une alternative vous sera proposee.</p>
        </div>

        <div class="form-group">
          <label class="form-label">Demandes speciales</label>
          <textarea name="demandes_speciales" class="form-input" rows="3" placeholder="Allergie, anniversaire, chaise haute..."></textarea>
        </div>

        <button type="submit" class="btn-submit" id="btn-submit">
          Confirmer ma reservation
        </button>

      </form>
    </div>

    <div class="resa-sidebar">

      <div class="sidebar-card">
        <div id="auth-status"></div>
      </div>

      <div class="sidebar-card">
        <h3 class="sidebar-card-title">Nos espaces</h3>
        <div class="sidebar-card-line"></div>
        <div class="info-item">
          <span class="info-icon">&#127968;</span>
          <div><strong>Interieur</strong>Ambiance chaleureuse et feutree, ideale par tous temps</div>
        </div>
        <div class="info-item">
          <span class="info-icon">&#127807;</span>
          <div><strong>Terrasse</strong>En plein air, disponible selon la meteo d'avril a octobre</div>
        </div>
        <div class="info-item">
          <span class="info-icon">&#10024;</span>
          <div><strong>Salon prive</strong>Espace privatisable pour vos evenements (min. 6 pers.)</div>
        </div>
      </div>

      <div class="sidebar-card">
        <h3 class="sidebar-card-title">Nos horaires</h3>
        <div class="sidebar-card-line"></div>
        <div class="info-item ferme">
          <span class="info-icon">&#128197;</span>
          <div><strong>Lundi</strong>Ferme</div>
        </div>
        <div class="info-item">
          <span class="info-icon">&#128197;</span>
          <div><strong>Mardi - Vendredi</strong>12h - 14h30 · 19h - 22h30<br><span style="font-size:0.7rem;color:#c62828;">Derniere resa : 14h · 21h30</span></div>
        </div>
        <div class="info-item">
          <span class="info-icon">&#128197;</span>
          <div><strong>Samedi</strong>12h - 15h · 19h - 23h<br><span style="font-size:0.7rem;color:#c62828;">Derniere resa : 14h30 · 22h</span></div>
        </div>
        <div class="info-item">
          <span class="info-icon">&#128197;</span>
          <div><strong>Dimanche</strong>12h - 15h<br><span style="font-size:0.7rem;color:#c62828;">Derniere resa : 14h30</span></div>
        </div>
      </div>

      <div class="sidebar-card">
        <h3 class="sidebar-card-title">Infos pratiques</h3>
        <div class="sidebar-card-line"></div>
        <div class="info-item">
          <span class="info-icon">&#128205;</span>
          <div><strong>Adresse</strong>12 rue des Archives, 75004 Paris</div>
        </div>
        <div class="info-item">
          <span class="info-icon">&#128222;</span>
          <div><strong>Telephone</strong>01 23 45 67 89</div>
        </div>
        <div class="info-item">
          <span class="info-icon">&#128101;</span>
          <div><strong>Groupes</strong>Pour plus de 10 pers., appelez-nous directement</div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function getToken() {
    return document.cookie.split('; ').find(c => c.startsWith('token='))?.split('=')[1];
  }
  function getUserFromCookie() {
    try {
      var raw = document.cookie.split('; ').find(c => c.startsWith('user='))?.split('=').slice(1).join('=');
      return raw ? JSON.parse(decodeURIComponent(raw)) : null;
    } catch { return null; }
  }

  var user  = getUserFromCookie();
  var token = getToken();

  // Statut connexion
  var authEl = document.getElementById('auth-status');
  if (user && token) {
    var nom = user.prenom || user.email?.split('@')[0] || 'vous';
    authEl.innerHTML = '<div class="auth-chip">Connecte en tant que <strong style="margin-left:0.25rem">' + nom + '</strong></div>';
    if (user.prenom) document.querySelector('input[name="prenom"]').value = user.prenom;
    if (user.nom)    document.querySelector('input[name="nom"]').value    = user.nom;
    if (user.email)  document.querySelector('input[name="email"]').value  = user.email;
  } else {
    authEl.innerHTML = '<div class="auth-chip auth-chip-warn">Vous n\'etes pas connecte — <a href="/login" style="color:inherit;font-weight:700;">Se connecter</a></div>';
  }

  // ── Validation horaires ───────────────────────────────────
  var dateInput  = document.getElementById('input-date');
  var heureInput = document.getElementById('input-heure');
  var hintDate   = document.getElementById('hint-date');
  var hintHeure  = document.getElementById('hint-heure');

  dateInput.min = new Date().toISOString().split('T')[0];

  var horaires = {
    0: { label: 'Dimanche : 12h-14h30 (derniere resa 14h30)',       services: [[720, 870]] },
    1: { label: 'Ferme le lundi',                                    services: [] },
    2: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    3: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    4: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    5: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    6: { label: 'Samedi : 12h-14h30 · 19h-22h (dernieres resas)',  services: [[720, 870], [1140, 1320]] }
  };

  function getJour(dateVal) {
    if (!dateVal) return null;
    var parts = dateVal.split('-');
    return new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2])).getDay();
  }

  function isHeureValide(jour, heure) {
    if (!heure || !horaires[jour]) return false;
    var parts = heure.split(':');
    var totalMin = parseInt(parts[0]) * 60 + parseInt(parts[1]);
    return horaires[jour].services.some(function(s) { return totalMin >= s[0] && totalMin <= s[1]; });
  }

  dateInput.addEventListener('change', function() {
    var jour = getJour(this.value);
    if (jour === null) return;
    if (jour === 1) {
      this.classList.add('invalid');
      hintDate.textContent = 'Ferme le lundi — choisissez un autre jour.';
      hintDate.classList.add('error-hint');
      this.value = '';
      heureInput.value = '';
      hintHeure.textContent = 'Choisir une date d\'abord';
    } else {
      this.classList.remove('invalid');
      hintDate.textContent = horaires[jour].label;
      hintDate.classList.remove('error-hint');
      heureInput.value = '';
      hintHeure.textContent = horaires[jour].label;
      document.getElementById('message').style.display = 'none';
    }
  });

  heureInput.addEventListener('change', function() {
    var jour = getJour(dateInput.value);
    if (jour === null) {
      showMsg(false, 'Veuillez d\'abord choisir une date.');
      this.value = '';
      return;
    }
    if (!isHeureValide(jour, this.value)) {
      this.classList.add('invalid');
      hintHeure.textContent = 'Heure hors service — ' + horaires[jour].label;
      hintHeure.classList.add('error-hint');
      showMsg(false, 'Heure invalide. ' + horaires[jour].label);
    } else {
      this.classList.remove('invalid');
      hintHeure.textContent = 'Heure valide';
      hintHeure.classList.remove('error-hint');
      document.getElementById('message').style.display = 'none';
    }
  });

  var selectedEmplacement = '';
  function selectEmplacement(pill, value) {
    document.querySelectorAll('.emplacement-pill').forEach(function(p) { p.classList.remove('active'); });
    pill.classList.add('active');
    selectedEmplacement = value;
  }

  function showMsg(ok, text) {
    var msg = document.getElementById('message');
    msg.className = 'resa-msg ' + (ok ? 'success' : 'error');
    msg.style.display = 'block';
    msg.textContent = text;
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.getElementById('reservation-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var form = e.target;
    var btn  = document.getElementById('btn-submit');

    var jour = getJour(dateInput.value);
    if (jour === 1) { showMsg(false, 'Nous sommes fermes le lundi.'); return; }
    if (!isHeureValide(jour, heureInput.value)) {
      showMsg(false, 'Heure invalide. ' + (horaires[jour] ? horaires[jour].label : ''));
      return;
    }

    btn.disabled    = true;
    btn.textContent = 'Envoi en cours...';

    var data = {
      date_reservation:   form.date_reservation.value,
      heure_reservation:  form.heure_reservation.value,
      nb_personnes:       parseInt(form.nb_personnes.value),
      demandes_speciales: form.demandes_speciales.value.trim() || null,
      id_client:          user ? user.id : null,
      emplacement_table:  selectedEmplacement || null
    };

    try {
      var res = await fetch('/reservations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': token ? 'Bearer ' + token : '' },
        body: JSON.stringify(data)
      });
      var result = await res.json();

      if (res.ok) {
        // ✅ Afficher confirmation puis rediriger vers l'espace client
        var emplacementLabels = { interieur: 'en interieur', terrasse: 'en terrasse', salon_prive: 'en salon prive' };
        var emplacementMsg = result.emplacement_table
          ? ' (' + (emplacementLabels[result.emplacement_table] || result.emplacement_table) + ')'
          : '';
        showMsg(true, 'Reservation confirmee' + emplacementMsg + ' ! Redirection vers votre espace...');
        btn.textContent = 'Reservation confirmee !';
        setTimeout(function() {
          if (user && token) {
            window.location.href = '/espace-client';
          } else {
            // Pas connecte — rester sur la page avec message de succes
            form.reset();
            dateInput.min = new Date().toISOString().split('T')[0];
            document.querySelectorAll('.emplacement-pill').forEach(function(p) { p.classList.remove('active'); });
            document.querySelector('.emplacement-pill').classList.add('active');
            selectedEmplacement = '';
            heureInput.classList.remove('invalid');
            dateInput.classList.remove('invalid');
            hintDate.textContent = 'Nous sommes fermes le lundi';
            hintHeure.textContent = 'Choisir une date d\'abord';
            hintDate.classList.remove('error-hint');
            hintHeure.classList.remove('error-hint');
            btn.disabled    = false;
            btn.textContent = 'Confirmer ma reservation';
          }
        }, 1800);
      } else {
        showMsg(false, result.error || (result.errors && result.errors.join(', ')) || 'Une erreur est survenue.');
        btn.disabled    = false;
        btn.textContent = 'Confirmer ma reservation';
      }
    } catch(err) {
      showMsg(false, 'Erreur de connexion au serveur.');
      btn.disabled    = false;
      btn.textContent = 'Confirmer ma reservation';
    }
  });
</script>

<%- include('partials/footer') %>