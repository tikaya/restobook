<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  /* ── Hero ── */
  .resa-hero {
    background: var(--bordeaux);
    padding: 4rem 2rem 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .resa-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .resa-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50px;
    background: var(--creme);
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .resa-hero-content { position: relative; z-index: 1; }
  .resa-hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--or); margin-bottom: 0.75rem;
  }
  .resa-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: #fff; font-weight: 700; margin-bottom: 0.5rem;
  }
  .resa-hero h1 em { font-style: italic; color: var(--or); }
  .resa-hero p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem; color: rgba(255,255,255,0.65); font-style: italic;
  }

  /* ── Body ── */
  .resa-page { background: var(--creme); padding: 3rem 2rem 5rem; }
  .resa-layout {
    max-width: 960px; margin: 0 auto;
    display: grid; grid-template-columns: 1.4fr 0.6fr;
    gap: 1.5rem; align-items: start;
  }

  /* ── Card ── */
  .resa-card {
    background: #fff; border: 1px solid var(--creme-dark);
    border-radius: 16px; padding: 2rem;
    box-shadow: 0 4px 24px rgba(61,43,31,0.06);
  }
  .resa-card-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--or); margin-bottom: 0.4rem;
  }
  .resa-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem; color: var(--bordeaux); margin-bottom: 0.3rem;
  }
  .resa-card-line { width: 36px; height: 2px; background: var(--or); margin-bottom: 1.5rem; border-radius: 2px; }

  /* ── Message ── */
  .resa-msg {
    display: none; padding: 0.875rem 1rem; border-radius: 8px;
    margin-bottom: 1.5rem; font-size: 0.85rem; font-weight: 500; line-height: 1.5;
  }
  .resa-msg.success { background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); }
  .resa-msg.error   { background: #fdecea; color: #c62828; border: 1px solid rgba(198,40,40,0.2); }

  /* ── Form ── */
  .resa-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem; font-weight: 500;
    color: var(--brun-light); text-transform: uppercase; letter-spacing: 0.08em;
  }
  .form-input {
    width: 100%; padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--creme-dark); border-radius: 8px;
    font-family: 'DM Sans', sans-serif; font-size: 0.875rem;
    color: var(--brun); background: var(--creme);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none; resize: vertical;
  }
  .form-input:focus {
    border-color: var(--bordeaux); background: #fff;
    box-shadow: 0 0 0 3px rgba(107,26,42,0.08);
  }

  /* ── Emplacement pills ── */
  .emplacement-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .emplacement-pills { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .emplacement-pill {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.55rem 1rem;
    border: 1.5px solid var(--creme-dark);
    border-radius: 50px;
    background: var(--creme);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem; font-weight: 500;
    color: var(--brun-light);
    cursor: pointer; transition: all 0.2s;
    user-select: none;
  }
  .emplacement-pill:hover { border-color: var(--bordeaux); color: var(--bordeaux); }
  .emplacement-pill.active {
    background: var(--bordeaux); color: #fff;
    border-color: var(--bordeaux);
  }
  .emplacement-pill input { display: none; }
  .emplacement-note {
    font-size: 0.72rem; color: var(--brun-light);
    font-style: italic; margin-top: 0.15rem;
  }

  /* ── Section title ── */
  .form-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 0.9rem; color: var(--bordeaux); font-weight: 600;
    padding-bottom: 0.5rem; border-bottom: 1px solid var(--creme-dark); margin-top: 0.5rem;
  }

  /* ── Bouton ── */
  .btn-submit {
    width: 100%; padding: 0.9rem;
    background: var(--bordeaux); color: #fff;
    border: none; border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem; font-weight: 600; letter-spacing: 0.04em;
    cursor: pointer; transition: all 0.2s; margin-top: 0.5rem;
  }
  .btn-submit:hover { background: #8B2A3A; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(107,26,42,0.3); }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  /* ── Sidebar ── */
  .resa-sidebar { display: flex; flex-direction: column; gap: 1rem; }
  .sidebar-card {
    background: #fff; border: 1px solid var(--creme-dark);
    border-radius: 16px; padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(61,43,31,0.04);
  }
  .sidebar-card-title { font-family: 'Playfair Display', serif; font-size: 1rem; color: var(--bordeaux); margin-bottom: 0.3rem; }
  .sidebar-card-line { width: 28px; height: 2px; background: var(--or); margin-bottom: 1rem; border-radius: 2px; }

  .info-item {
    display: flex; gap: 0.75rem; align-items: flex-start;
    margin-bottom: 0.9rem; font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem; color: var(--brun-light); line-height: 1.5;
  }
  .info-item:last-child { margin-bottom: 0; }
  .info-icon { font-size: 1rem; flex-shrink: 0; margin-top: 0.1rem; }
  .info-item strong { color: var(--brun); display: block; margin-bottom: 0.1rem; }

  /* ── Auth chip ── */
  .auth-chip {
    display: flex; align-items: center; gap: 0.5rem;
    background: #e8f5e9; color: #2e7d32;
    border: 1px solid rgba(46,125,50,0.2);
    border-radius: 8px; padding: 0.6rem 0.9rem;
    font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 500;
  }
  .auth-chip-warn { background: #fdf6e3; color: #7a5c00; border-color: rgba(201,168,76,0.3); }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .resa-layout { grid-template-columns: 1fr; }
    .form-row-3  { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .form-row-2, .form-row-3 { grid-template-columns: 1fr; }
    .emplacement-pills { flex-direction: column; }
  }
</style>

<!-- Hero -->
<section class="resa-hero">
  <div class="resa-hero-content">
    <p class="resa-hero-eyebrow">Le Gourmet Parisien</p>
    <h1>Réserver une <em>table</em></h1>
    <p>Quelques clics pour une expérience inoubliable</p>
  </div>
</section>

<!-- Body -->
<div class="resa-page">
  <div class="resa-layout">

    <!-- ── Formulaire ── -->
    <div class="resa-card">
      <p class="resa-card-eyebrow">Formulaire</p>
      <h2 class="resa-card-title">Votre réservation</h2>
      <div class="resa-card-line"></div>

      <div class="resa-msg" id="message"></div>

      <form id="reservation-form" class="resa-form">

        <p class="form-section-title">👤 Vos coordonnées</p>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">Nom *</label>
            <input type="text" name="nom" class="form-input" placeholder="Dupont" required>
          </div>
          <div class="form-group">
            <label class="form-label">Prénom *</label>
            <input type="text" name="prenom" class="form-input" placeholder="Jean" required>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label class="form-label">Email *</label>
            <input type="email" name="email" class="form-input" placeholder="jean@email.com" required>
          </div>
          <div class="form-group">
            <label class="form-label">Téléphone *</label>
            <input type="tel" name="telephone" class="form-input" placeholder="06 00 00 00 00" required>
          </div>
        </div>

        <p class="form-section-title">📅 Détails de la réservation</p>

        <div class="form-row-3">
          <div class="form-group">
            <label class="form-label">Date *</label>
            <input type="date" name="date_reservation" class="form-input" required>
          </div>
          <div class="form-group">
            <label class="form-label">Heure *</label>
            <input type="time" name="heure_reservation" class="form-input" required>
          </div>
          <div class="form-group">
            <label class="form-label">Personnes *</label>
            <input type="number" name="nb_personnes" class="form-input" min="1" max="20" value="2" required>
          </div>
        </div>

        <!-- ── Choix emplacement ── -->
        <div class="emplacement-group">
          <label class="form-label">Emplacement souhaité</label>
          <div class="emplacement-pills" id="emplacement-pills">
            <label class="emplacement-pill active" onclick="selectEmplacement(this, '')">
              <input type="radio" name="emplacement_table" value="" checked>
              🍽️ Pas de préférence
            </label>
            <label class="emplacement-pill" onclick="selectEmplacement(this, 'interieur')">
              <input type="radio" name="emplacement_table" value="interieur">
              🏠 Intérieur
            </label>
            <label class="emplacement-pill" onclick="selectEmplacement(this, 'terrasse')">
              <input type="radio" name="emplacement_table" value="terrasse">
              🌿 Terrasse
            </label>
            <label class="emplacement-pill" onclick="selectEmplacement(this, 'salon_prive')">
              <input type="radio" name="emplacement_table" value="salon_prive">
              ✨ Salon privé
            </label>
          </div>
          <p class="emplacement-note">Si l'emplacement souhaité n'est pas disponible, une alternative vous sera proposée.</p>
        </div>

        <div class="form-group">
          <label class="form-label">Demandes spéciales</label>
          <textarea name="demandes_speciales" class="form-input" rows="3" placeholder="Allergie, anniversaire, chaise haute..."></textarea>
        </div>

        <button type="submit" class="btn-submit" id="btn-submit">
          Confirmer ma réservation →
        </button>

      </form>
    </div>

    <!-- ── Sidebar ── -->
    <div class="resa-sidebar">

      <!-- Statut connexion -->
      <div class="sidebar-card">
        <div id="auth-status"></div>
      </div>

      <!-- Emplacements dispo -->
      <div class="sidebar-card">
        <h3 class="sidebar-card-title">🗺️ Nos espaces</h3>
        <div class="sidebar-card-line"></div>
        <div class="info-item">
          <span class="info-icon">🏠</span>
          <div><strong>Intérieur</strong>Ambiance chaleureuse et feutrée, idéale par tous temps</div>
        </div>
        <div class="info-item">
          <span class="info-icon">🌿</span>
          <div><strong>Terrasse</strong>En plein air, disponible selon la météo d'avril à octobre</div>
        </div>
        <div class="info-item">
          <span class="info-icon">✨</span>
          <div><strong>Salon privé</strong>Espace privatisable pour vos événements (min. 6 pers.)</div>
        </div>
      </div>

      <!-- Horaires -->
      <div class="sidebar-card">
        <h3 class="sidebar-card-title">🕐 Nos horaires</h3>
        <div class="sidebar-card-line"></div>
        <div class="info-item">
          <span class="info-icon">📅</span>
          <div><strong>Lundi</strong>Fermé</div>
        </div>
        <div class="info-item">
          <span class="info-icon">📅</span>
          <div><strong>Mardi – Vendredi</strong>12h – 14h30 · 19h – 22h30</div>
        </div>
        <div class="info-item">
          <span class="info-icon">📅</span>
          <div><strong>Samedi</strong>12h – 15h · 19h – 23h</div>
        </div>
        <div class="info-item">
          <span class="info-icon">📅</span>
          <div><strong>Dimanche</strong>12h – 15h</div>
        </div>
      </div>

      <!-- Infos pratiques -->
      <div class="sidebar-card">
        <h3 class="sidebar-card-title">📍 Infos pratiques</h3>
        <div class="sidebar-card-line"></div>
        <div class="info-item">
          <span class="info-icon">📍</span>
          <div><strong>Adresse</strong>12 rue des Archives, 75004 Paris</div>
        </div>
        <div class="info-item">
          <span class="info-icon">📞</span>
          <div><strong>Téléphone</strong>01 23 45 67 89</div>
        </div>
        <div class="info-item">
          <span class="info-icon">👥</span>
          <div><strong>Groupes</strong>Pour plus de 10 pers., appelez-nous directement</div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  // ── Helpers ──────────────────────────────────────────────
  function getToken() {
    return document.cookie.split('; ').find(c => c.startsWith('token='))?.split('=')[1];
  }
  function getUserFromCookie() {
    try {
      const raw = document.cookie.split('; ').find(c => c.startsWith('user='))?.split('=').slice(1).join('=');
      return raw ? JSON.parse(decodeURIComponent(raw)) : null;
    } catch { return null; }
  }

  const user  = getUserFromCookie();
  const token = getToken();

  // ── Statut connexion ──────────────────────────────────────
  const authEl = document.getElementById('auth-status');
  if (user && token) {
    const nom = user.prenom || user.email?.split('@')[0] || 'vous';
    authEl.innerHTML = `
      <div class="auth-chip">
        ✓ Connecté en tant que <strong style="margin-left:0.25rem">${nom}</strong>
      </div>`;
    // Pré-remplir les champs coordonnées si connecté
    if (user.prenom) document.querySelector('input[name="prenom"]').value = user.prenom;
    if (user.nom)    document.querySelector('input[name="nom"]').value    = user.nom;
    if (user.email)  document.querySelector('input[name="email"]').value  = user.email;
  } else {
    authEl.innerHTML = `
      <div class="auth-chip auth-chip-warn">
        ⚠️ <span>Vous n'êtes pas connecté — <a href="/login" style="color:inherit;font-weight:700;">Se connecter</a></span>
      </div>`;
  }

  // ── Date min = aujourd'hui ────────────────────────────────
  const dateInput = document.querySelector('input[name="date_reservation"]');
  dateInput.min = new Date().toISOString().split('T')[0];

  // ── Sélection emplacement ─────────────────────────────────
  let selectedEmplacement = '';
  function selectEmplacement(pill, value) {
    document.querySelectorAll('.emplacement-pill').forEach(p => p.classList.remove('active'));
    pill.classList.add('active');
    selectedEmplacement = value;
  }

  // ── Message ───────────────────────────────────────────────
  function showMsg(ok, text) {
    const msg = document.getElementById('message');
    msg.className = 'resa-msg ' + (ok ? 'success' : 'error');
    msg.style.display = 'block';
    msg.innerHTML = (ok ? '✓ ' : '✗ ') + text;
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Soumission ────────────────────────────────────────────
  document.getElementById('reservation-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn  = document.getElementById('btn-submit');

    btn.disabled    = true;
    btn.textContent = '⏳ Envoi en cours...';

    const data = {
      date_reservation:   form.date_reservation.value,
      heure_reservation:  form.heure_reservation.value,
      nb_personnes:       parseInt(form.nb_personnes.value),
      demandes_speciales: form.demandes_speciales.value.trim() || null,
      id_client:          user ? user.id : null,          // ✅ user.id du token JWT
      emplacement_table:  selectedEmplacement || null      // ✅ optionnel
      // id_table → assigné automatiquement par le backend
    };

    try {
      const res = await fetch('/reservations', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': token ? 'Bearer ' + token : ''
        },
        body: JSON.stringify(data)
      });
      const result = await res.json();

      if (res.ok) {
        // Message de succès avec emplacement attribué
        const emplacementLabels = {
          interieur:   '🏠 en intérieur',
          terrasse:    '🌿 en terrasse',
          salon_prive: '✨ en salon privé'
        };
        const emplacementMsg = result.emplacement_table
          ? ' — ' + (emplacementLabels[result.emplacement_table] || '')
          : '';
        showMsg(true, `Merci ! Votre table est réservée${emplacementMsg}. Nous avons hâte de vous accueillir 🍽️`);
        form.reset();
        dateInput.min = new Date().toISOString().split('T')[0];
        // Réinitialiser l'emplacement sélectionné
        document.querySelectorAll('.emplacement-pill').forEach(p => p.classList.remove('active'));
        document.querySelector('.emplacement-pill').classList.add('active');
        selectedEmplacement = '';
      } else {
        showMsg(false, result.error || (result.errors && result.errors.join('<br>')) || 'Une erreur est survenue.');
      }
    } catch {
      showMsg(false, 'Erreur de connexion au serveur.');
    } finally {
      btn.disabled    = false;
      btn.textContent = 'Confirmer ma réservation →';
    }
  });
</script>

<%- include('partials/footer') %>