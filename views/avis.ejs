<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  /* ── Hero ── */
  .avis-hero {
    background: var(--bordeaux);
    padding: 4rem 2rem 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .avis-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .avis-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50px;
    background: var(--creme);
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .avis-hero-content { position: relative; z-index: 1; }
  .avis-hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.75rem;
  }
  .avis-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: #fff;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .avis-hero h1 em { font-style: italic; color: var(--or); }
  .avis-hero p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    color: rgba(255,255,255,0.65);
    font-style: italic;
  }

  /* ── Page body ── */
  .avis-page {
    background: var(--creme);
    padding: 3rem 2rem 5rem;
  }
  .avis-inner { max-width: 1100px; margin: 0 auto; }

  /* ── Note globale ── */
  .rating-block {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .stars-display {
    font-size: 2rem;
    color: var(--or);
    letter-spacing: 0.1em;
    margin-bottom: 0.4rem;
  }
  .rating-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: var(--brun-light);
    font-style: italic;
  }

  /* Barres de répartition */
  .rating-bars {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 280px;
    margin: 1.25rem auto 0;
  }
  .rating-bar-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--brun-light);
    font-family: 'DM Sans', sans-serif;
  }
  .rating-bar-label { width: 20px; text-align: right; flex-shrink: 0; }
  .rating-bar-track {
    flex: 1;
    height: 6px;
    background: var(--creme-dark);
    border-radius: 3px;
    overflow: hidden;
  }
  .rating-bar-fill {
    height: 100%;
    background: var(--or);
    border-radius: 3px;
    transition: width 0.8s ease;
  }
  .rating-bar-count { width: 20px; flex-shrink: 0; }

  /* ── Filtres ── */
  .filters {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .filter-btn {
    background: #fff;
    border: 1.5px solid var(--creme-dark);
    padding: 0.45rem 1.1rem;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--brun-light);
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover { border-color: var(--bordeaux); color: var(--bordeaux); }
  .filter-btn.active {
    background: var(--bordeaux);
    color: #fff;
    border-color: var(--bordeaux);
    box-shadow: 0 4px 12px rgba(107,26,42,0.2);
  }

  /* Compteur */
  .results-count {
    text-align: center;
    font-size: 0.8rem;
    color: var(--brun-light);
    margin-bottom: 1.5rem;
    font-family: 'DM Sans', sans-serif;
  }
  .results-count strong { color: var(--bordeaux); }

  /* ── Grille avis ── */
  .avis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .avis-card {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .avis-card::before {
    content: '❝';
    position: absolute;
    top: 0.75rem; right: 1.25rem;
    font-size: 2.5rem;
    color: var(--or);
    opacity: 0.12;
    font-family: 'Playfair Display', serif;
    line-height: 1;
  }
  .avis-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 35px rgba(107,26,42,0.1);
    border-color: rgba(107,26,42,0.12);
  }
  .avis-card.hidden { display: none; }

  /* En-tête carte */
  .avis-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .avis-author { display: flex; align-items: center; gap: 0.75rem; }
  .avis-avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  .author-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--brun);
    font-family: 'DM Sans', sans-serif;
  }
  .author-stars {
    font-size: 0.8rem;
    color: var(--or);
    letter-spacing: 0.05em;
    margin-top: 0.1rem;
  }
  .avis-date {
    font-size: 0.72rem;
    color: var(--brun-light);
    opacity: 0.7;
    font-family: 'DM Sans', sans-serif;
    white-space: nowrap;
  }

  /* Note badge */
  .note-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: var(--or-light, #fdf6e3);
    color: #7a5c00;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.75rem;
    font-family: 'DM Sans', sans-serif;
  }

  /* Texte avis */
  .avis-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    font-style: italic;
    line-height: 1.7;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--brun-light);
    grid-column: 1 / -1;
  }
  .empty-state span { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
  .empty-state p { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.1rem; }

  /* ── Reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  @media (max-width: 640px) {
    .avis-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- Hero -->
<section class="avis-hero">
  <div class="avis-hero-content">
    <p class="avis-hero-eyebrow">Le Gourmet Parisien</p>
    <h1>Avis de nos <em>clients</em></h1>
    <p>Ce que nos clients pensent de nous</p>
  </div>
</section>

<!-- Page body -->
<div class="avis-page">
  <div class="avis-inner">

    <!-- Note globale + barres -->
    <% 
      const total = avis.length;
      const moyenne = total > 0 ? (avis.reduce((s,a) => s + a.note_avis, 0) / total).toFixed(1) : '—';
      const etoiles = total > 0 ? Math.round(parseFloat(moyenne)) : 0;
      const compteParNote = [5,4,3,2,1].map(n => ({ note: n, count: avis.filter(a => a.note_avis === n).length }));
    %>

    <div class="rating-block reveal">
      <div class="stars-display">
        <% for (let s = 0; s < 5; s++) { %><%= s < etoiles ? '★' : '☆' %><% } %>
      </div>
      <p class="rating-text"><%= moyenne %> / 5 — <%= total %> avis vérifié<%= total > 1 ? 's' : '' %></p>

      <div class="rating-bars">
        <% compteParNote.forEach(item => { %>
          <div class="rating-bar-row">
            <span class="rating-bar-label"><%= item.note %>★</span>
            <div class="rating-bar-track">
              <div class="rating-bar-fill" style="width:<%= total > 0 ? Math.round(item.count / total * 100) : 0 %>%"></div>
            </div>
            <span class="rating-bar-count"><%= item.count %></span>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Filtres -->
    <div class="filters reveal">
      <button class="filter-btn active" onclick="filterAvis('all', this)">Tous (<%= total %>)</button>
      <button class="filter-btn" onclick="filterAvis(5, this)">★★★★★</button>
      <button class="filter-btn" onclick="filterAvis(4, this)">★★★★☆</button>
      <button class="filter-btn" onclick="filterAvis(3, this)">★★★☆☆</button>
      <button class="filter-btn" onclick="filterAvis(2, this)">★★☆☆☆</button>
      <button class="filter-btn" onclick="filterAvis(1, this)">★☆☆☆☆</button>
    </div>

    <p class="results-count" id="results-count"><strong><%= total %></strong> avis affiché<%= total > 1 ? 's' : '' %></p>

    <!-- Grille -->
    <div class="avis-grid">
      <% if (avis.length === 0) { %>
        <div class="empty-state">
          <span>💬</span>
          <p>Aucun avis pour le moment.</p>
        </div>
      <% } %>

      <%
        const colors = ['#722F37','#2D6A4F','#5B3A8C','#C9A84C','#1a5276','#8B2A3A','#1B4F72'];
        avis.forEach((a, i) => {
          const initiale = String(a.id_client).charAt(0);
          const dateStr  = new Date(a.date_avis).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' });
      %>
        <div class="avis-card reveal" data-note="<%= a.note_avis %>" style="transition-delay:<%= (i % 3) * 0.1 %>s">
          <div class="avis-header">
            <div class="avis-author">
              <div class="avis-avatar" style="background:<%= colors[i % colors.length] %>"><%= initiale %></div>
              <div>
                <div class="author-name">Client #<%= a.id_client %></div>
                <div class="author-stars">
                  <% for (let s = 0; s < 5; s++) { %><%= s < a.note_avis ? '★' : '☆' %><% } %>
                </div>
              </div>
            </div>
            <span class="avis-date"><%= dateStr %></span>
          </div>

          <% if (a.commentaire_avis) { %>
            <p class="avis-text"><%= a.commentaire_avis %></p>
          <% } else { %>
            <p class="avis-text" style="opacity:0.4;">Aucun commentaire laissé.</p>
          <% } %>
        </div>
      <% }) %>
    </div>

  </div>
</div>

<script>
  // ── Filtres ──────────────────────────────────────────────
  function filterAvis(note, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    let visible = 0;
    document.querySelectorAll('.avis-card').forEach(card => {
      const show = note === 'all' || parseInt(card.dataset.note) === note;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    const el = document.getElementById('results-count');
    el.innerHTML = '<strong>' + visible + '</strong> avis affiché' + (visible > 1 ? 's' : '');
  }

  // ── Reveal ───────────────────────────────────────────────
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

<%- include('partials/footer') %>