<%- include('../partials/admin-layout', { active: 'logs' }) %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:wght@300;400;600&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --bordeaux: #6B1A2A; --bordeaux-light: #8B2A3A; --bordeaux-pale: #f5eaec;
    --or: #C9A84C; --or-light: #fdf6e3;
    --creme: #FAF6F0; --creme-dark: #EDE5D8;
    --brun: #3D2B1F; --brun-light: #7A5C4A; --blanc: #FFFFFF;
    --vert: #2e7d32; --vert-pale: #e8f5e9;
    --rouge: #c62828; --rouge-pale: #fdecea;
    --orange: #e65100; --orange-pale: #fff3e0;
    --bleu: #1565c0; --bleu-pale: #e3f2fd;
    --violet: #6a1b9a; --violet-pale: #f3e5f5;
    --radius: 12px; --radius-sm: 8px;
    --shadow-soft: 0 4px 24px rgba(107,26,42,0.08);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  .logs-page {
    font-family: 'DM Sans', sans-serif;
    background: var(--creme);
    min-height: 100vh;
    padding: 2rem;
    color: var(--brun);
  }

  /* ── Header ── */
  .page-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 2rem; padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--creme-dark);
  }
  .page-header h1 { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--bordeaux); line-height: 1; }
  .page-header p { font-family: 'Cormorant Garamond', serif; font-size: 1rem; color: var(--brun-light); margin-top: 0.3rem; font-style: italic; }
  .mongo-badge { display: inline-flex; align-items: center; gap: 0.4rem; background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); border-radius: 50px; padding: 0.4rem 1rem; font-size: 0.78rem; font-weight: 500; }

  /* ── Stats cards ── */
  .stats-cards {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem; margin-bottom: 2rem;
  }
  .stat-card {
    background: var(--blanc); border: 1px solid var(--creme-dark);
    border-radius: var(--radius); padding: 1.1rem 1.25rem;
    box-shadow: var(--shadow-soft); position: relative; overflow: hidden;
    transition: all 0.2s;
  }
  .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(107,26,42,0.12); }
  .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
  .stat-card.total::before    { background: var(--bordeaux); }
  .stat-card.today::before    { background: var(--bleu); }
  .stat-card.echec::before    { background: var(--rouge); }
  .stat-card.warning::before  { background: var(--orange); }
  .stat-card.creation::before { background: var(--vert); }
  .stat-card.modif::before    { background: var(--violet); }
  .stat-icon { font-size: 1.4rem; margin-bottom: 0.5rem; display: block; }
  .stat-val { font-family: 'Playfair Display', serif; font-size: 1.8rem; font-weight: 700; color: var(--bordeaux); line-height: 1; }
  .stat-lbl { font-size: 0.7rem; color: var(--brun-light); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.25rem; }

  /* ── Filtres ── */
  .toolbar { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; align-items: center; }
  .search-input {
    padding: 0.55rem 1rem; border: 1.5px solid var(--creme-dark); border-radius: 50px;
    font-family: 'DM Sans', sans-serif; font-size: 0.82rem; color: var(--brun);
    background: var(--blanc); outline: none; transition: border-color 0.2s; min-width: 240px;
  }
  .search-input:focus { border-color: var(--bordeaux); }
  .filters { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .filter-btn {
    padding: 0.4rem 1rem; border-radius: 50px; border: 1.5px solid var(--creme-dark);
    background: var(--blanc); color: var(--brun-light);
    font-family: 'DM Sans', sans-serif; font-size: 0.8rem; cursor: pointer; transition: all 0.2s;
  }
  .filter-btn:hover, .filter-btn.active { background: var(--bordeaux); color: #fff; border-color: var(--bordeaux); }

  /* ── Timeline ── */
  .logs-timeline { position: relative; padding-left: 2rem; }
  .logs-timeline::before {
    content: ''; position: absolute; left: 7px; top: 0; bottom: 0;
    width: 2px; background: linear-gradient(to bottom, var(--creme-dark), transparent);
  }

  .log-item {
    position: relative; background: var(--blanc);
    border: 1px solid var(--creme-dark); border-radius: var(--radius);
    padding: 1rem 1.25rem; margin-bottom: 0.75rem;
    transition: all 0.2s ease;
    display: grid; grid-template-columns: auto 1fr auto;
    gap: 1rem; align-items: start;
  }
  .log-item:hover { box-shadow: var(--shadow-soft); transform: translateX(3px); }
  .log-item.hidden { display: none; }

  .log-item::before {
    content: ''; position: absolute; left: -1.75rem; top: 1.1rem;
    width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--blanc);
  }
  .log-item.type-connexion::before    { background: var(--vert); }
  .log-item.type-echec::before        { background: var(--rouge); }
  .log-item.type-creation::before     { background: var(--bleu); }
  .log-item.type-modification::before { background: var(--orange); }
  .log-item.type-suppression::before  { background: var(--rouge); }
  .log-item.type-securite::before     { background: var(--violet); }
  .log-item.type-autre::before        { background: var(--brun-light); }

  .log-badge {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.68rem; font-weight: 600; padding: 0.25rem 0.65rem;
    border-radius: 4px; letter-spacing: 0.04em; white-space: nowrap; align-self: start;
  }
  .badge-connexion    { background: var(--vert-pale);   color: var(--vert); }
  .badge-echec        { background: var(--rouge-pale);  color: var(--rouge); }
  .badge-creation     { background: var(--bleu-pale);   color: var(--bleu); }
  .badge-modification { background: var(--orange-pale); color: var(--orange); }
  .badge-suppression  { background: var(--rouge-pale);  color: var(--rouge); }
  .badge-securite     { background: var(--violet-pale); color: var(--violet); }
  .badge-autre        { background: var(--creme-dark);  color: var(--brun-light); }

  .log-content { min-width: 0; }
  .log-action { font-weight: 600; font-size: 0.85rem; color: var(--brun); margin-bottom: 0.3rem; }

  .log-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.35rem; }
  .log-meta-item {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.72rem; color: var(--brun-light);
    background: var(--creme); border: 1px solid var(--creme-dark);
    padding: 0.15rem 0.55rem; border-radius: 50px;
  }
  .log-meta-item.err { background: var(--rouge-pale); color: var(--rouge); border-color: rgba(198,40,40,0.2); }
  .log-meta-item.warn { background: var(--orange-pale); color: var(--orange); border-color: rgba(230,81,0,0.2); }
  .log-meta-item.ok { background: var(--vert-pale); color: var(--vert); border-color: rgba(46,125,50,0.2); }

  .log-details {
    font-size: 0.72rem; color: var(--brun-light);
    font-family: 'Courier New', monospace;
    background: var(--creme); padding: 0.4rem 0.7rem;
    border-radius: 4px; margin-top: 0.4rem;
    word-break: break-all; display: block;
    border-left: 3px solid var(--creme-dark);
    max-height: 60px; overflow: hidden;
    transition: max-height 0.3s;
    cursor: pointer;
  }
  .log-details.expanded { max-height: 300px; }

  .log-time { text-align: right; white-space: nowrap; flex-shrink: 0; }
  .log-time-heure { font-size: 0.85rem; font-weight: 600; color: var(--brun); }
  .log-time-date  { font-size: 0.7rem; color: var(--brun-light); margin-top: 0.15rem; }
  .log-time-duree { font-size: 0.68rem; color: var(--or); margin-top: 0.2rem; font-weight: 600; }

  .date-separator {
    display: flex; align-items: center; gap: 0.75rem;
    margin: 1.5rem 0 1rem;
  }
  .date-separator span {
    font-family: 'Playfair Display', serif; font-size: 0.85rem;
    color: var(--bordeaux); font-weight: 700; white-space: nowrap;
  }
  .date-separator::after { content: ''; flex: 1; height: 1px; background: var(--creme-dark); }

  .empty-state { text-align: center; padding: 4rem 2rem; color: var(--brun-light); }
  .empty-state span { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
  .empty-state p { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.1rem; }

  .results-count { font-size: 0.8rem; color: var(--brun-light); margin-bottom: 1rem; }
  .results-count strong { color: var(--bordeaux); }

  @media (max-width: 768px) {
    .log-item { grid-template-columns: 1fr; }
    .stats-cards { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<%
  var nbTotal     = logs.length;
  var nbConnexion = logs.filter(function(l){ return l.type_action && (l.type_action.indexOf('CONNEXION') !== -1); }).length;
  var nbEchec     = logs.filter(function(l){ return l.statut === 'echec'; }).length;
  var nbCreation  = logs.filter(function(l){ return l.type_action && l.type_action.indexOf('CREATION') === 0; }).length;
  var nbModif     = logs.filter(function(l){ return l.type_action && l.type_action.indexOf('MODIFICATION') === 0; }).length;
  var nbSuppr     = logs.filter(function(l){ return l.type_action && (l.type_action.indexOf('ANNULATION') === 0 || l.type_action.indexOf('SUPPRESSION') === 0); }).length;
  var nbAujourdhui = stats ? stats.aujourdhui : 0;
%>

<div class="logs-page">

  <!-- Header -->
  <div class="page-header">
    <div>
      <h1>Journalisation</h1>
      <p>Historique detaille des actions sur la plateforme RestoBook</p>
    </div>
    <div class="mongo-badge">MongoDB</div>
  </div>

  <!-- Stats cards -->
  <div class="stats-cards">
    <div class="stat-card total">
      <span class="stat-icon">📋</span>
      <div class="stat-val"><%= nbTotal %></div>
      <div class="stat-lbl">Logs charges</div>
    </div>
    <div class="stat-card today">
      <span class="stat-icon">📅</span>
      <div class="stat-val"><%= nbAujourdhui %></div>
      <div class="stat-lbl">Aujourd'hui</div>
    </div>
    <div class="stat-card echec">
      <span class="stat-icon">❌</span>
      <div class="stat-val"><%= nbEchec %></div>
      <div class="stat-lbl">Echecs</div>
    </div>
    <div class="stat-card creation">
      <span class="stat-icon">✅</span>
      <div class="stat-val"><%= nbConnexion %></div>
      <div class="stat-lbl">Connexions</div>
    </div>
    <div class="stat-card creation">
      <span class="stat-icon">➕</span>
      <div class="stat-val"><%= nbCreation %></div>
      <div class="stat-lbl">Creations</div>
    </div>
    <div class="stat-card modif">
      <span class="stat-icon">✏️</span>
      <div class="stat-val"><%= nbModif %></div>
      <div class="stat-lbl">Modifications</div>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="toolbar">
    <input type="text" class="search-input" id="search-input"
           placeholder="Rechercher une action, un utilisateur, une IP..."
           oninput="applyFilters()">
    <div class="filters">
      <button class="filter-btn active" onclick="setFilter('all',this)">Tous</button>
      <button class="filter-btn" onclick="setFilter('connexion',this)">Connexions</button>
      <button class="filter-btn" onclick="setFilter('echec',this)">Echecs</button>
      <button class="filter-btn" onclick="setFilter('creation',this)">Creations</button>
      <button class="filter-btn" onclick="setFilter('modification',this)">Modifications</button>
      <button class="filter-btn" onclick="setFilter('suppression',this)">Suppressions</button>
      <button class="filter-btn" onclick="setFilter('securite',this)">Securite</button>
    </div>
  </div>

  <div class="results-count" id="results-count">
    <strong><%= nbTotal %></strong> resultat<%= nbTotal > 1 ? 's' : '' %>
  </div>

  <!-- Timeline -->
  <% if (logs.length === 0) { %>
    <div class="empty-state">
      <span>📋</span>
      <p>Aucun log enregistre pour le moment.</p>
    </div>
  <% } else { %>

    <div class="logs-timeline" id="logs-timeline">
    <%
      var lastDate = null;
      var typeConfig = {
        'CONNEXION_CLIENT':            { cat: 'connexion',    badge: 'badge-connexion',    icon: '✅', label: 'Connexion client' },
        'CONNEXION_EMPLOYE':           { cat: 'connexion',    badge: 'badge-connexion',    icon: '✅', label: 'Connexion employe' },
        'TENTATIVE_CONNEXION_ECHOUEE': { cat: 'echec',        badge: 'badge-echec',        icon: '❌', label: 'Connexion echouee' },
        'CREATION_RESERVATION':        { cat: 'creation',     badge: 'badge-creation',     icon: '➕', label: 'Reservation creee' },
        'MODIFICATION_RESERVATION':    { cat: 'modification', badge: 'badge-modification', icon: '✏️', label: 'Reservation modifiee' },
        'ANNULATION_RESERVATION':      { cat: 'suppression',  badge: 'badge-suppression',  icon: '🗑️', label: 'Reservation annulee' },
        'CREATION_PLAT':               { cat: 'creation',     badge: 'badge-creation',     icon: '➕', label: 'Plat cree' },
        'MODIFICATION_PLAT':           { cat: 'modification', badge: 'badge-modification', icon: '✏️', label: 'Plat modifie' },
        'SUPPRESSION_PLAT':            { cat: 'suppression',  badge: 'badge-suppression',  icon: '🗑️', label: 'Plat supprime' },
        'UPLOAD_IMAGE_PLAT':           { cat: 'modification', badge: 'badge-modification', icon: '🖼️', label: 'Image plat mise a jour' },
        'CREATION_CLIENT':             { cat: 'creation',     badge: 'badge-creation',     icon: '➕', label: 'Client cree' },
        'MODIFICATION_CLIENT':         { cat: 'modification', badge: 'badge-modification', icon: '✏️', label: 'Client modifie' },
        'SUPPRESSION_CLIENT':          { cat: 'suppression',  badge: 'badge-suppression',  icon: '🗑️', label: 'Client supprime' },
        'CREATION_AVIS':               { cat: 'creation',     badge: 'badge-creation',     icon: '⭐', label: 'Avis depose' },
        'APPROBATION_AVIS':            { cat: 'modification', badge: 'badge-modification', icon: '✅', label: 'Avis approuve' },
        'SUPPRESSION_AVIS':            { cat: 'suppression',  badge: 'badge-suppression',  icon: '🗑️', label: 'Avis supprime' },
        'ACCES_REFUSE':                { cat: 'securite',     badge: 'badge-securite',     icon: '🔒', label: 'Acces refuse' },
        'TOKEN_INVALIDE':              { cat: 'securite',     badge: 'badge-securite',     icon: '🔐', label: 'Token invalide' },
        'RESET_MDP':                   { cat: 'modification', badge: 'badge-modification', icon: '🔑', label: 'Reset mot de passe' },
        'CHANGEMENT_MDP':              { cat: 'modification', badge: 'badge-modification', icon: '🔑', label: 'Changement MDP' },
      };

      logs.forEach(function(log) {
        var date     = new Date(log.horodatage);
        var dateStr  = date.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        var heureStr = date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        var dateKey  = date.toISOString().split('T')[0];
        var config   = typeConfig[log.type_action] || { cat: 'autre', badge: 'badge-autre', icon: '📌', label: log.type_action };
        var detailsStr = (log.details && Object.keys(log.details).length > 0) ? JSON.stringify(log.details, null, 2) : null;
        var searchStr  = (log.type_action + ' ' + (log.id_utilisateur||'') + ' ' + (log.ip||'') + ' ' + (log.url||'')).toLowerCase();
    %>

      <% if (dateKey !== lastDate) { lastDate = dateKey; %>
        <div class="date-separator" data-date="<%= dateKey %>">
          <span>📅 <%= dateStr %></span>
        </div>
      <% } %>

      <div class="log-item type-<%= config.cat %>"
           data-cat="<%= config.cat %>"
           data-search="<%= searchStr %>">

        <!-- Badge type -->
        <span class="log-badge <%= config.badge %>">
          <%= config.icon %> <%= config.label %>
        </span>

        <!-- Contenu -->
        <div class="log-content">
          <div class="log-action"><%= log.type_action %></div>

          <!-- Meta chips -->
          <div class="log-meta">
            <% if (log.id_utilisateur) { %>
              <span class="log-meta-item">👤 User #<%= log.id_utilisateur %></span>
            <% } %>
            <% if (log.role_utilisateur) { %>
              <span class="log-meta-item">🏷️ <%= log.role_utilisateur %></span>
            <% } %>
            <% if (log.ip) { %>
              <span class="log-meta-item">🌐 <%= log.ip %></span>
            <% } %>
            <% if (log.methode_http && log.url) { %>
              <span class="log-meta-item">🔗 <%= log.methode_http %> <%= log.url %></span>
            <% } %>
            <% if (log.duree_ms) { %>
              <span class="log-meta-item">⚡ <%= log.duree_ms %>ms</span>
            <% } %>
            <% if (log.statut === 'echec') { %>
              <span class="log-meta-item err">❌ echec</span>
            <% } else if (log.statut === 'warning') { %>
              <span class="log-meta-item warn">⚠️ warning</span>
            <% } else if (log.statut === 'succes') { %>
              <span class="log-meta-item ok">✓ succes</span>
            <% } %>
            <% if (log.user_agent) { %>
              <span class="log-meta-item">💻 <%= log.user_agent.substring(0, 40) %>...</span>
            <% } %>
          </div>

          <!-- Details JSON cliquables -->
          <% if (detailsStr) { %>
            <code class="log-details" onclick="this.classList.toggle('expanded')">
              <%= detailsStr %>
            </code>
          <% } %>
        </div>

        <!-- Heure -->
        <div class="log-time">
          <div class="log-time-heure"><%= heureStr %></div>
          <div class="log-time-date"><%= date.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }) %></div>
          <% if (log.duree_ms) { %>
            <div class="log-time-duree"><%= log.duree_ms %>ms</div>
          <% } %>
        </div>

      </div>

    <% }); %>
    </div>

  <% } %>
</div>

<script>
  var currentFilter = 'all';

  function setFilter(cat, btn) {
    currentFilter = cat;
    document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    applyFilters();
  }

  function applyFilters() {
    var q = document.getElementById('search-input').value.toLowerCase();
    var visible = 0;

    document.querySelectorAll('.log-item').forEach(function(item) {
      var matchCat    = currentFilter === 'all' || item.dataset.cat === currentFilter;
      var matchSearch = !q || (item.dataset.search && item.dataset.search.includes(q));
      var show        = matchCat && matchSearch;
      item.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    // Cacher les separateurs de date sans logs visibles
    document.querySelectorAll('.date-separator').forEach(function(sep) {
      var next = sep.nextElementSibling;
      var hasVisible = false;
      while (next && !next.classList.contains('date-separator')) {
        if (next.classList.contains('log-item') && !next.classList.contains('hidden')) {
          hasVisible = true; break;
        }
        next = next.nextElementSibling;
      }
      sep.style.display = hasVisible ? '' : 'none';
    });

    var count = document.getElementById('results-count');
    count.innerHTML = '<strong>' + visible + '</strong> resultat' + (visible > 1 ? 's' : '');
  }
</script>

<%- include('../partials/admin-footer') %>