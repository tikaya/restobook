<%- include('../partials/admin-layout', { active: 'tables' }) %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:wght@300;400;600&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --bordeaux: #6B1A2A;
    --bordeaux-light: #8B2A3A;
    --bordeaux-pale: #f5eaec;
    --or: #C9A84C;
    --or-light: #fdf6e3;
    --creme: #FAF6F0;
    --creme-dark: #EDE5D8;
    --brun: #3D2B1F;
    --brun-light: #7A5C4A;
    --blanc: #FFFFFF;
    --vert: #2e7d32;
    --vert-pale: #e8f5e9;
    --rouge: #c62828;
    --rouge-pale: #fdecea;
    --radius: 12px;
    --radius-sm: 8px;
    --shadow-soft: 0 4px 24px rgba(107,26,42,0.08);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  .tables-page {
    font-family: 'DM Sans', sans-serif;
    background: var(--creme);
    min-height: 100vh;
    padding: 2rem;
    color: var(--brun);
  }

  /* ── Header ── */
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--creme-dark);
  }
  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--bordeaux);
    line-height: 1;
  }
  .page-header p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    margin-top: 0.3rem;
    font-style: italic;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bordeaux);
    color: #fff;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-sm);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 0.02em;
  }
  .btn-primary:hover {
    background: var(--bordeaux-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(107,26,42,0.3);
  }

  /* ── Stats ── */
  .stats-bar {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .stat-chip {
    background: var(--blanc);
    border: 1px solid var(--creme-dark);
    border-radius: 50px;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    color: var(--brun-light);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .stat-chip strong { color: var(--bordeaux); font-weight: 600; }

  /* ── Filtres ── */
  .filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 0.4rem 1rem;
    border-radius: 50px;
    border: 1.5px solid var(--creme-dark);
    background: var(--blanc);
    color: var(--brun-light);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover, .filter-btn.active {
    background: var(--bordeaux);
    color: #fff;
    border-color: var(--bordeaux);
  }

  /* ── Sections par emplacement ── */
  .emplacement-section { margin-bottom: 2.5rem; }
  .emplacement-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .emplacement-label h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--bordeaux);
    font-weight: 700;
    white-space: nowrap;
  }
  .emplacement-label .sep-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--creme-dark), transparent);
  }
  .emp-count {
    font-size: 0.72rem;
    background: var(--bordeaux-pale);
    color: var(--bordeaux);
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
    font-weight: 500;
  }

  /* ── Grille de cartes ── */
  .tables-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .table-card {
    background: var(--blanc);
    border: 1px solid var(--creme-dark);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: all 0.25s ease;
    position: relative;
    text-align: center;
    cursor: default;
  }
  .table-card:hover {
    box-shadow: var(--shadow-soft);
    transform: translateY(-3px);
    border-color: var(--bordeaux-pale);
  }

  /* Icône table */
  .table-icon {
    font-size: 2.2rem;
    margin-bottom: 0.6rem;
    display: block;
    line-height: 1;
  }
  .table-numero {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--bordeaux);
    margin-bottom: 0.4rem;
  }
  .table-capacite {
    font-size: 0.8rem;
    color: var(--brun-light);
    margin-bottom: 0.75rem;
  }
  .table-capacite strong { color: var(--brun); }

  /* Badge emplacement */
  .badge-emp {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.65rem;
    border-radius: 50px;
    letter-spacing: 0.03em;
    margin-bottom: 1rem;
  }
  .badge-interieur   { background: #e3f2fd; color: #1565c0; }
  .badge-terrasse    { background: #e8f5e9; color: #2e7d32; }
  .badge-salon_prive { background: var(--or-light); color: #7a5c00; }

  /* Actions */
  .table-actions {
    display: flex;
    gap: 0.4rem;
  }
  .btn-edit {
    flex: 1;
    display: flex; align-items: center; justify-content: center;
    gap: 0.3rem;
    background: var(--bordeaux-pale);
    color: var(--bordeaux);
    border: 1px solid rgba(107,26,42,0.15);
    padding: 0.45rem;
    border-radius: var(--radius-sm);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-edit:hover { background: var(--bordeaux); color: #fff; }
  .btn-delete {
    display: flex; align-items: center; justify-content: center;
    background: var(--rouge-pale);
    color: var(--rouge);
    border: 1px solid rgba(198,40,40,0.15);
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-delete:hover { background: var(--rouge); color: #fff; }

  /* ── Empty ── */
  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--brun-light);
  }
  .empty-state span { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
  .empty-state p { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.1rem; }

  /* ── Modal ── */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(61,43,31,0.45);
    backdrop-filter: blur(4px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  .modal-overlay.show { display: flex; }
  .modal {
    background: var(--blanc);
    border-radius: var(--radius);
    padding: 2rem;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 20px 60px rgba(61,43,31,0.25);
    animation: slideUp 0.25s ease;
  }
  @keyframes slideUp {
    from { opacity:0; transform: translateY(20px); }
    to   { opacity:1; transform: translateY(0); }
  }
  .modal-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--bordeaux);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--creme-dark);
  }
  .form-group { margin-bottom: 1rem; }
  .form-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--brun-light);
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .form-input {
    width: 100%;
    border: 1.5px solid var(--creme-dark);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.875rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--brun);
    background: var(--creme);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }
  .form-input:focus {
    border-color: var(--bordeaux);
    background: var(--blanc);
    box-shadow: 0 0 0 3px rgba(107,26,42,0.08);
  }
  select.form-input { cursor: pointer; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }

  .modal-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .btn-submit {
    flex: 1;
    background: var(--bordeaux);
    color: #fff;
    border: none;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-submit:hover { background: var(--bordeaux-light); }
  .btn-cancel {
    background: var(--creme);
    color: var(--brun-light);
    border: 1.5px solid var(--creme-dark);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-cancel:hover { border-color: var(--brun-light); color: var(--brun); }

  /* ── Toast ── */
  .toast {
    position: fixed;
    bottom: 2rem; right: 2rem;
    background: var(--brun);
    color: #fff;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    z-index: 9999;
    transform: translateY(80px);
    opacity: 0;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast.success { background: var(--vert); }
  .toast.error   { background: var(--rouge); }

  .table-card.hidden { display: none; }
</style>

<div class="tables-page">

  <!-- Header -->
  <div class="page-header">
    <div>
      <h1>🪑 Gestion des tables</h1>
      <p>Organisez la disposition de votre salle</p>
    </div>
    <button class="btn-primary" onclick="openModalAdd()">＋ Ajouter une table</button>
  </div>

  <!-- Stats -->
  <div class="stats-bar">
    <div class="stat-chip">🪑 <strong><%= tables.length %></strong> tables au total</div>
    <div class="stat-chip">👥 <strong><%= tables.reduce((s,t) => s + t.capacite_table, 0) %></strong> couverts au total</div>
    <div class="stat-chip">🏠 <strong><%= tables.filter(t => t.emplacement_table === 'interieur').length %></strong> intérieur</div>
    <div class="stat-chip">🌿 <strong><%= tables.filter(t => t.emplacement_table === 'terrasse').length %></strong> terrasse</div>
    <div class="stat-chip">✨ <strong><%= tables.filter(t => t.emplacement_table === 'salon_prive').length %></strong> salon privé</div>
  </div>

  <!-- Filtres -->
  <div class="filters">
    <button class="filter-btn active" onclick="filterTables('all', this)">Toutes</button>
    <button class="filter-btn" onclick="filterTables('interieur', this)">🏠 Intérieur</button>
    <button class="filter-btn" onclick="filterTables('terrasse', this)">🌿 Terrasse</button>
    <button class="filter-btn" onclick="filterTables('salon_prive', this)">✨ Salon privé</button>
  </div>

  <!-- Sections par emplacement -->
  <% if (tables.length === 0) { %>
    <div class="empty-state">
      <span>🪑</span>
      <p>Aucune table enregistrée pour le moment.</p>
    </div>
  <% } %>

  <%
    const emplacements = [
      { key: 'interieur',   label: '🏠 Intérieur',   icon: '🍽️' },
      { key: 'terrasse',    label: '🌿 Terrasse',     icon: '🌞' },
      { key: 'salon_prive', label: '✨ Salon privé',  icon: '🕯️' }
    ];
  %>

  <% emplacements.forEach(emp => { %>
    <% const tablesEmp = tables.filter(t => t.emplacement_table === emp.key); %>
    <% if (tablesEmp.length > 0) { %>
      <div class="emplacement-section">
        <div class="emplacement-label">
          <h2><%= emp.label %></h2>
          <span class="emp-count"><%= tablesEmp.length %> table<%= tablesEmp.length > 1 ? 's' : '' %></span>
          <div class="sep-line"></div>
        </div>

        <div class="tables-grid">
          <% tablesEmp.forEach(t => { %>
            <div class="table-card" id="card-<%= t.id_table %>" data-emplacement="<%= t.emplacement_table %>">
              <span class="table-icon"><%= emp.icon %></span>
              <div class="table-numero">Table <%= t.numero_table %></div>
              <div class="table-capacite"><strong><%= t.capacite_table %></strong> place<%= t.capacite_table > 1 ? 's' : '' %></div>
              <span class="badge-emp badge-<%= t.emplacement_table %>">
                <% if (t.emplacement_table === 'interieur') { %>Intérieur
                <% } else if (t.emplacement_table === 'terrasse') { %>Terrasse
                <% } else { %>Salon privé<% } %>
              </span>
              <div class="table-actions">
                <button class="btn-edit" onclick="openModalEdit(<%= t.id_table %>, <%= t.numero_table %>, <%= t.capacite_table %>, '<%= t.emplacement_table %>')">✏️ Modifier</button>
                <button class="btn-delete" onclick="deleteTable(<%= t.id_table %>)" title="Supprimer">🗑</button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  <% }) %>

</div>

<!-- ===== MODAL AJOUTER ===== -->
<div class="modal-overlay" id="modal-add">
  <div class="modal">
    <h3 class="modal-title">➕ Ajouter une table</h3>
    <form id="form-add" onsubmit="submitAdd(event)">

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Numéro *</label>
          <input type="number" name="numero_table" class="form-input" min="1" required placeholder="Ex : 12">
        </div>
        <div class="form-group">
          <label class="form-label">Capacité *</label>
          <input type="number" name="capacite_table" class="form-input" min="1" required placeholder="Ex : 4">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Emplacement *</label>
        <select name="emplacement_table" class="form-input">
          <option value="interieur">🏠 Intérieur</option>
          <option value="terrasse">🌿 Terrasse</option>
          <option value="salon_prive">✨ Salon privé</option>
        </select>
      </div>

      <div class="modal-actions">
        <button type="submit" class="btn-submit">✓ Ajouter la table</button>
        <button type="button" class="btn-cancel" onclick="closeModal('modal-add')">Annuler</button>
      </div>
    </form>
  </div>
</div>

<!-- ===== MODAL MODIFIER ===== -->
<div class="modal-overlay" id="modal-edit">
  <div class="modal">
    <h3 class="modal-title">✏️ Modifier la table</h3>
    <form id="form-edit" onsubmit="submitEdit(event)">
      <input type="hidden" id="edit-id">

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Numéro *</label>
          <input type="number" name="numero_table" id="edit-numero" class="form-input" min="1" required>
        </div>
        <div class="form-group">
          <label class="form-label">Capacité *</label>
          <input type="number" name="capacite_table" id="edit-capacite" class="form-input" min="1" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Emplacement *</label>
        <select name="emplacement_table" id="edit-emplacement" class="form-input">
          <option value="interieur">🏠 Intérieur</option>
          <option value="terrasse">🌿 Terrasse</option>
          <option value="salon_prive">✨ Salon privé</option>
        </select>
      </div>

      <div class="modal-actions">
        <button type="submit" class="btn-submit">✓ Enregistrer</button>
        <button type="button" class="btn-cancel" onclick="closeModal('modal-edit')">Annuler</button>
      </div>
    </form>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
  function getToken() {
    return document.cookie.split('; ').find(c => c.startsWith('token='))?.split('=')[1];
  }
  function authHeaders() {
    return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() };
  }
  function closeModal(id) {
    document.getElementById(id).classList.remove('show');
  }
  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = (type === 'success' ? '✓ ' : '✗ ') + msg;
    t.className = 'toast show ' + type;
    setTimeout(() => { t.className = 'toast'; }, 3000);
  }

  // Fermeture en cliquant dehors
  document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('click', e => { if (e.target === o) o.classList.remove('show'); });
  });

  // ── Filtres ──────────────────────────────────────────────
  function filterTables(emp, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.table-card').forEach(card => {
      const show = emp === 'all' || card.dataset.emplacement === emp;
      card.classList.toggle('hidden', !show);
    });
  }

  // ── Ajouter ──────────────────────────────────────────────
  function openModalAdd() {
    document.getElementById('form-add').reset();
    document.getElementById('modal-add').classList.add('show');
  }

  async function submitAdd(e) {
    e.preventDefault();
    const f = e.target;
    const body = {
      numero_table:    parseInt(f.numero_table.value),
      capacite_table:  parseInt(f.capacite_table.value),
      emplacement_table: f.emplacement_table.value
    };
    try {
      const res = await fetch('/tables', { method: 'POST', headers: authHeaders(), body: JSON.stringify(body) });
      if (!res.ok) { const err = await res.json(); throw new Error(err.error || 'Erreur'); }
      showToast('Table ajoutée avec succès !');
      closeModal('modal-add');
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  // ── Modifier ─────────────────────────────────────────────
  function openModalEdit(id, numero, capacite, emplacement) {
    document.getElementById('edit-id').value          = id;
    document.getElementById('edit-numero').value      = numero;
    document.getElementById('edit-capacite').value    = capacite;
    document.getElementById('edit-emplacement').value = emplacement;
    document.getElementById('modal-edit').classList.add('show');
  }

  async function submitEdit(e) {
    e.preventDefault();
    const f  = e.target;
    const id = document.getElementById('edit-id').value;
    const body = {
      numero_table:      parseInt(f.numero_table.value),
      capacite_table:    parseInt(f.capacite_table.value),
      emplacement_table: f.emplacement_table.value
    };
    try {
      const res = await fetch('/tables/' + id, { method: 'PUT', headers: authHeaders(), body: JSON.stringify(body) });
      if (!res.ok) { const err = await res.json(); throw new Error(err.error || 'Erreur'); }
      showToast('Table mise à jour !');
      closeModal('modal-edit');
      setTimeout(() => location.reload(), 800);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }

  // ── Supprimer ────────────────────────────────────────────
  async function deleteTable(id) {
    if (!confirm('Supprimer cette table définitivement ?')) return;
    try {
      const res = await fetch('/tables/' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + getToken() } });
      if (!res.ok) { const err = await res.json(); throw new Error(err.error || 'Erreur'); }
      const card = document.getElementById('card-' + id);
      if (card) { card.style.opacity = '0'; card.style.transform = 'scale(0.9)'; card.style.transition = '0.3s'; }
      showToast('Table supprimée.');
      setTimeout(() => location.reload(), 900);
    } catch (err) {
      showToast(err.message, 'error');
    }
  }
</script>

<%- include('../partials/admin-footer') %>