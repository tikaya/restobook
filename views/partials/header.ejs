<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Le Gourmet Parisien' %> — RestoBook</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bordeaux: #722F37;
            --bordeaux-dark: #401F25;
            --bordeaux-light: #8E3B45;
            --bordeaux-hover: #5A252C;
            --or: #C9A84C;
            --or-light: #D4B96A;
            --or-dark: #B08C30;
            --creme: #FAF7F2;
            --creme-dark: #F0EBE3;
            --brun: #2C2220;
            --brun-light: #555555;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: var(--creme);
            font-family: 'Lato', sans-serif;
            color: var(--brun);
            overflow-x: hidden;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--creme-dark); }
        ::-webkit-scrollbar-thumb { background: var(--or); border-radius: 3px; }

        nav {
            background: var(--bordeaux-dark);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 20px rgba(0,0,0,0.3);
        }

        .nav-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--or);
            text-decoration: none;
            letter-spacing: 0.02em;
        }

        .nav-links { display: flex; align-items: center; gap: 2.5rem; }

        .nav-links a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 0.85rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            transition: color 0.2s;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px; left: 0;
            width: 0; height: 1px;
            background: var(--or);
            transition: width 0.3s;
        }

        .nav-links a:hover { color: var(--or); }
        .nav-links a:hover::after { width: 100%; }

        .btn-nav {
            background: var(--or);
            color: var(--bordeaux-dark) !important;
            padding: 0.55rem 1.4rem;
            border-radius: 3px;
            font-weight: 700;
            font-size: 0.8rem !important;
            letter-spacing: 0.1em !important;
            text-transform: uppercase !important;
            transition: background 0.2s, transform 0.15s !important;
            text-decoration: none;
            display: inline-block;
        }

        .btn-nav::after { display: none !important; }
        .btn-nav:hover { background: var(--or-light) !important; transform: translateY(-1px); }

        .btn-nav-logout {
            color: rgba(255,255,255,0.5) !important;
            font-size: 0.78rem !important;
            letter-spacing: 0.06em !important;
            text-transform: uppercase !important;
            text-decoration: none;
            transition: color 0.2s !important;
        }
        .btn-nav-logout:hover { color: #fff !important; }
        .btn-nav-logout::after { display: none !important; }

        .menu-btn {
            display: none;
            background: none;
            border: none;
            color: #fff;
            font-size: 1.5rem;
            cursor: pointer;
            padding: 0.5rem;
        }

        #mobile-menu {
            display: none;
            background: var(--bordeaux-dark);
            padding: 1rem 2rem 1.5rem;
            border-top: 1px solid rgba(201,168,76,0.2);
        }

        #mobile-menu a {
            display: block;
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            padding: 0.6rem 0;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .mobile-cta {
            display: block;
            background: var(--or);
            color: var(--bordeaux-dark) !important;
            text-align: center;
            padding: 0.8rem !important;
            font-weight: 700;
            border-radius: 2px;
            border: none !important;
            margin-top: 0.5rem;
        }

        .btn-primary {
            display: inline-block;
            background: var(--or);
            color: var(--bordeaux-dark);
            padding: 1.1rem 3rem;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 2px;
            text-align: center;
            transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 20px rgba(201,168,76,0.3);
        }
        .btn-primary:hover { background: var(--or-light); transform: translateY(-2px); box-shadow: 0 8px 30px rgba(201,168,76,0.4); }

        .btn-outline {
            display: inline-block;
            border: 1.5px solid var(--or);
            color: var(--or);
            padding: 1.05rem 3rem;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 2px;
            text-align: center;
            transition: background 0.2s, color 0.2s, transform 0.2s;
        }
        .btn-outline:hover { background: var(--or); color: var(--bordeaux-dark); transform: translateY(-2px); }

        .sep { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 2.5rem 0; background: var(--creme); }
        .sep-line { width: 60px; height: 1px; background: #d0c8be; }
        .sep-diamond { width: 6px; height: 6px; background: var(--or); transform: rotate(45deg); }

        .section-header { text-align: center; margin-bottom: 3rem; }
        .section-title { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 700; color: var(--bordeaux); margin-bottom: 0.75rem; }
        .section-title-line { width: 50px; height: 2px; background: var(--or); margin: 0 auto; }

        .card { background: #fff; border-radius: 4px; padding: 2.5rem; box-shadow: 0 2px 24px rgba(44,34,32,0.07); border: 1px solid rgba(201,168,76,0.12); position: relative; overflow: hidden; }
        .card::before { content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 60px; background: var(--or); }
        .card-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--bordeaux); margin-bottom: 0.4rem; }
        .card-underline { width: 40px; height: 2px; background: var(--or); margin-bottom: 1.5rem; }
        .card-text { color: var(--brun-light); line-height: 1.8; font-size: 0.95rem; margin-bottom: 2rem; }
        .info-badges { display: flex; flex-wrap: wrap; gap: 0.75rem; }
        .badge { background: var(--creme); border: 1px solid var(--creme-dark); padding: 0.5rem 1rem; border-radius: 2px; font-size: 0.82rem; color: var(--brun-light); }

        .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        @media (max-width: 768px) {
            .nav-links { display: none; }
            .menu-btn { display: block; }
        }
    </style>
</head>
<body>

    <nav>
        <div class="nav-inner">
            <a href="/" class="nav-logo">Le Gourmet Parisien</a>
            <div class="nav-links">
                <a href="/">Accueil</a>
                <a href="/carte">Notre Carte</a>
                <a href="/reservation">Réserver</a>
                <a href="/avis">Avis</a>
                <a href="/contact">Contact</a>
                <!-- Placeholder replaced by JS -->
                <span id="nav-auth-btn"></span>
            </div>
            <button class="menu-btn" id="menu-btn" aria-label="Menu">&#9776;</button>
        </div>
        <div id="mobile-menu">
            <a href="/">Accueil</a>
            <a href="/carte">Notre Carte</a>
            <a href="/reservation">Réserver</a>
            <a href="/avis">Avis</a>
            <a href="/contact">Contact</a>
            <span id="mobile-auth-btn"></span>
        </div>
    </nav>

    <script>
      // Detection session depuis cookie
      (function() {
        function getUser() {
          try {
            const raw = document.cookie.split('; ')
              .find(c => c.startsWith('user='))
              ?.split('=').slice(1).join('=');
            return raw ? JSON.parse(decodeURIComponent(raw)) : null;
          } catch { return null; }
        }

        const user  = getUser();
        const token = document.cookie.split('; ').find(c => c.startsWith('token='))?.split('=')[1];
        const navBtn    = document.getElementById('nav-auth-btn');
        const mobileBtn = document.getElementById('mobile-auth-btn');

        if (user && token) {
          // Connecte - lien vers Mon espace + deconnexion
          const espaceUrl = user.role === 'client' ? '/espace-client'
                          : user.role === 'gerant' ? '/espace-admin'
                          : '/espace-serveur';
          const prenom = user.prenom || user.email?.split('@')[0] || 'Mon espace';

          navBtn.innerHTML = `
            <span style="display:flex;align-items:center;gap:1rem;">
              <a href="${espaceUrl}" class="btn-nav">&#128100; ${prenom}</a>
              <a href="/logout" class="btn-nav-logout">Deconnexion</a>
            </span>`;

          mobileBtn.innerHTML = `
            <a href="${espaceUrl}" class="mobile-cta">&#128100; ${prenom}</a>
            <a href="/logout" style="display:block;color:rgba(255,255,255,0.5);padding:0.6rem 0;font-size:0.85rem;text-decoration:none;border-top:1px solid rgba(255,255,255,0.06);">
              Deconnexion
            </a>`;
        } else {
          // Non connecte - Se connecter
          navBtn.innerHTML    = `<a href="/login" class="btn-nav">Se connecter</a>`;
          mobileBtn.innerHTML = `<a href="/login" class="mobile-cta">Se connecter</a>`;
        }

        // Menu mobile toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', () => {
            mobileMenu.style.display = mobileMenu.style.display === 'block' ? 'none' : 'block';
          });
        }

        // Reveal animation
        const reveals = document.querySelectorAll('.reveal');
        if (reveals.length) {
          const observer = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
          }, { threshold: 0.1 });
          reveals.forEach(el => observer.observe(el));
        }
      })();
    </script>