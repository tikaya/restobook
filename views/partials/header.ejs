<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Le Gourmet Parisien' %> — RestoBook</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lato:wght@300;400;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bordeaux: #722F37;
            --bordeaux-dark: #401F25;
            --bordeaux-light: #8E3B45;
            --bordeaux-hover: #5A252C;
            --or: #C9A84C;
            --or-light: #D4B96A;
            --or-dark: #B08C30;
            --creme: #FAF7F2;
            --creme-dark: #F0EBE3;
            --creme-darker: #E8E0D5;
            --brun: #2C2220;
            --brun-light: #555555;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: var(--creme);
            font-family: 'Lato', sans-serif;
            color: var(--brun);
            overflow-x: hidden;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--creme-dark); }
        ::-webkit-scrollbar-thumb { background: var(--or); border-radius: 3px; }

        /* ════════════════════════════════════════════
           NAV — fond clair façon mockup
        ════════════════════════════════════════════ */
        nav {
            background: #fff;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--creme-dark);
            box-shadow: 0 2px 12px rgba(44,34,32,0.04);
        }

        .nav-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* ── Logo bicolore sur 2 lignes ── */
        .nav-logo {
            display: flex;
            flex-direction: column;
            text-decoration: none;
            line-height: 1;
            transition: transform 0.2s;
        }
        .nav-logo:hover { transform: translateY(-1px); }

        .nav-logo-main {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--bordeaux);
            letter-spacing: 0.01em;
        }

        .nav-logo-sub {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--or-dark);
            margin-top: 3px;
            letter-spacing: 0.02em;
        }

        /* ── Liens du menu ── */
        .nav-links { display: flex; align-items: center; gap: 2.25rem; }

        .nav-links a {
            color: var(--brun-light);
            text-decoration: none;
            font-family: 'DM Sans', 'Lato', sans-serif;
            font-size: 0.78rem;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            transition: color 0.2s;
            position: relative;
            padding: 0.4rem 0;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--or);
            transform: scaleX(0);
            transform-origin: center;
            transition: transform 0.3s ease;
        }

        .nav-links a:hover { color: var(--bordeaux); }
        .nav-links a:hover::after { transform: scaleX(1); }

        .nav-links a.active {
            color: var(--bordeaux);
            font-weight: 700;
        }
        .nav-links a.active::after { transform: scaleX(1); }

        /* ════════════════════════════════════════════
           BOUTON "SE CONNECTER" — version premium
           Pill + gradient + halo or + shimmer au hover
        ════════════════════════════════════════════ */
        .btn-nav {
            background: linear-gradient(135deg, var(--bordeaux) 0%, var(--bordeaux-light) 100%);
            color: #fff !important;
            padding: 0.75rem 1.7rem;
            border-radius: 50px;
            border: 1.5px solid transparent;
            font-family: 'DM Sans', 'Lato', sans-serif;
            font-weight: 700;
            font-size: 0.78rem !important;
            letter-spacing: 0.14em !important;
            text-transform: uppercase !important;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1) !important;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            position: relative;
            overflow: hidden;
            box-shadow:
                0 2px 8px rgba(114, 47, 55, 0.2),
                inset 0 1px 0 rgba(255, 255, 255, 0.12);
        }

        .btn-nav::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(201, 168, 76, 0.35),
                transparent
            );
            transition: left 0.7s ease;
            pointer-events: none;
        }

        .btn-nav::after { display: none !important; }

        .btn-nav:hover {
            border-color: var(--or) !important;
            transform: translateY(-2px);
            box-shadow:
                0 8px 22px rgba(114, 47, 55, 0.32),
                0 0 0 4px rgba(201, 168, 76, 0.18),
                inset 0 1px 0 rgba(255, 255, 255, 0.18) !important;
            color: #fff !important;
        }

        .btn-nav:hover::before { left: 100%; }

        .btn-nav-logout {
            color: var(--brun-light) !important;
            font-family: 'DM Sans', 'Lato', sans-serif;
            font-size: 0.72rem !important;
            font-weight: 500;
            letter-spacing: 0.08em !important;
            text-transform: uppercase !important;
            text-decoration: none;
            transition: color 0.2s !important;
        }
        .btn-nav-logout:hover { color: var(--bordeaux) !important; }
        .btn-nav-logout::after { display: none !important; }

        /* ── Burger mobile ── */
        .menu-btn {
            display: none;
            background: var(--bordeaux);
            border: none;
            color: var(--or);
            font-size: 1.4rem;
            cursor: pointer;
            padding: 0.5rem 0.75rem;
            border-radius: 6px;
            transition: background 0.2s;
        }
        .menu-btn:hover { background: var(--bordeaux-light); }

        /* ── Menu mobile ── */
        #mobile-menu {
            display: none;
            background: #fff;
            padding: 1rem 2rem 1.5rem;
            border-top: 1px solid var(--creme-dark);
            box-shadow: 0 4px 12px rgba(44,34,32,0.06);
        }

        #mobile-menu a {
            display: block;
            color: var(--brun-light);
            text-decoration: none;
            padding: 0.85rem 0;
            font-family: 'DM Sans', 'Lato', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border-bottom: 1px solid var(--creme-dark);
            transition: color 0.2s, padding-left 0.2s;
        }

        #mobile-menu a:hover {
            color: var(--bordeaux);
            padding-left: 0.5rem;
        }

        #mobile-menu a.active {
            color: var(--bordeaux);
            font-weight: 700;
            border-left: 3px solid var(--or);
            padding-left: 0.75rem;
        }

        /* CTA mobile — version premium aussi */
        .mobile-cta {
            display: block !important;
            background: linear-gradient(135deg, var(--bordeaux) 0%, var(--bordeaux-light) 100%) !important;
            color: #fff !important;
            text-align: center;
            padding: 0.95rem !important;
            font-family: 'DM Sans', 'Lato', sans-serif;
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            border-radius: 50px !important;
            border: 1.5px solid transparent !important;
            margin-top: 0.85rem !important;
            box-shadow:
                0 2px 10px rgba(114, 47, 55, 0.22),
                inset 0 1px 0 rgba(255, 255, 255, 0.12);
            transition: all 0.3s ease;
        }
        .mobile-cta:hover {
            border-color: var(--or) !important;
            box-shadow:
                0 6px 18px rgba(114, 47, 55, 0.3),
                0 0 0 3px rgba(201, 168, 76, 0.18) !important;
        }

        /* ════════════════════════════════════════════
           Reste des styles globaux du site
        ════════════════════════════════════════════ */
        .btn-primary {
            display: inline-block;
            background: var(--or);
            color: var(--bordeaux-dark);
            padding: 1.1rem 3rem;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 2px;
            text-align: center;
            transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 20px rgba(201,168,76,0.3);
        }
        .btn-primary:hover { background: var(--or-light); transform: translateY(-2px); box-shadow: 0 8px 30px rgba(201,168,76,0.4); }

        .btn-outline {
            display: inline-block;
            border: 1.5px solid var(--or);
            color: var(--or);
            padding: 1.05rem 3rem;
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 2px;
            text-align: center;
            transition: background 0.2s, color 0.2s, transform 0.2s;
        }
        .btn-outline:hover { background: var(--or); color: var(--bordeaux-dark); transform: translateY(-2px); }

        .sep { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 2.5rem 0; background: var(--creme); }
        .sep-line { width: 60px; height: 1px; background: #d0c8be; }
        .sep-diamond { width: 6px; height: 6px; background: var(--or); transform: rotate(45deg); }

        .section-header { text-align: center; margin-bottom: 3rem; }
        .section-title { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 700; color: var(--bordeaux); margin-bottom: 0.75rem; }
        .section-title-line { width: 50px; height: 2px; background: var(--or); margin: 0 auto; }

        .card { background: #fff; border-radius: 4px; padding: 2.5rem; box-shadow: 0 2px 24px rgba(44,34,32,0.07); border: 1px solid rgba(201,168,76,0.12); position: relative; overflow: hidden; }
        .card::before { content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 60px; background: var(--or); }
        .card-title { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--bordeaux); margin-bottom: 0.4rem; }
        .card-underline { width: 40px; height: 2px; background: var(--or); margin-bottom: 1.5rem; }
        .card-text { color: var(--brun-light); line-height: 1.8; font-size: 0.95rem; margin-bottom: 2rem; }
        .info-badges { display: flex; flex-wrap: wrap; gap: 0.75rem; }
        .badge { background: var(--creme); border: 1px solid var(--creme-dark); padding: 0.5rem 1rem; border-radius: 2px; font-size: 0.82rem; color: var(--brun-light); }

        .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .nav-links { display: none; }
            .menu-btn { display: block; }
            .nav-inner { height: 70px; padding: 0 1.25rem; }
            .nav-logo-main { font-size: 1.2rem; }
            .nav-logo-sub { font-size: 0.95rem; }
        }
    </style>
</head>
<body>

    <nav>
        <div class="nav-inner">
            <!-- Logo bicolore Le Gourmet / Parisien -->
            <a href="/" class="nav-logo" aria-label="Le Gourmet Parisien - Accueil">
                <span class="nav-logo-main">Le Gourmet</span>
                <span class="nav-logo-sub">Parisien</span>
            </a>

            <div class="nav-links">
                <a href="/" data-route="/">Accueil</a>
                <a href="/carte" data-route="/carte">Notre Carte</a>
                <a href="/reservation" data-route="/reservation">Réserver</a>
                <a href="/avis" data-route="/avis">Avis</a>
                <a href="/contact" data-route="/contact">Contact</a>
                <span id="nav-auth-btn"></span>
            </div>

            <button class="menu-btn" id="menu-btn" aria-label="Menu">&#9776;</button>
        </div>

        <div id="mobile-menu">
            <a href="/" data-route="/">Accueil</a>
            <a href="/carte" data-route="/carte">Notre Carte</a>
            <a href="/reservation" data-route="/reservation">Réserver</a>
            <a href="/avis" data-route="/avis">Avis</a>
            <a href="/contact" data-route="/contact">Contact</a>
            <span id="mobile-auth-btn"></span>
        </div>
    </nav>

    <script>
      (function() {
        // ── 1. Marquer le lien actif selon l'URL courante ──
        const currentPath = window.location.pathname;
        document.querySelectorAll('.nav-links a[data-route], #mobile-menu a[data-route]').forEach(link => {
          const route = link.getAttribute('data-route');
          const isActive = (route === '/' && currentPath === '/')
                        || (route !== '/' && currentPath.startsWith(route));
          if (isActive) link.classList.add('active');
        });

        // ── 2. Authentification (cookie) ──
        function getUser() {
          try {
            const raw = document.cookie.split('; ')
              .find(c => c.startsWith('user='))
              ?.split('=').slice(1).join('=');
            return raw ? JSON.parse(decodeURIComponent(raw)) : null;
          } catch { return null; }
        }

        const user  = getUser();
        const token = document.cookie.split('; ').find(c => c.startsWith('token='))?.split('=')[1];
        const navBtn    = document.getElementById('nav-auth-btn');
        const mobileBtn = document.getElementById('mobile-auth-btn');

        if (user && token) {
          const espaceUrl = user.role === 'client' ? '/espace-client'
                          : user.role === 'gerant' ? '/espace-admin'
                          : '/espace-serveur';
          const prenom = user.prenom || user.email?.split('@')[0] || 'Mon espace';

          navBtn.innerHTML = `
            <span style="display:flex;align-items:center;gap:1rem;">
              <a href="${espaceUrl}" class="btn-nav">&#128100; ${prenom}</a>
              <a href="/logout" class="btn-nav-logout">Déconnexion</a>
            </span>`;

          mobileBtn.innerHTML = `
            <a href="${espaceUrl}" class="mobile-cta">&#128100; ${prenom}</a>
            <a href="/logout" style="display:block;color:var(--brun-light);padding:0.7rem 0;font-size:0.8rem;text-decoration:none;border-top:1px solid var(--creme-dark);text-align:center;text-transform:uppercase;letter-spacing:0.08em;margin-top:0.5rem;">
              Déconnexion
            </a>`;
        } else {
          navBtn.innerHTML    = `<a href="/login" class="btn-nav">&#128100; Se connecter</a>`;
          mobileBtn.innerHTML = `<a href="/login" class="mobile-cta">&#128100; Se connecter</a>`;
        }

        // ── 3. Menu mobile toggle ──
        const menuBtn    = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', () => {
            mobileMenu.style.display = mobileMenu.style.display === 'block' ? 'none' : 'block';
          });
        }

        // ── 4. Reveal animation ──
        const reveals = document.querySelectorAll('.reveal');
        if (reveals.length) {
          const observer = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
          }, { threshold: 0.1 });
          reveals.forEach(el => observer.observe(el));
        }
      })();
    </script>