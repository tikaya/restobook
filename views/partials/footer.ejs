<style>
  /* ── Footer ── */
  .site-footer {
    background: var(--brun, #3D2B1F);
    color: rgba(255,255,255,0.6);
    font-family: 'DM Sans', sans-serif;
  }

  .footer-top {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.5rem 2rem 2.5rem;
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr;
    gap: 2.5rem;
  }

  /* Brand */
  .footer-brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }
  .footer-brand span { color: var(--or, #C9A84C); }

  .footer-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    font-style: italic;
    color: rgba(255,255,255,0.45);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .footer-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }
  .footer-contact-item span:first-child { flex-shrink: 0; }

  /* Colonnes */
  .footer-col-title {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--or, #C9A84C);
    margin-bottom: 1.1rem;
  }

  .footer-links {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer-links a {
    text-decoration: none;
    color: rgba(255,255,255,0.5);
    font-size: 0.82rem;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .footer-links a::before {
    content: '—';
    color: var(--or, #C9A84C);
    opacity: 0.4;
    font-size: 0.7rem;
    transition: opacity 0.2s;
  }
  .footer-links a:hover { color: #fff; }
  .footer-links a:hover::before { opacity: 1; }

  /* Réseaux sociaux */
  .social-desc {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1rem;
    line-height: 1.5;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
  }
  .social-btns {
    display: flex;
    gap: 0.6rem;
  }
  .social-btn {
    width: 38px; height: 38px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.12);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    text-decoration: none;
  }
  .social-btn:hover {
    background: var(--or, #C9A84C);
    border-color: var(--or, #C9A84C);
    color: var(--brun, #3D2B1F);
    transform: translateY(-2px);
  }

  /* Séparateur */
  .footer-sep {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 1px;
    background: rgba(255,255,255,0.06);
  }

  /* Bottom */
  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .footer-bottom-copy {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.02em;
  }
  .footer-bottom-links {
    display: flex;
    gap: 1.25rem;
  }
  .footer-bottom-links a {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-bottom-links a:hover { color: rgba(255,255,255,0.7); }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
    .footer-top > div:first-child { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
</style>

<footer class="site-footer">

  <div class="footer-top">

    <!-- Brand + contact -->
    <div>
      <div class="footer-brand">Le Gourmet <span>Parisien</span></div>
      <p class="footer-tagline">Une cuisine raffinée au cœur du Marais,<br>fondée par Sophie et Marc.</p>
      <div class="footer-contact-item">
        <span>📍</span>
        <span>12 rue des Archives, 75004 Paris</span>
      </div>
      <div class="footer-contact-item">
        <span>📞</span>
        <span>01 23 45 67 89</span>
      </div>
      <div class="footer-contact-item">
        <span>✉️</span>
        <span>contact@gourmet-parisien.fr</span>
      </div>
    </div>

    <!-- Navigation -->
    <div>
      <div class="footer-col-title">Navigation</div>
      <ul class="footer-links">
        <li><a href="/">Accueil</a></li>
        <li><a href="/carte">Notre carte</a></li>
        <li><a href="/reservation">Réserver</a></li>
        <li><a href="/avis">Avis clients</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
      </ul>
    </div>

    <!-- Réseaux -->
    <div>
      <div class="footer-col-title">Suivez-nous</div>
      <p class="social-desc">Retrouvez-nous sur les réseaux et partagez vos moments gourmands.</p>
      <div class="social-btns">
        <a href="#" class="social-btn" title="Facebook">fb</a>
        <a href="#" class="social-btn" title="Instagram">ig</a>
        <a href="#" class="social-btn" title="TripAdvisor">ta</a>
      </div>
    </div>

  </div>

  <div class="footer-sep"></div>

  <div class="footer-bottom">
    <span class="footer-bottom-copy">© 2026 Le Gourmet Parisien — Tous droits réservés</span>
    <div class="footer-bottom-links">
      <a href="/mentions-legales">Mentions légales</a>
      <a href="#">Confidentialité</a>
      <a href="/contact">Contact</a>
    </div>
  </div>

</footer>
<%- include('cookie-banner') %>
</body>
</html>