<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Changer mon mot de passe — Le Gourmet Parisien</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bordeaux: #6B1A2A; --bordeaux-light: #8B2A3A; --bordeaux-pale: #f5eaec;
      --or: #C9A84C; --creme: #FAF6F0; --creme-dark: #EDE5D8;
      --brun: #3D2B1F; --brun-light: #7A5C4A; --blanc: #FFFFFF;
      --vert: #2e7d32; --vert-pale: #e8f5e9;
      --rouge: #c62828; --rouge-pale: #fdecea;
      --orange: #e65100; --orange-pale: #fff3e0;
      --radius: 12px; --radius-sm: 8px;
      --shadow: 0 4px 32px rgba(61,43,31,0.12);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--creme);
      color: var(--brun);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── Header ── */
    .header {
      background: var(--bordeaux);
      height: 60px;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 20px rgba(61,43,31,0.2);
    }
    .header-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--or);
      text-decoration: none;
    }

    /* ── Hero ── */
    .hero {
      background: var(--bordeaux);
      padding: 3rem 2rem 5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(201,168,76,0.1), transparent);
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 40px;
      background: var(--creme);
      clip-path: ellipse(55% 100% at 50% 100%);
    }
    .hero-content { position: relative; z-index: 1; }
    .hero-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
    .hero-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: #fff;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .hero-sub {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1rem;
      color: rgba(255,255,255,0.6);
      font-style: italic;
    }

    /* ── Card ── */
    .card-wrapper {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 2rem 1.5rem 4rem;
    }
    .card {
      background: var(--blanc);
      border: 1px solid var(--creme-dark);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 2rem;
      width: 100%;
      max-width: 420px;
    }

    /* ── Alerte obligatoire ── */
    .alert-required {
      background: var(--orange-pale);
      border: 1px solid rgba(230,81,0,0.2);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1rem;
      font-size: 0.82rem;
      color: var(--orange);
      line-height: 1.5;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      color: var(--bordeaux);
      margin-bottom: 0.5rem;
    }
    .card-desc {
      font-family: 'Cormorant Garamond', serif;
      font-size: 0.95rem;
      color: var(--brun-light);
      font-style: italic;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--creme-dark);
    }

    /* ── Form ── */
    .form-group { margin-bottom: 1rem; position: relative; }
    .form-label {
      display: block;
      font-size: 0.72rem; font-weight: 500;
      color: var(--brun-light);
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 0.35rem;
    }
    .form-input {
      width: 100%;
      padding: 0.75rem 1rem;
      padding-right: 2.5rem;
      border: 1.5px solid var(--creme-dark);
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.9rem;
      color: var(--brun);
      background: var(--creme);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-input:focus {
      border-color: var(--bordeaux);
      background: var(--blanc);
      box-shadow: 0 0 0 3px rgba(107,26,42,0.08);
    }
    .form-input.valid   { border-color: var(--vert); }
    .form-input.invalid { border-color: var(--rouge); }

    /* ── Toggle password ── */
    .toggle-pwd {
      position: absolute; right: 0.75rem; top: 2.1rem;
      cursor: pointer; font-size: 1rem; color: var(--brun-light);
      background: none; border: none; padding: 0;
      transition: color 0.2s;
    }
    .toggle-pwd:hover { color: var(--bordeaux); }

    /* ── Indicateur force mdp ── */
    .pwd-strength { margin-top: 0.5rem; }
    .pwd-strength-bar {
      height: 4px;
      border-radius: 2px;
      background: var(--creme-dark);
      margin-bottom: 0.3rem;
      overflow: hidden;
    }
    .pwd-strength-fill {
      height: 100%;
      border-radius: 2px;
      transition: width 0.3s, background 0.3s;
      width: 0%;
    }
    .pwd-strength-text { font-size: 0.72rem; color: var(--brun-light); }

    .pwd-rules { margin-top: 0.5rem; }
    .pwd-rule {
      font-size: 0.75rem;
      color: var(--brun-light);
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-bottom: 0.2rem;
      transition: color 0.2s;
    }
    .pwd-rule.ok { color: var(--vert); }
    .pwd-rule-icon { font-size: 0.7rem; }

    /* ── Feedback ── */
    .feedback-msg {
      display: none;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 1rem;
    }
    .feedback-msg.success { background: var(--vert-pale); color: var(--vert); border: 1px solid rgba(46,125,50,0.2); }
    .feedback-msg.error   { background: var(--rouge-pale); color: var(--rouge); border: 1px solid rgba(198,40,40,0.2); }

    /* ── Bouton ── */
    .btn-submit {
      width: 100%;
      padding: 0.85rem;
      background: var(--bordeaux);
      color: #fff;
      border: none;
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-submit:hover { background: var(--bordeaux-light); transform: translateY(-1px); }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    /* ── Footer ── */
    .footer {
      text-align: center; padding: 1.25rem 2rem;
      color: var(--brun-light); font-size: 0.75rem;
      border-top: 1px solid var(--creme-dark);
      font-family: 'Cormorant Garamond', serif; font-style: italic;
    }
    .footer a { color: var(--or); text-decoration: none; }
  </style>
</head>
<body>

<header class="header">
  <a href="/" class="header-logo">Le Gourmet Parisien</a>
</header>

<div class="hero">
  <div class="hero-content">
    <span class="hero-icon">🔒</span>
    <h1 class="hero-title">Changement de mot de passe</h1>
    <p class="hero-sub">Sécurisez votre compte avec un nouveau mot de passe</p>
  </div>
</div>

<div class="card-wrapper">
  <div class="card">

    <div class="alert-required">
      ⚠️ <span>Vous devez changer votre mot de passe temporaire avant de continuer.</span>
    </div>

    <h2 class="card-title">Créer un nouveau mot de passe</h2>
    <p class="card-desc">
      Choisissez un mot de passe robuste. Il devra contenir au moins 8 caractères, une majuscule, un chiffre et un symbole.
    </p>

    <div class="feedback-msg" id="feedback-msg"></div>

    <form id="change-pwd-form">
      <!-- Nouveau mot de passe -->
      <div class="form-group">
        <label class="form-label" for="new_password">Nouveau mot de passe *</label>
        <input
          type="password"
          id="new_password"
          name="new_password"
          class="form-input"
          placeholder="Min. 8 car., maj., chiffre, symbole"
          required
          autocomplete="new-password"
        >
        <button type="button" class="toggle-pwd" onclick="togglePwd('new_password', this)">👁</button>

        <!-- Indicateur de force -->
        <div class="pwd-strength">
          <div class="pwd-strength-bar">
            <div class="pwd-strength-fill" id="strength-fill"></div>
          </div>
          <div class="pwd-strength-text" id="strength-text">Entrez un mot de passe</div>
        </div>

        <!-- Règles -->
        <div class="pwd-rules">
          <div class="pwd-rule" id="rule-length">  <span class="pwd-rule-icon">○</span> Au moins 8 caractères</div>
          <div class="pwd-rule" id="rule-upper">   <span class="pwd-rule-icon">○</span> Une lettre majuscule</div>
          <div class="pwd-rule" id="rule-number">  <span class="pwd-rule-icon">○</span> Un chiffre</div>
          <div class="pwd-rule" id="rule-symbol">  <span class="pwd-rule-icon">○</span> Un symbole (!@#$...)</div>
        </div>
      </div>

      <!-- Confirmation -->
      <div class="form-group">
        <label class="form-label" for="confirm_password">Confirmer le mot de passe *</label>
        <input
          type="password"
          id="confirm_password"
          name="confirm_password"
          class="form-input"
          placeholder="Répétez votre mot de passe"
          required
          autocomplete="new-password"
        >
        <button type="button" class="toggle-pwd" onclick="togglePwd('confirm_password', this)">👁</button>
      </div>

      <button type="submit" class="btn-submit" id="submit-btn">
        🔒 Enregistrer le nouveau mot de passe
      </button>
    </form>
  </div>
</div>

<footer class="footer">
  Le Gourmet Parisien — © 2026 — <a href="/">Retour au site</a>
</footer>

<script>
  // ── Récupérer le tempToken stocké lors du login ──────────
  // Le login renvoie { mustChangePassword: true, tempToken }
  // Le frontend doit stocker ce token temporairement (cookie ou sessionStorage)
  function getTempToken() {
    // Chercher d'abord dans sessionStorage
    const fromSession = sessionStorage.getItem('tempToken');
    if (fromSession) return fromSession;
    // Puis dans les cookies
    return document.cookie.split('; ').find(c => c.startsWith('tempToken='))?.split('=')[1] || null;
  }

  // ── Toggle visibilité mot de passe ───────────────────────
  function togglePwd(inputId, btn) {
    const input = document.getElementById(inputId);
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁';
    }
  }

  // ── Indicateur de force mot de passe ─────────────────────
  const newPwdInput = document.getElementById('new_password');
  const strengthFill = document.getElementById('strength-fill');
  const strengthText = document.getElementById('strength-text');

  const rules = {
    length: { el: document.getElementById('rule-length'), test: p => p.length >= 8 },
    upper:  { el: document.getElementById('rule-upper'),  test: p => /[A-Z]/.test(p) },
    number: { el: document.getElementById('rule-number'), test: p => /[0-9]/.test(p) },
    symbol: { el: document.getElementById('rule-symbol'), test: p => /[!@#$%^&*(),.?":{}|<>_\-+=\[\]\\\/~`]/.test(p) }
  };

  const levels = [
    { label: 'Très faible', color: '#ef4444', width: '20%' },
    { label: 'Faible',      color: '#f97316', width: '40%' },
    { label: 'Moyen',       color: '#eab308', width: '60%' },
    { label: 'Fort',        color: '#22c55e', width: '80%' },
    { label: 'Très fort',   color: '#16a34a', width: '100%' }
  ];

  newPwdInput.addEventListener('input', () => {
    const pwd = newPwdInput.value;
    let score = 0;

    Object.values(rules).forEach(rule => {
      const ok = rule.test(pwd);
      if (ok) score++;
      rule.el.classList.toggle('ok', ok);
      rule.el.querySelector('.pwd-rule-icon').textContent = ok ? '●' : '○';
    });

    if (pwd.length === 0) {
      strengthFill.style.width = '0%';
      strengthText.textContent = 'Entrez un mot de passe';
      return;
    }

    const level = levels[Math.max(0, score - 1)];
    strengthFill.style.width      = level.width;
    strengthFill.style.background = level.color;
    strengthText.textContent      = level.label;
    strengthText.style.color      = level.color;
  });

  // ── Soumission ────────────────────────────────────────────
  const form      = document.getElementById('change-pwd-form');
  const feedback  = document.getElementById('feedback-msg');
  const submitBtn = document.getElementById('submit-btn');

  function showFeedback(ok, msg) {
    feedback.className = 'feedback-msg ' + (ok ? 'success' : 'error');
    feedback.innerHTML = (ok ? '✓ ' : '✗ ') + msg;
    feedback.style.display = 'block';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const newPwd     = document.getElementById('new_password').value;
    const confirmPwd = document.getElementById('confirm_password').value;

    // Vérification côté client
    if (newPwd !== confirmPwd) {
      showFeedback(false, 'Les mots de passe ne correspondent pas.');
      return;
    }

    const allValid = Object.values(rules).every(r => r.test(newPwd));
    if (!allValid) {
      showFeedback(false, 'Votre mot de passe ne respecte pas les critères de sécurité.');
      return;
    }

    submitBtn.disabled    = true;
    submitBtn.textContent = '⏳ Enregistrement...';
    feedback.style.display = 'none';

    // Utiliser le token temporaire reçu lors du login mustChangePassword
    const token = getTempToken();

    try {
      const res = await fetch('/auth/change-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify({ new_password: newPwd })
      });

      const data = await res.json();

      if (res.ok) {
        // Nettoyer le token temporaire
        sessionStorage.removeItem('tempToken');
        document.cookie = 'tempToken=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';

        showFeedback(true, 'Mot de passe changé avec succès ! Redirection vers la connexion...');
        submitBtn.textContent = '✓ Mot de passe changé';

        // Redirection vers login après 2 secondes
        setTimeout(() => { window.location.href = '/login'; }, 2000);
      } else {
        showFeedback(false, data.error || 'Erreur lors du changement de mot de passe.');
        submitBtn.disabled    = false;
        submitBtn.textContent = '🔒 Enregistrer le nouveau mot de passe';
      }
    } catch {
      showFeedback(false, 'Erreur de connexion. Veuillez réessayer.');
      submitBtn.disabled    = false;
      submitBtn.textContent = '🔒 Enregistrer le nouveau mot de passe';
    }
  });
</script>

</body>
</html>