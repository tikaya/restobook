<%- include('partials/header') %>

    <section class="hero" style="padding: 3.5rem 2rem;">
        <div class="hero-content" style="max-width:600px;">
            <h1 style="font-size: clamp(2rem, 4vw, 3rem);">Contact</h1>
            <div class="hero-divider"></div>
            <p class="hero-subtitle">Une question ? N'hésitez pas à nous écrire</p>
        </div>
    </section>

    <section style="background: var(--creme); padding: 4rem 2rem;">
        <div style="max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
            <!-- Formulaire -->
            <div class="card">
                <h2 class="card-title">Envoyez-nous un message</h2>
                <div class="card-underline"></div>

                <div id="message" style="display:none; padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem;"></div>

                <form id="contact-form" style="display: flex; flex-direction: column; gap: 1.2rem;">
                    <div>
                        <label class="form-label">Nom *</label>
                        <input type="text" name="nom_expediteur" class="form-input" required>
                    </div>
                    <div>
                        <label class="form-label">Email *</label>
                        <input type="email" name="email_expediteur" class="form-input" required>
                    </div>
                    <div>
                        <label class="form-label">Sujet *</label>
                        <input type="text" name="sujet_message" class="form-input" required>
                    </div>
                    <div>
                        <label class="form-label">Message *</label>
                        <textarea name="contenu_message" class="form-input" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="btn-primary" style="width: 100%; border: none; cursor: pointer;">
                        Envoyer le message
                    </button>
                </form>
            </div>

            <!-- Infos -->
            <div class="card">
                <h2 class="card-title">Nos coordonnées</h2>
                <div class="card-underline"></div>
                <div style="display: flex; flex-direction: column; gap: 1.5rem; color: var(--brun-light); line-height: 1.8;">
                    <div>
                        <p style="font-weight: 700; color: var(--brun); margin-bottom: 0.3rem;">📍 Adresse</p>
                        <p>12 rue des Archives<br>75004 Paris — Le Marais</p>
                    </div>
                    <div>
                        <p style="font-weight: 700; color: var(--brun); margin-bottom: 0.3rem;">📞 Téléphone</p>
                        <p>01 23 45 67 89</p>
                    </div>
                    <div>
                        <p style="font-weight: 700; color: var(--brun); margin-bottom: 0.3rem;">✉️ Email</p>
                        <p>contact@gourmet-parisien.fr</p>
                    </div>
                    <div>
                        <p style="font-weight: 700; color: var(--brun); margin-bottom: 0.3rem;">🕐 Horaires</p>
                        <p>Mardi – Dimanche<br>12h00 – 15h00 / 19h00 – 23h00</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        .form-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--brun);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.4rem;
        }
        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--creme-dark);
            border-radius: 2px;
            font-family: 'Lato', sans-serif;
            font-size: 0.9rem;
            color: var(--brun);
            background: var(--creme);
            transition: border-color 0.2s;
        }
        .form-input:focus { outline: none; border-color: var(--bordeaux); }

        @media (max-width: 768px) {
            div[style*="grid-template-columns: 1fr 1fr"] {
                grid-template-columns: 1fr !important;
            }
        }
    </style>

    <script>
        document.getElementById('contact-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const msg = document.getElementById('message');

            const data = {
                nom_expediteur: form.nom_expediteur.value,
                email_expediteur: form.email_expediteur.value,
                sujet_message: form.sujet_message.value,
                contenu_message: form.contenu_message.value
            };

            try {
                const res = await fetch('/contact', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (res.ok) {
                    msg.style.display = 'block';
                    msg.style.background = '#e8f8f0';
                    msg.style.color = '#0a8754';
                    msg.style.border = '1px solid #0a8754';
                    msg.innerHTML = 'Message envoyé avec succès ! Nous vous répondrons rapidement.';
                    form.reset();
                } else {
                    msg.style.display = 'block';
                    msg.style.background = '#fff0f0';
                    msg.style.color = '#c0392b';
                    msg.style.border = '1px solid #c0392b';
                    msg.innerHTML = result.error || result.errors?.join('<br>') || 'Erreur';
                }
            } catch (err) {
                msg.style.display = 'block';
                msg.style.background = '#fff0f0';
                msg.style.color = '#c0392b';
                msg.innerHTML = 'Erreur de connexion au serveur';
            }
        });
    </script>

<%- include('partials/footer') %>