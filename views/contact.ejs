<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  /* ── Hero ── */
  .contact-hero {
    background: var(--bordeaux);
    padding: 4rem 2rem 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .contact-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .contact-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50px;
    background: var(--creme);
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .contact-hero-content { position: relative; z-index: 1; }
  .contact-hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.75rem;
  }
  .contact-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: #fff;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .contact-hero h1 em { font-style: italic; color: var(--or); }
  .contact-hero p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    color: rgba(255,255,255,0.65);
    font-style: italic;
  }

  /* ── Body ── */
  .contact-page {
    background: var(--creme);
    padding: 3rem 2rem 5rem;
  }
  .contact-grid {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.5rem;
    align-items: start;
  }

  /* ── Card commune ── */
  .contact-card {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(61,43,31,0.06);
  }
  .contact-card-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.4rem;
  }
  .contact-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--bordeaux);
    margin-bottom: 0.3rem;
  }
  .contact-card-line {
    width: 36px;
    height: 2px;
    background: var(--or);
    margin-bottom: 1.5rem;
    border-radius: 2px;
  }

  /* ── Message feedback ── */
  .contact-msg {
    display: none;
    padding: 0.875rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .contact-msg.success { background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); }
  .contact-msg.error   { background: #fdecea; color: #c62828; border: 1px solid rgba(198,40,40,0.2); }

  /* ── Formulaire ── */
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--brun-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .form-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--creme-dark);
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--brun);
    background: var(--creme);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
    resize: vertical;
  }
  .form-input:focus {
    border-color: var(--bordeaux);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(107,26,42,0.08);
  }
  textarea.form-input { min-height: 130px; }

  /* Compteur caractères */
  .char-count {
    font-size: 0.7rem;
    color: var(--brun-light);
    text-align: right;
    opacity: 0.6;
    font-family: 'DM Sans', sans-serif;
  }

  .btn-submit {
    width: 100%;
    padding: 0.85rem;
    background: var(--bordeaux);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .btn-submit:hover {
    background: #8B2A3A;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(107,26,42,0.3);
  }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  /* ── Infos coordonnées ── */
  .coord-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .coord-item { display: flex; gap: 1rem; align-items: flex-start; }
  .coord-icon {
    width: 40px; height: 40px;
    background: var(--creme);
    border: 1px solid var(--creme-dark);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .coord-content { line-height: 1.6; }
  .coord-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--brun-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.2rem;
  }
  .coord-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun);
    line-height: 1.5;
  }

  /* Map placeholder */
  .map-placeholder {
    margin-top: 1.5rem;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--creme-dark);
    height: 140px;
    background: linear-gradient(135deg, var(--creme-dark), #e0d4c4);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .map-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 40% 50%, rgba(201,168,76,0.1), transparent 60%);
  }
  .map-placeholder span {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    color: var(--brun-light);
    font-size: 0.9rem;
    opacity: 0.7;
    position: relative;
    z-index: 1;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- Hero -->
<section class="contact-hero">
  <div class="contact-hero-content">
    <p class="contact-hero-eyebrow">Le Gourmet Parisien</p>
    <h1>Nous <em>contacter</em></h1>
    <p>Une question ? N'hésitez pas à nous écrire</p>
  </div>
</section>

<!-- Body -->
<div class="contact-page">
  <div class="contact-grid">

    <!-- ── Formulaire ── -->
    <div class="contact-card">
      <p class="contact-card-eyebrow">Formulaire</p>
      <h2 class="contact-card-title">Envoyez-nous un message</h2>
      <div class="contact-card-line"></div>

      <div class="contact-msg" id="message"></div>

      <form id="contact-form" class="contact-form">

        <div class="form-group">
          <label class="form-label">Nom complet *</label>
          <input type="text" name="nom_expediteur" class="form-input" placeholder="Jean Dupont" required>
        </div>

        <div class="form-group">
          <label class="form-label">Email *</label>
          <input type="email" name="email_expediteur" class="form-input" placeholder="jean@email.com" required>
        </div>

        <div class="form-group">
          <label class="form-label">Sujet *</label>
          <input type="text" name="sujet_message" class="form-input" placeholder="Ex : Réservation de groupe" required>
        </div>

        <div class="form-group">
          <label class="form-label">Message *</label>
          <textarea name="contenu_message" id="msg-textarea" class="form-input" rows="5" placeholder="Votre message..." required></textarea>
          <span class="char-count" id="char-count">0 / 500</span>
        </div>

        <button type="submit" class="btn-submit" id="btn-submit">
          <span>Envoyer le message</span> →
        </button>

      </form>
    </div>

    <!-- ── Coordonnées ── -->
    <div class="contact-card">
      <p class="contact-card-eyebrow">Coordonnées</p>
      <h2 class="contact-card-title">Nos informations</h2>
      <div class="contact-card-line"></div>

      <div class="coord-list">
        <div class="coord-item">
          <div class="coord-icon">📍</div>
          <div class="coord-content">
            <div class="coord-label">Adresse</div>
            <div class="coord-value">12 rue des Archives<br>75004 Paris — Le Marais</div>
          </div>
        </div>
        <div class="coord-item">
          <div class="coord-icon">📞</div>
          <div class="coord-content">
            <div class="coord-label">Téléphone</div>
            <div class="coord-value">01 23 45 67 89</div>
          </div>
        </div>
        <div class="coord-item">
          <div class="coord-icon">✉️</div>
          <div class="coord-content">
            <div class="coord-label">Email</div>
            <div class="coord-value">contact@gourmet-parisien.fr</div>
          </div>
        </div>
        <div class="coord-item">
          <div class="coord-icon">🕐</div>
          <div class="coord-content">
            <div class="coord-label">Horaires</div>
            <div class="coord-value">Mardi – Dimanche<br>12h – 15h · 19h – 23h</div>
          </div>
        </div>
      </div>

      <div class="map-placeholder">
        <span>📍 12 rue des Archives, Paris 4e</span>
      </div>
    </div>

  </div>
</div>

<script>
  // ── Compteur caractères ───────────────────────────────────
  document.getElementById('msg-textarea').addEventListener('input', function() {
    const count = this.value.length;
    const el    = document.getElementById('char-count');
    el.textContent = count + ' / 500';
    el.style.color = count > 450 ? '#c62828' : '';
  });

  // ── Message feedback ──────────────────────────────────────
  function showMsg(ok, text) {
    const msg = document.getElementById('message');
    msg.className = 'contact-msg ' + (ok ? 'success' : 'error');
    msg.style.display = 'block';
    msg.innerHTML = (ok ? '✓ ' : '✗ ') + text;
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Soumission ────────────────────────────────────────────
  document.getElementById('contact-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn  = document.getElementById('btn-submit');

    btn.disabled = true;
    btn.innerHTML = '<span>Envoi en cours...</span>';

    const data = {
      nom_expediteur:   form.nom_expediteur.value.trim(),
      email_expediteur: form.email_expediteur.value.trim(),
      sujet_message:    form.sujet_message.value.trim(),
      contenu_message:  form.contenu_message.value.trim()
    };

    try {
      const res    = await fetch('/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();

      if (res.ok) {
        showMsg(true, 'Message envoyé avec succès ! Nous vous répondrons rapidement.');
        form.reset();
        document.getElementById('char-count').textContent = '0 / 500';
      } else {
        showMsg(false, result.error || (result.errors && result.errors.join('<br>')) || 'Une erreur est survenue.');
      }
    } catch (err) {
      showMsg(false, 'Erreur de connexion au serveur.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span>Envoyer le message</span> →';
    }
  });
</script>

<%- include('partials/footer') %>