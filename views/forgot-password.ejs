<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mot de passe oublié — Le Gourmet Parisien</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bordeaux: #6B1A2A; --bordeaux-light: #8B2A3A; --bordeaux-pale: #f5eaec;
      --or: #C9A84C; --creme: #FAF6F0; --creme-dark: #EDE5D8;
      --brun: #3D2B1F; --brun-light: #7A5C4A; --blanc: #FFFFFF;
      --vert: #2e7d32; --vert-pale: #e8f5e9;
      --rouge: #c62828; --rouge-pale: #fdecea;
      --radius: 12px; --radius-sm: 8px;
      --shadow: 0 4px 32px rgba(61,43,31,0.12);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--creme);
      color: var(--brun);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── Header ── */
    .header {
      background: var(--bordeaux);
      height: 60px;
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 20px rgba(61,43,31,0.2);
    }
    .header-logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--or);
      text-decoration: none;
    }
    .header-back {
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: color 0.2s;
    }
    .header-back:hover { color: var(--or); }

    /* ── Hero ── */
    .hero {
      background: var(--bordeaux);
      padding: 3rem 2rem 5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(201,168,76,0.1), transparent);
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 40px;
      background: var(--creme);
      clip-path: ellipse(55% 100% at 50% 100%);
    }
    .hero-content { position: relative; z-index: 1; }
    .hero-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
    .hero-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: #fff;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .hero-sub {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1rem;
      color: rgba(255,255,255,0.6);
      font-style: italic;
    }

    /* ── Card ── */
    .card-wrapper {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 2rem 1.5rem 4rem;
    }
    .card {
      background: var(--blanc);
      border: 1px solid var(--creme-dark);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 2rem;
      width: 100%;
      max-width: 420px;
    }

    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      color: var(--bordeaux);
      margin-bottom: 0.5rem;
    }
    .card-desc {
      font-family: 'Cormorant Garamond', serif;
      font-size: 0.95rem;
      color: var(--brun-light);
      font-style: italic;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--creme-dark);
    }

    /* ── Form ── */
    .form-group { margin-bottom: 1rem; }
    .form-label {
      display: block;
      font-size: 0.72rem; font-weight: 500;
      color: var(--brun-light);
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 0.35rem;
    }
    .form-input {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1.5px solid var(--creme-dark);
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.9rem;
      color: var(--brun);
      background: var(--creme);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-input:focus {
      border-color: var(--bordeaux);
      background: var(--blanc);
      box-shadow: 0 0 0 3px rgba(107,26,42,0.08);
    }

    /* ── Feedback ── */
    .feedback-msg {
      display: none;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 1rem;
      line-height: 1.5;
    }
    .feedback-msg.success { background: var(--vert-pale); color: var(--vert); border: 1px solid rgba(46,125,50,0.2); }
    .feedback-msg.error   { background: var(--rouge-pale); color: var(--rouge); border: 1px solid rgba(198,40,40,0.2); }

    /* ── Bouton ── */
    .btn-submit {
      width: 100%;
      padding: 0.85rem;
      background: var(--bordeaux);
      color: #fff;
      border: none;
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      margin-bottom: 1rem;
    }
    .btn-submit:hover { background: var(--bordeaux-light); transform: translateY(-1px); }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .back-link {
      display: block;
      text-align: center;
      font-size: 0.82rem;
      color: var(--brun-light);
      text-decoration: none;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--bordeaux); }

    /* ── Info box ── */
    .info-box {
      background: var(--bordeaux-pale);
      border: 1px solid rgba(107,26,42,0.1);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1rem;
      font-size: 0.8rem;
      color: var(--bordeaux);
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }
    .info-box strong { font-weight: 600; }

    /* ── Footer ── */
    .footer {
      text-align: center; padding: 1.25rem 2rem;
      color: var(--brun-light); font-size: 0.75rem;
      border-top: 1px solid var(--creme-dark);
      font-family: 'Cormorant Garamond', serif; font-style: italic;
    }
    .footer a { color: var(--or); text-decoration: none; }
  </style>
</head>
<body>

<header class="header">
  <a href="/" class="header-logo">Le Gourmet Parisien</a>
  <a href="/login" class="header-back">← Retour à la connexion</a>
</header>

<div class="hero">
  <div class="hero-content">
    <span class="hero-icon">🔑</span>
    <h1 class="hero-title">Mot de passe oublié</h1>
    <p class="hero-sub">Nous vous enverrons un nouveau mot de passe par email</p>
  </div>
</div>

<div class="card-wrapper">
  <div class="card">
    <h2 class="card-title">Réinitialiser mon mot de passe</h2>
    <p class="card-desc">
      Saisissez votre adresse email. Si un compte existe, vous recevrez un mot de passe temporaire à utiliser pour votre prochaine connexion.
    </p>

    <div class="info-box">
      📧 <strong>Comment ça marche ?</strong><br>
      Un mot de passe temporaire sera généré et envoyé à votre adresse email. Vous devrez le changer lors de votre prochaine connexion.
    </div>

    <div class="feedback-msg" id="feedback-msg"></div>

    <form id="forgot-form">
      <div class="form-group">
        <label class="form-label" for="email">Adresse email *</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          placeholder="votre@email.com"
          required
          autocomplete="email"
        >
      </div>
      <button type="submit" class="btn-submit" id="submit-btn">
        📨 Envoyer le mot de passe temporaire
      </button>
    </form>

    <a href="/login" class="back-link">← Retour à la connexion</a>
  </div>
</div>

<footer class="footer">
  Le Gourmet Parisien — © 2026 — <a href="/">Retour au site</a>
</footer>

<script>
  const form      = document.getElementById('forgot-form');
  const feedback  = document.getElementById('feedback-msg');
  const submitBtn = document.getElementById('submit-btn');

  function showFeedback(ok, msg) {
    feedback.className = 'feedback-msg ' + (ok ? 'success' : 'error');
    feedback.innerHTML = (ok ? '✓ ' : '✗ ') + msg;
    feedback.style.display = 'block';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value.trim();

    submitBtn.disabled    = true;
    submitBtn.textContent = '⏳ Envoi en cours...';
    feedback.style.display = 'none';

    try {
      const res = await fetch('/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      const data = await res.json();

      if (res.ok) {
        showFeedback(true, 'Un mot de passe temporaire a été envoyé à ' + email + '. Vérifiez votre boîte mail.');
        form.reset();
        submitBtn.textContent = '✓ Email envoyé';
        // Redirection vers login après 3 secondes
        setTimeout(() => { window.location.href = '/login'; }, 3000);
      } else {
        showFeedback(false, data.error || 'Une erreur est survenue. Veuillez réessayer.');
        submitBtn.disabled    = false;
        submitBtn.textContent = '📨 Envoyer le mot de passe temporaire';
      }
    } catch {
      showFeedback(false, 'Erreur de connexion. Veuillez réessayer.');
      submitBtn.disabled    = false;
      submitBtn.textContent = '📨 Envoyer le mot de passe temporaire';
    }
  });
</script>

</body>
</html>