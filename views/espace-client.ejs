<!-- Toast -->
<div class="toast" id="toast"><div class="toast-dot"></div><span id="toast-txt"></span></div>

<!-- Donnees serveur -->
<script>
  var serverUser = {
    id:        '<%= userId %>',
    prenom:    '<%= prenomAffiche %>',
    nom:       '<%= nomAffiche %>',
    email:     '<%= user.email %>',
    telephone: '<%= telAffiche %>'
  };
</script>

<script>
  // ── Helpers ───────────────────────────────────────────────
  function getToken() {
    return document.cookie.split('; ').find(c => c.startsWith('token='))?.split('=')[1];
  }
  function authHdr() {
    return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() };
  }
  function showToast(msg, type) {
    type = type || 'success';
    document.getElementById('toast-txt').textContent = msg;
    var t = document.getElementById('toast');
    t.className = 'toast show ' + type;
    setTimeout(function() { t.className = 'toast'; }, 3800);
  }
  function showFbk(id, ok, txt) {
    var el = document.getElementById(id);
    el.className = 'fbk ' + (ok ? 'ok' : 'err');
    el.style.display = 'block';
    el.textContent = txt;
  }
  function closeModal(id) {
    document.getElementById(id).classList.remove('show');
  }
  document.querySelectorAll('.modal-overlay').forEach(function(o) {
    o.addEventListener('click', function(e) { if (e.target === o) o.classList.remove('show'); });
  });

  // Confirm dialog custom
  var confirmCallback = null;
  function showConfirm(icon, title, text, cb) {
    document.getElementById('confirm-icon').textContent  = icon;
    document.getElementById('confirm-title').textContent = title;
    document.getElementById('confirm-text').textContent  = text;
    confirmCallback = cb;
    document.getElementById('confirm-overlay').classList.add('show');
  }
  function closeConfirm() { document.getElementById('confirm-overlay').classList.remove('show'); }
  document.getElementById('confirm-ok').addEventListener('click', function() {
    closeConfirm();
    if (confirmCallback) confirmCallback();
  });

  // Animated counter
  function animateCount(el, target) {
    var start = 0;
    var step = Math.ceil(target / 20);
    var timer = setInterval(function() {
      start += step;
      if (start >= target) { start = target; clearInterval(timer); }
      el.textContent = start;
    }, 30);
  }

  // ── Horaires ─────────────────────────────────────────────
  var horaires = {
    0: { label: 'Dimanche : 12h-14h30 (derniere resa 14h30)',       services: [[720, 870]] },
    1: { label: 'Ferme le lundi',                                    services: [] },
    2: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    3: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    4: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    5: { label: 'Mar-Ven : 12h-14h · 19h-21h30 (dernieres resas)', services: [[720, 840], [1140, 1290]] },
    6: { label: 'Samedi : 12h-14h30 · 19h-22h (dernieres resas)',  services: [[720, 870], [1140, 1320]] }
  };
  function getJour(v) {
    if (!v) return null;
    var p = v.split('-');
    return new Date(parseInt(p[0]), parseInt(p[1])-1, parseInt(p[2])).getDay();
  }
  function heureOk(jour, h) {
    if (!h || jour === null || !horaires[jour]) return false;
    var p = h.split(':'); var m = parseInt(p[0])*60+parseInt(p[1]);
    return horaires[jour].services.some(function(s) { return m>=s[0]&&m<=s[1]; });
  }

  // Bind date/heure
  var erDate  = document.getElementById('er-date');
  var erHeure = document.getElementById('er-heure');
  var erHD    = document.getElementById('er-hint-date');
  var erHH    = document.getElementById('er-hint-heure');

  erDate.addEventListener('change', function() {
    var j = getJour(this.value);
    if (j === null) return;
    if (j === 1) { this.classList.add('invalid'); erHD.textContent='Ferme le lundi.'; erHD.className='fhint err'; this.value=''; erHeure.value=''; }
    else { this.classList.remove('invalid'); erHD.textContent=horaires[j].label; erHD.className='fhint'; erHeure.value=''; erHH.textContent=horaires[j].label; erHH.className='fhint'; }
  });
  erHeure.addEventListener('change', function() {
    var j = getJour(erDate.value);
    if (j===null){this.value='';return;}
    if (!heureOk(j,this.value)){this.classList.add('invalid');erHH.textContent='Heure hors service';erHH.className='fhint err';}
    else{this.classList.remove('invalid');erHH.textContent='Heure valide ✓';erHH.className='fhint ok';}
  });

  // ── Etoiles ───────────────────────────────────────────────
  var selectedNote = 5;
  var hints = ['','Decevant...','Peut mieux faire','Bien','Tres bien !','Excellent !'];
  document.querySelectorAll('.star-btn').forEach(function(btn) {
    btn.addEventListener('mouseover', function() {
      var v = parseInt(btn.dataset.val);
      document.querySelectorAll('.star-btn').forEach(function(s) { s.classList.toggle('active', parseInt(s.dataset.val)<=v); });
      document.getElementById('star-hint').textContent = hints[v] || '';
    });
    btn.addEventListener('mouseleave', function() {
      document.querySelectorAll('.star-btn').forEach(function(s) { s.classList.toggle('active', parseInt(s.dataset.val)<=selectedNote); });
      document.getElementById('star-hint').textContent = hints[selectedNote] || '';
    });
    btn.addEventListener('click', function() {
      selectedNote = parseInt(btn.dataset.val);
      document.getElementById('note-val').value = selectedNote;
      document.getElementById('star-hint').textContent = hints[selectedNote]||'';
    });
  });

  // ── Emplacement ───────────────────────────────────────────
  var selectedEmpl = '';
  function selectEmpl(pill, val) {
    document.querySelectorAll('.empl-pill').forEach(function(p){p.classList.remove('active');});
    pill.classList.add('active'); selectedEmpl = val;
  }

  // ── Reservations ─────────────────────────────────────────
  var emplIcons = { interieur:'&#127968;', terrasse:'&#127807;', salon_prive:'&#10024;' };
  var emplLabels = { interieur:'Interieur', terrasse:'Terrasse', salon_prive:'Salon prive' };
  var badgeMap = { honoree:'badge-honoree', annulee:'badge-annulee', no_show:'badge-no_show', en_attente:'badge-en_attente', confirmee:'badge-confirmee' };
  var labelMap = { honoree:'Honoree', annulee:'Annulee', no_show:'No-show', en_attente:'En attente', confirmee:'Confirmee' };

  async function loadReservations() {
    try {
      var res = await fetch('/reservations/mes-reservations', { headers: { 'Authorization': 'Bearer ' + getToken() } });
      if (!res.ok) throw new Error();
      var mine = await res.json();

      var today = new Date(); today.setHours(0,0,0,0);

      var upcoming = mine.filter(function(r) {
        if (!r.date_reservation) return false;
        var p = r.date_reservation.split('T')[0].split('-');
        var d = new Date(parseInt(p[0]),parseInt(p[1])-1,parseInt(p[2]));
        return d >= today && (r.statut_reservation==='confirmee'||r.statut_reservation==='en_attente');
      });
      var past = mine.filter(function(r) {
        if (!r.date_reservation) return true;
        var p = r.date_reservation.split('T')[0].split('-');
        var d = new Date(parseInt(p[0]),parseInt(p[1])-1,parseInt(p[2]));
        return d < today || (r.statut_reservation!=='confirmee'&&r.statut_reservation!=='en_attente');
      });
      var honorees = mine.filter(function(r) { return r.statut_reservation==='honoree'; });
      var annulees = mine.filter(function(r) { return r.statut_reservation==='annulee'; });

      // Stats animees
      animateCount(document.getElementById('stat-upcoming'), upcoming.length);
      animateCount(document.getElementById('stat-total'),    mine.length);
      animateCount(document.getElementById('stat-honoree'),  honorees.length);
      animateCount(document.getElementById('stat-annulee'),  annulees.length);
      document.getElementById('upcoming-badge').textContent = upcoming.length;
      document.getElementById('history-badge').textContent  = past.length;

      // Prochaines — ticket style
      var upEl = document.getElementById('upcoming-list');
      if (upcoming.length === 0) {
        upEl.innerHTML = '<div class="empty"><span class="empty-icon">&#128197;</span><p>Aucune reservation a venir</p><a href="/reservation" class="btn btn-gold" style="display:inline-flex;width:auto;padding:0.7rem 1.5rem;">Reserver une table</a></div>';
      } else {
        upEl.innerHTML = upcoming.map(function(r) {
          var p    = r.date_reservation.split('T')[0].split('-');
          var d    = new Date(parseInt(p[0]),parseInt(p[1])-1,parseInt(p[2]));
          var heure = r.heure_reservation ? r.heure_reservation.slice(0,5) : '—';
          var dateStr = r.date_reservation.split('T')[0];
          var empl = r.emplacement_table || '';
          var dEnc = encodeURIComponent(r.demandes_speciales||'');
          var eEnc = encodeURIComponent(empl);
          var mois = d.toLocaleDateString('fr-FR',{month:'short'});
          var annee = d.getFullYear();
          return '<div class="res-ticket">' +
            '<div class="res-date-col">' +
              '<div class="res-day">' + d.toLocaleDateString('fr-FR',{day:'2-digit'}) + '</div>' +
              '<div class="res-month">' + mois + '</div>' +
              '<div class="res-year">' + annee + '</div>' +
            '</div>' +
            '<div class="res-info-col">' +
              '<div class="res-time">&#128336; ' + heure + '</div>' +
              '<div class="res-meta">' +
                '<span class="res-chip">&#128101; ' + r.nb_personnes + ' pers.</span>' +
                '<span class="res-chip">&#129681; Table ' + (r.numero_table||r.id_table) + '</span>' +
                (empl ? '<span class="res-chip res-chip-empl">' + (emplIcons[empl]||'') + ' ' + (emplLabels[empl]||empl) + '</span>' : '') +
              '</div>' +
              (r.demandes_speciales ? '<div class="res-demande-txt">"' + r.demandes_speciales + '"</div>' : '') +
            '</div>' +
            '<div class="res-actions-col">' +
              '<button class="btn-ticket-edit" onclick="openModalEditRes(' + r.id_reservation + ',\'' + dateStr + '\',\'' + heure + '\',' + r.nb_personnes + ',\'' + eEnc + '\',\'' + dEnc + '\')">&#9998; Modifier</button>' +
              '<button class="btn-ticket-cancel" onclick="cancelRes(' + r.id_reservation + ')">Annuler</button>' +
            '</div>' +
          '</div>';
        }).join('');
      }

      // Historique — table
      var histEl = document.getElementById('history-list');
      if (past.length === 0) {
        histEl.innerHTML = '<div class="empty" style="border:none;border-radius:0;"><span class="empty-icon">&#128203;</span><p>Votre historique apparaitra ici</p></div>';
      } else {
        histEl.innerHTML = '<table class="history-table"><thead><tr><th>Date</th><th>Heure</th><th>Personnes</th><th>Emplacement</th><th>Statut</th></tr></thead><tbody>' +
          past.map(function(r) {
            var p     = r.date_reservation.split('T')[0].split('-');
            var d     = new Date(parseInt(p[0]),parseInt(p[1])-1,parseInt(p[2]));
            var heure = r.heure_reservation ? r.heure_reservation.slice(0,5) : '—';
            var empl  = r.emplacement_table ? (emplLabels[r.emplacement_table]||r.emplacement_table) : '—';
            return '<tr>' +
              '<td><span class="history-date">' + d.toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'}) + '</span></td>' +
              '<td><span class="history-time">' + heure + '</span></td>' +
              '<td>' + r.nb_personnes + '</td>' +
              '<td>' + empl + '</td>' +
              '<td><span class="badge ' + (badgeMap[r.statut_reservation]||'') + '">' + (labelMap[r.statut_reservation]||r.statut_reservation) + '</span></td>' +
            '</tr>';
          }).join('') +
        '</tbody></table>';
      }

    } catch(err) {
      document.getElementById('upcoming-list').innerHTML = '<div class="empty"><span class="empty-icon">&#9888;</span><p>Impossible de charger les reservations.</p></div>';
    }
  }

  // ── Avis ─────────────────────────────────────────────────
  document.getElementById('form-avis').addEventListener('submit', async function(e) {
    e.preventDefault();
    var f = e.target;
    try {
      var res = await fetch('/avis', { method:'POST', headers:authHdr(), body:JSON.stringify({ note_avis:selectedNote, commentaire_avis:f.commentaire_avis.value.trim(), id_client:serverUser.id }) });
      var data = await res.json();
      if (res.ok) {
        showFbk('avis-fbk', true, 'Merci ! Votre avis sera visible apres validation.');
        f.reset(); selectedNote=5;
        document.querySelectorAll('.star-btn').forEach(function(s){s.classList.add('active');});
        document.getElementById('star-hint').textContent='Excellent !';
      } else { showFbk('avis-fbk', false, data.error||'Erreur.'); }
    } catch(e) { showFbk('avis-fbk', false, 'Erreur de connexion.'); }
  });

  // ── Profil ────────────────────────────────────────────────
  function openModalProfil() {
    document.getElementById('ep-prenom').value = serverUser.prenom    || '';
    document.getElementById('ep-nom').value    = serverUser.nom       || '';
    document.getElementById('ep-tel').value    = serverUser.telephone || '';
    document.getElementById('profil-fbk').style.display = 'none';
    document.getElementById('modal-profil').classList.add('show');
  }
  document.getElementById('form-profil').addEventListener('submit', async function(e) {
    e.preventDefault();
    var f = e.target;
    try {
      var res = await fetch('/clients/' + serverUser.id, { method:'PUT', headers:authHdr(), body:JSON.stringify({ nom_client:f.nom_client.value.trim(), prenom_client:f.prenom_client.value.trim(), telephone_client:f.telephone_client.value.trim()||null }) });
      if (res.ok) {
        var tel = f.telephone_client.value.trim();
        var prenom = f.prenom_client.value.trim();
        var nom    = f.nom_client.value.trim();
        document.getElementById('pf-prenom').textContent = prenom || '—';
        document.getElementById('pf-nom').textContent    = nom    || '—';
        document.getElementById('pf-tel').textContent    = tel ? '📞 '+tel : '—';
        document.getElementById('pm-name').textContent   = (prenom+' '+nom).trim() || '—';
        serverUser.prenom=prenom; serverUser.nom=nom; serverUser.telephone=tel;
        showToast('Profil mis a jour !');
        closeModal('modal-profil');
      } else { var err=await res.json(); showFbk('profil-fbk', false, err.error||'Erreur'); }
    } catch(e) { showFbk('profil-fbk', false, 'Erreur de connexion.'); }
  });

  // ── Mot de passe ──────────────────────────────────────────
  function openModalPassword() {
    document.getElementById('form-pwd').reset();
    document.getElementById('pwd-fbk').style.display='none';
    document.getElementById('modal-password').classList.add('show');
  }
  document.getElementById('form-pwd').addEventListener('submit', async function(e) {
    e.preventDefault();
    var f=e.target;
    if (f.new_password.value!==f.confirm_password.value){showFbk('pwd-fbk',false,'Les mots de passe ne correspondent pas.');return;}
    try {
      var res=await fetch('/auth/change-password',{method:'POST',headers:authHdr(),body:JSON.stringify({new_password:f.new_password.value})});
      if(res.ok){showToast('Mot de passe modifie !');closeModal('modal-password');}
      else{var err=await res.json();showFbk('pwd-fbk',false,err.error||'Erreur.');}
    } catch(e){showFbk('pwd-fbk',false,'Erreur de connexion.');}
  });

  // ── Modifier reservation ──────────────────────────────────
  function openModalEditRes(id,date,heure,nb,emplEnc,dEnc) {
    document.getElementById('er-id').value       = id;
    document.getElementById('er-date').value     = date;
    document.getElementById('er-heure').value    = heure;
    document.getElementById('er-nb').value       = nb;
    document.getElementById('er-demandes').value = decodeURIComponent(dEnc);
    document.getElementById('er-date').min       = new Date().toISOString().split('T')[0];
    document.getElementById('edit-res-fbk').style.display = 'none';
    var empl = decodeURIComponent(emplEnc);
    selectedEmpl = empl;
    document.querySelectorAll('.empl-pill').forEach(function(p){
      var r=p.querySelector('input[type="radio"]');
      if(r) p.classList.toggle('active', r.value===empl);
    });
    var j=getJour(date);
    erHD.textContent = j!==null ? horaires[j].label : 'Ferme le lundi'; erHD.className='fhint';
    erHH.textContent = heureOk(j,heure) ? 'Heure valide ✓' : (j!==null?horaires[j].label:'');
    erHH.className   = heureOk(j,heure) ? 'fhint ok' : 'fhint';
    erDate.classList.remove('invalid'); erHeure.classList.remove('invalid');
    document.getElementById('modal-edit-res').classList.add('show');
  }
  document.getElementById('form-edit-res').addEventListener('submit', async function(e) {
    e.preventDefault();
    var f=e.target; var id=document.getElementById('er-id').value;
    var j=getJour(f.date_reservation.value);
    if(j===1){showFbk('edit-res-fbk',false,'Nous sommes fermes le lundi.');return;}
    if(!heureOk(j,f.heure_reservation.value)){showFbk('edit-res-fbk',false,'Heure invalide. '+(horaires[j]?horaires[j].label:''));return;}
    try {
      var res=await fetch('/reservations/'+id,{method:'PUT',headers:authHdr(),body:JSON.stringify({date_reservation:f.date_reservation.value,heure_reservation:f.heure_reservation.value,nb_personnes:parseInt(f.nb_personnes.value),emplacement_table:selectedEmpl||null,demandes_speciales:f.demandes_speciales.value.trim()||null})});
      if(res.ok){showToast('Reservation modifiee !');closeModal('modal-edit-res');loadReservations();}
      else{var err=await res.json();showFbk('edit-res-fbk',false,err.error||(err.errors&&err.errors[0])||'Erreur.');}
    } catch(e){showFbk('edit-res-fbk',false,'Erreur de connexion.');}
  });

  // ── Annuler ───────────────────────────────────────────────
  function cancelRes(id) {
    showConfirm('&#128197;','Annuler la reservation ?','Cette action est definitive. La reservation sera marquee comme annulee.', async function() {
      try {
        var res=await fetch('/reservations/'+id,{method:'PUT',headers:authHdr(),body:JSON.stringify({statut_reservation:'annulee'})});
        if(res.ok){showToast('Reservation annulee.','warning');loadReservations();}
        else{showToast('Erreur.','error');}
      } catch(e){showToast('Erreur de connexion.','error');}
    });
  }

  // ── Supprimer compte ──────────────────────────────────────
  function confirmDelete() {
    showConfirm('&#128465;','Supprimer mon compte ?','Toutes vos donnees personnelles seront definitivement effacees. Cette action est irreversible.', function() {
      fetch('/clients/'+serverUser.id,{method:'DELETE',headers:{'Authorization':'Bearer '+getToken()}})
        .then(function(r){if(r.ok)window.location.href='/logout';else showToast('Erreur.','error');})
        .catch(function(){showToast('Erreur de connexion.','error');});
    });
  }

  loadReservations();
</script>

</body>
</html>