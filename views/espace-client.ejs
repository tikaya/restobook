            <label class="empl-pill" onclick="selectEmpl(this,'interieur')"><input type="radio" value="interieur"> &#127968; Interieur</label>
            <label class="empl-pill" onclick="selectEmpl(this,'terrasse')"><input type="radio" value="terrasse"> &#127807; Terrasse</label>
