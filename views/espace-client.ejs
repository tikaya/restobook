          </div>
          <div class="fgroup">
            <label class="flabel">Nom *</label>
            <input type="text" name="nom_client" id="ep-nom" class="finput" required placeholder="Dupont">
          </div>
        </div>
        <div class="fgroup">
          <label class="flabel">Telephone</label>
          <input type="tel" name="telephone_client" id="ep-tel" class="finput" placeholder="06 00 00 00 00">
