<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  /* ── Hero ── */
  .legal-hero {
    background: var(--bordeaux);
    padding: 3.5rem 2rem 4.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .legal-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(201,168,76,0.08), transparent);
  }
  .legal-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50px;
    background: var(--creme);
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .legal-hero-content { position: relative; z-index: 1; }
  .legal-hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.75rem;
  }
  .legal-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: #fff;
    font-weight: 700;
  }

  /* ── Page body ── */
  .legal-page {
    background: var(--creme);
    padding: 3rem 2rem 5rem;
  }
  .legal-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  /* ── Card principale ── */
  .legal-card {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 4px 24px rgba(61,43,31,0.06);
  }

  /* ── Sections ── */
  .legal-section { margin-bottom: 2.5rem; }
  .legal-section:last-child { margin-bottom: 0; }

  .legal-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .legal-section-icon {
    width: 36px; height: 36px;
    background: var(--bordeaux-pale, #f5eaec);
    color: var(--bordeaux);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .legal-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    color: var(--bordeaux);
    font-weight: 700;
  }
  .legal-section-line {
    width: 100%;
    height: 1px;
    background: var(--creme-dark);
    margin-bottom: 1rem;
  }

  .legal-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: var(--brun-light);
    line-height: 1.8;
  }
  .legal-text strong {
    color: var(--brun);
    font-weight: 600;
    font-style: normal;
  }
  .legal-text a {
    color: var(--bordeaux);
    text-decoration: none;
    border-bottom: 1px solid rgba(107,26,42,0.3);
    transition: border-color 0.2s;
  }
  .legal-text a:hover { border-color: var(--bordeaux); }

  /* Chip info */
  .legal-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--creme);
    border: 1px solid var(--creme-dark);
    border-radius: 6px;
    padding: 0.5rem 0.9rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    color: var(--brun-light);
    margin-top: 0.5rem;
    width: fit-content;
  }

  /* RGPD highlight */
  .rgpd-box {
    background: #f5eaec;
    border: 1px solid rgba(107,26,42,0.12);
    border-radius: 10px;
    padding: 1.25rem 1.25rem 1.25rem 1rem;
    border-left: 3px solid var(--bordeaux);
    margin-top: 0.75rem;
  }
  .rgpd-box p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    line-height: 1.7;
  }

  /* Séparateur entre sections */
  .legal-sep {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0;
  }
  .legal-sep-line { flex: 1; height: 1px; background: var(--creme-dark); }
  .legal-sep-diamond {
    width: 6px; height: 6px;
    background: var(--or);
    transform: rotate(45deg);
    flex-shrink: 0;
    opacity: 0.6;
  }
</style>

<!-- Hero -->
<section class="legal-hero">
  <div class="legal-hero-content">
    <p class="legal-hero-eyebrow">Le Gourmet Parisien</p>
    <h1>Mentions légales</h1>
  </div>
</section>

