        </p>
        <div class="legal-chip">📞 01 23 45 67 89</div><br>
        <div class="legal-chip">✉️ contact@gourmet-parisien.fr</div>
      </div>

      <div class="legal-sep">
        <div class="legal-sep-line"></div>
        <div class="legal-sep-diamond"></div>
        <div class="legal-sep-line"></div>
      </div>

      <!-- Responsable publication -->
