<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --bordeaux: #6B1A2A; --bordeaux-light: #8B2A3A; --bordeaux-dark: #401018;
    --bordeaux-pale: #f5eaec; --bordeaux-ultra: #fdf0f2;
    --or: #C9A84C; --or-light: #fdf6e3; --or-dark: #a8873a;
    --creme: #FAF6F0; --creme-dark: #EDE5D8;
    --brun: #3D2B1F; --brun-light: #7A5C4A;
    --blanc: #FFFFFF;
    --shadow: 0 4px 20px rgba(61,43,31,0.08);
    --shadow-lg: 0 12px 48px rgba(61,43,31,0.14);
  }

  /* ── Hero ── */
  .carte-hero {
    position: relative;
    background: linear-gradient(160deg, var(--bordeaux-dark) 0%, var(--bordeaux) 55%, var(--bordeaux-light) 100%);
    padding: 6rem 2rem 5rem;
    overflow: hidden;
    text-align: center;
  }
  .carte-hero::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 50%, rgba(201,168,76,0.12), transparent 60%),
      radial-gradient(ellipse 50% 70% at 80% 20%, rgba(201,168,76,0.06), transparent 50%);
  }
  /* Motif decoratif */
  .carte-hero-deco {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 600px; height: 600px;
    border: 1px solid rgba(201,168,76,0.06);
    border-radius: 50%;
    pointer-events: none;
  }
  .carte-hero-deco::before {
    content: ''; position: absolute; inset: 40px;
    border: 1px solid rgba(201,168,76,0.04);
    border-radius: 50%;
  }
  .carte-hero::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 60px; background: var(--creme);
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .carte-hero-content { position: relative; z-index: 1; max-width: 600px; margin: 0 auto; }

  .carte-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 0.75rem;
    font-family: 'DM Sans', sans-serif; font-size: 0.65rem;
    font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--or); margin-bottom: 1.25rem; opacity: 0.9;
  }
  .carte-hero-eyebrow::before,
  .carte-hero-eyebrow::after { content: ''; width: 28px; height: 1px; background: var(--or); opacity: 0.5; }

  .carte-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: #fff; font-weight: 700; line-height: 1.1; margin-bottom: 1rem;
  }
  .carte-hero h1 em { font-style: italic; color: var(--or); }
  .carte-hero-sub {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem; color: rgba(255,255,255,0.55); font-style: italic;
  }

  /* ── Filtres sticky ── */
  .filters-section {
    background: rgba(250,246,240,0.96);
    backdrop-filter: blur(12px);
    padding: 1.25rem 2rem;
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--creme-dark);
    box-shadow: 0 2px 20px rgba(61,43,31,0.06);
  }
  .filters-inner {
    max-width: 1100px; margin: 0 auto;
    display: flex; justify-content: center;
    gap: 0.5rem; flex-wrap: wrap;
  }
  .filter-btn {
    background: var(--blanc); border: 1.5px solid var(--creme-dark);
    padding: 0.45rem 1.1rem; border-radius: 50px;
    font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 500;
    color: var(--brun-light); cursor: pointer; transition: all 0.2s;
  }
  .filter-btn:hover { border-color: var(--bordeaux); color: var(--bordeaux); transform: translateY(-1px); }
  .filter-btn.active {
    background: var(--bordeaux); color: #fff; border-color: var(--bordeaux);
    box-shadow: 0 4px 14px rgba(107,26,42,0.25);
  }

  /* ── Body ── */
  .carte-body { background: var(--creme); padding: 3rem 2rem 6rem; }
  .carte-inner { max-width: 1100px; margin: 0 auto; }

  /* ── Section categorie ── */
  .cat-section { margin-bottom: 4.5rem; }

  .cat-header { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2rem; }
  .cat-header-line { flex: 1; height: 1px; background: linear-gradient(to right, var(--creme-dark), transparent); }
  .cat-header-line.rev { background: linear-gradient(to left, var(--creme-dark), transparent); }
  .cat-title-wrap { text-align: center; white-space: nowrap; }
  .cat-title { font-family: 'Playfair Display', serif; font-size: 1.7rem; color: var(--bordeaux); font-weight: 700; }
  .cat-count { font-size: 0.68rem; color: var(--brun-light); text-transform: uppercase; letter-spacing: 0.12em; display: block; margin-top: 0.15rem; }

  /* ── Grille plats ── */
  .plats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem; }

  /* ── Carte plat ── */
  .plat-card {
    background: var(--blanc); border: 1px solid var(--creme-dark);
    border-radius: 18px; overflow: hidden;
    transition: all 0.3s ease; display: flex; flex-direction: column;
    box-shadow: var(--shadow);
  }
  .plat-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: rgba(107,26,42,0.12); }

  /* Zone image */
  .plat-img {
    height: 190px; position: relative; overflow: hidden; flex-shrink: 0;
    background: linear-gradient(135deg, var(--creme-dark), #e0d4c4);
  }
  .plat-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s ease;
  }
  .plat-card:hover .plat-img img { transform: scale(1.05); }
  .plat-img-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--creme-dark) 0%, #e8ddd0 50%, var(--creme-dark) 100%);
    position: relative;
  }
  .plat-img-placeholder::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(circle at 35% 40%, rgba(201,168,76,0.18), transparent 60%);
  }
  .plat-img-icon { font-size: 3rem; opacity: 0.18; position: relative; z-index: 1; }

  /* Badge categorie sur image */
  .plat-cat-badge {
    position: absolute; top: 0.75rem; left: 0.75rem;
    background: rgba(61,43,31,0.65); backdrop-filter: blur(6px);
    color: var(--or); font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.25rem 0.65rem; border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
  }

  /* Corps carte */
  .plat-body { padding: 1.25rem 1.25rem 1rem; flex: 1; display: flex; flex-direction: column; }

  .plat-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.6rem; }
  .plat-nom { font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700; color: var(--brun); line-height: 1.3; flex: 1; }
  .plat-prix {
    font-family: 'Cormorant Garamond', serif; font-size: 1.3rem;
    font-weight: 600; color: var(--bordeaux); white-space: nowrap; flex-shrink: 0;
    background: var(--bordeaux-ultra); padding: 0.1rem 0.5rem; border-radius: 6px;
  }

  .plat-desc {
    font-family: 'Cormorant Garamond', serif; font-size: 0.97rem;
    color: var(--brun-light); line-height: 1.65; font-style: italic;
    flex: 1; margin-bottom: 0.875rem;
  }

  .plat-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 0.75rem; border-top: 1px solid var(--creme-dark); margin-top: auto; gap: 0.5rem;
  }
  .plat-allergenes {
    font-size: 0.7rem; color: #b45309; background: #fef3c7;
    padding: 0.2rem 0.55rem; border-radius: 4px;
    display: flex; align-items: center; gap: 0.25rem;
    max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    border: 1px solid rgba(180,83,9,0.15);
  }
  .plat-dispo {
    font-size: 0.68rem; font-weight: 600; color: #2e7d32;
    display: flex; align-items: center; gap: 0.3rem;
    font-family: 'DM Sans', sans-serif; letter-spacing: 0.04em;
  }
  .plat-dispo::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: #2e7d32; display: inline-block;
    box-shadow: 0 0 6px rgba(46,125,50,0.4);
    animation: pulse-green 2s infinite;
  }
  @keyframes pulse-green {
    0%, 100% { box-shadow: 0 0 4px rgba(46,125,50,0.4); }
    50%       { box-shadow: 0 0 10px rgba(46,125,50,0.7); }
  }

  /* ── CTA ── */
  .carte-cta {
    background: linear-gradient(160deg, var(--bordeaux-dark), var(--bordeaux));
    padding: 5rem 2rem; text-align: center; position: relative; overflow: hidden;
  }
  .carte-cta::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 80% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .carte-cta-content { position: relative; z-index: 1; }
  .carte-cta h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    color: #fff; margin-bottom: 0.75rem;
  }
  .carte-cta h2 em { font-style: italic; color: var(--or); }
  .carte-cta p {
    font-family: 'Cormorant Garamond', serif; font-size: 1.1rem;
    color: rgba(255,255,255,0.6); font-style: italic; margin-bottom: 2rem;
  }
  .btn-reserver {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: linear-gradient(135deg, var(--or), var(--or-dark));
    color: var(--bordeaux-dark); font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; text-decoration: none;
    padding: 0.95rem 2.25rem; border-radius: 50px;
    transition: all 0.25s; box-shadow: 0 6px 24px rgba(201,168,76,0.35);
  }
  .btn-reserver:hover { transform: translateY(-3px); box-shadow: 0 10px 36px rgba(201,168,76,0.5); background: #fff; }

  /* Animations */
  .cat-section { animation: fadeUp 0.45s ease both; }
  @keyframes fadeUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }

  @media (max-width: 768px) {
    .plats-grid { grid-template-columns: 1fr; }
    .plat-img { height: 160px; }
  }
</style>

<!-- Hero -->
<section class="carte-hero">
  <div class="carte-hero-deco"></div>
  <div class="carte-hero-content">
    <p class="carte-hero-eyebrow">Le Gourmet Parisien</p>
    <h1>Notre <em>Carte</em></h1>
    <p class="carte-hero-sub">Des produits frais, de saison, cuisines avec passion</p>
  </div>
</section>

<!-- Filtres sticky -->
<section class="filters-section">
  <div class="filters-inner">
    <button class="filter-btn active" onclick="filterPlats('all', this)">&#10022; Tout voir</button>
    <% categories.forEach(function(cat) { %>
      <button class="filter-btn" onclick="filterPlats(<%= cat.id_categorie %>, this)">
        <%= cat.nom_categorie %>
      </button>
    <% }); %>
  </div>
</section>

<!-- Plats par categorie -->
<section class="carte-body">
  <div class="carte-inner">

    <% categories.forEach(function(cat) {
      var platsDecat = plats.filter(function(p) {
        return String(p.id_categorie) === String(cat.id_categorie) && p.disponible_item_menu;
      });
    %>
      <% if (platsDecat.length > 0) { %>

        <div class="cat-section" data-cat="<%= cat.id_categorie %>">

          <div class="cat-header">
            <div class="cat-header-line"></div>
            <div class="cat-title-wrap">
              <span class="cat-title"><%= cat.nom_categorie %></span>
              <span class="cat-count"><%= platsDecat.length %> plat<%= platsDecat.length > 1 ? 's' : '' %></span>
            </div>
            <div class="cat-header-line rev"></div>
          </div>

          <div class="plats-grid">
            <% platsDecat.forEach(function(plat) { %>
              <div class="plat-card">

                <!-- Image ou placeholder -->
                <div class="plat-img">
                  <% if (plat.image_item_menu) { %>
                    <img src="<%= plat.image_item_menu %>" alt="<%= plat.nom_item_menu %>" loading="lazy">
                  <% } else { %>
                    <div class="plat-img-placeholder">
                      <span class="plat-img-icon">&#127869;</span>
                    </div>
                  <% } %>
                  <span class="plat-cat-badge"><%= cat.nom_categorie %></span>
                </div>

                <!-- Corps -->
                <div class="plat-body">
                  <div class="plat-top">
                    <h3 class="plat-nom"><%= plat.nom_item_menu %></h3>
                    <span class="plat-prix"><%= plat.prix_item_menu ? parseFloat(plat.prix_item_menu).toFixed(2) : '—' %> &#8364;</span>
                  </div>

                  <% if (plat.description_item_menu) { %>
                    <p class="plat-desc"><%= plat.description_item_menu %></p>
                  <% } else { %>
                    <p class="plat-desc" style="opacity:0.35;">Demandez a votre serveur.</p>
                  <% } %>

                  <div class="plat-footer">
                    <% if (plat.allergenes_item_menu) { %>
                      <span class="plat-allergenes">&#9888; <%= plat.allergenes_item_menu %></span>
                    <% } else { %>
                      <span></span>
                    <% } %>
                    <span class="plat-dispo">Disponible</span>
                  </div>
                </div>

              </div>
            <% }); %>
          </div>

        </div>

      <% } %>
    <% }); %>

  </div>
</section>

<!-- CTA -->
<section class="carte-cta">
  <div class="carte-cta-content">
    <h2>Un plat vous <em>tente</em> ?</h2>
    <p>Reservez votre table et venez le deguster ce soir</p>
    <a href="/reservation" class="btn-reserver">Reserver une table &#8594;</a>
  </div>
</section>

<script>
  function filterPlats(catId, btn) {
    document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    document.querySelectorAll('.cat-section').forEach(function(section) {
      if (catId === 'all') {
        section.style.display = 'block';
      } else {
        section.style.display = String(section.dataset.cat) === String(catId) ? 'block' : 'none';
      }
    });
  }
</script>

<%- include('partials/footer') %>