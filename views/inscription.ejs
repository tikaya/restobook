<%- include('partials/header') %>

    <section class="hero" style="padding: 3.5rem 2rem;">
        <div class="hero-content" style="max-width:600px;">
            <h1 style="font-size: clamp(2rem, 4vw, 3rem);">Créer un compte</h1>
            <div class="hero-divider"></div>
            <p class="hero-subtitle">Rejoignez-nous pour réserver en quelques clics</p>
        </div>
    </section>

    <section style="background: var(--creme); padding: 4rem 2rem;">
        <div style="max-width: 550px; margin: 0 auto;">
            <div class="card">
                <h2 class="card-title">Inscription</h2>
                <div class="card-underline"></div>

                <div id="message" style="display:none; padding: 1rem; border-radius: 4px; margin-bottom: 1.5rem;"></div>

                <form id="inscription-form" style="display: flex; flex-direction: column; gap: 1.2rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div>
                            <label class="form-label">Nom *</label>
                            <input type="text" name="nom_client" class="form-input" required>
                        </div>
                        <div>
                            <label class="form-label">Prénom *</label>
                            <input type="text" name="prenom_client" class="form-input" required>
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Email *</label>
                        <input type="email" name="email_client" class="form-input" required>
                    </div>
                    <div>
                        <label class="form-label">Téléphone</label>
                        <input type="tel" name="telephone_client" class="form-input">
                    </div>
                    <div>
                        <label class="form-label">Mot de passe *</label>
                        <input type="password" name="mdp_client" class="form-input" required>
                        <p style="font-size: 0.75rem; color: var(--brun-light); margin-top: 0.3rem;">
                            8 caractères minimum, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial
                        </p>
                    </div>
                    <div>
                        <label class="form-label">Confirmer le mot de passe *</label>
                        <input type="password" name="mdp_confirm" class="form-input" required>
                    </div>
                    <button type="submit" class="btn-primary" style="width: 100%; border: none; cursor: pointer;">
                        Créer mon compte
                    </button>
                    <div style="text-align: center; padding-top: 1rem; border-top: 1px solid var(--creme-dark);">
                        <p style="color: var(--brun-light); font-size: 0.85rem;">Déjà un compte ?</p>
                        <a href="/login" style="color: var(--or-dark); font-weight: 700; text-decoration: none;">
                            Se connecter →
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <style>
        .form-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--brun);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.4rem;
        }
        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--creme-dark);
            border-radius: 2px;
            font-family: 'Lato', sans-serif;
            font-size: 0.9rem;
            color: var(--brun);
            background: var(--creme);
            transition: border-color 0.2s;
        }
        .form-input:focus { outline: none; border-color: var(--bordeaux); }
    </style>

    <script>
        document.getElementById('inscription-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const msg = document.getElementById('message');

            if (form.mdp_client.value !== form.mdp_confirm.value) {
                msg.style.display = 'block';
                msg.style.background = '#fff0f0';
                msg.style.color = '#c0392b';
                msg.style.border = '1px solid #c0392b';
                msg.innerHTML = 'Les mots de passe ne correspondent pas';
                return;
            }

            const data = {
                email_client: form.email_client.value,
                mdp_client: form.mdp_client.value,
                nom_client: form.nom_client.value,
                prenom_client: form.prenom_client.value,
                telephone_client: form.telephone_client.value
            };

            try {
                const res = await fetch('/clients', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();

                if (res.ok) {
                    msg.style.display = 'block';
                    msg.style.background = '#e8f8f0';
                    msg.style.color = '#0a8754';
                    msg.style.border = '1px solid #0a8754';
                    msg.innerHTML = 'Compte créé avec succès ! Un email de confirmation a été envoyé. Redirection...';
                    form.reset();
                    setTimeout(() => window.location.href = '/login', 2500);
                } else {
                    msg.style.display = 'block';
                    msg.style.background = '#fff0f0';
                    msg.style.color = '#c0392b';
                    msg.style.border = '1px solid #c0392b';
                    msg.innerHTML = result.error || result.errors?.join('<br>') || 'Erreur';
                }
            } catch (err) {
                msg.style.display = 'block';
                msg.style.background = '#fff0f0';
                msg.style.color = '#c0392b';
                msg.innerHTML = 'Erreur de connexion au serveur';
            }
        });
    </script>

<%- include('partials/footer') %>