<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  .inscription-page {
    min-height: 100vh;
    background: var(--creme);
    display: flex;
    flex-direction: column;
  }

  .inscription-hero {
    background: var(--bordeaux);
    padding: 3.5rem 2rem 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .inscription-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .inscription-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50px;
    background: var(--creme);
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .inscription-hero-content { position: relative; z-index: 1; }
  .inscription-hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.75rem;
  }
  .inscription-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: #fff;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .inscription-hero h1 em { font-style: italic; color: var(--or); }
  .inscription-hero p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: rgba(255,255,255,0.65);
    font-style: italic;
  }

  .redirect-banner {
    background: linear-gradient(135deg, rgba(201,168,76,0.15), rgba(201,168,76,0.05));
    border: 1px solid rgba(201,168,76,0.3);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin: 1rem auto 0;
    max-width: 480px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.95);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }

  .inscription-container {
    max-width: 520px;
    margin: -1.5rem auto 4rem;
    padding: 0 1.5rem;
    position: relative;
    z-index: 10;
    flex: 1;
  }

  .inscription-card {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 8px 40px rgba(61,43,31,0.1);
  }
  .card-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.5rem;
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--bordeaux);
    margin-bottom: 0.3rem;
  }
  .card-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    color: var(--brun-light);
    font-style: italic;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--creme-dark);
  }

  .insc-msg {
    display: none;
    padding: 0.875rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .insc-msg.success { background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); }
  .insc-msg.error   { background: #fdecea; color: #c62828; border: 1px solid rgba(198,40,40,0.2); }

  .insc-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--brun-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .form-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--creme-dark);
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--brun);
    background: var(--creme);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }
  .form-input:focus {
    border-color: var(--bordeaux);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(107,26,42,0.08);
  }
  .form-hint {
    font-size: 0.72rem;
    color: var(--brun-light);
    line-height: 1.4;
    opacity: 0.8;
  }

  .pwd-strength { display: flex; gap: 3px; margin-top: 0.4rem; }
  .pwd-bar {
    flex: 1; height: 3px; border-radius: 2px;
    background: var(--creme-dark);
    transition: background 0.3s;
  }
  .pwd-bar.weak   { background: #c62828; }
  .pwd-bar.medium { background: var(--or); }
  .pwd-bar.strong { background: #2e7d32; }

  .rgpd-notice {
    background: linear-gradient(135deg, rgba(201,168,76,0.06), rgba(107,26,42,0.04));
    border: 1px solid rgba(201,168,76,0.25);
    border-radius: 8px;
    padding: 0.75rem 0.9rem;
    margin-top: 0.5rem;
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
  }
  .rgpd-icon {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--bordeaux);
    color: var(--or);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem;
  }
  .rgpd-text {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    color: var(--brun);
    line-height: 1.5;
  }
  .rgpd-text strong { font-weight: 600; color: var(--bordeaux); }
  .rgpd-text a {
    color: var(--or); font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(201,168,76,0.4);
    text-underline-offset: 2px;
    transition: all 0.2s;
  }
  .rgpd-text a:hover { color: var(--bordeaux); }

  .rgpd-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    padding: 0.5rem 0;
  }
  .rgpd-consent input[type="checkbox"] {
    width: 16px; height: 16px;
    accent-color: var(--bordeaux);
    margin-top: 2px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .rgpd-consent label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    color: var(--brun);
    line-height: 1.45;
    cursor: pointer;
  }
  .rgpd-consent label a {
    color: var(--or); font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rgpd-consent label a:hover { color: var(--bordeaux); }

  .btn-submit {
    width: 100%;
    padding: 0.85rem;
    background: var(--bordeaux);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 0.25rem;
  }
  .btn-submit:hover {
    background: #8B2A3A;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(107,26,42,0.3);
  }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .form-login-link {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid var(--creme-dark);
  }
  .form-login-link p {
    font-size: 0.82rem;
    color: var(--brun-light);
    margin-bottom: 0.3rem;
  }
  .form-login-link a {
    color: var(--or); font-weight: 700;
    text-decoration: none; font-size: 0.875rem;
    transition: color 0.2s;
  }
  .form-login-link a:hover { color: var(--bordeaux); }

  @media (max-width: 480px) { .form-row { grid-template-columns: 1fr; } }
</style>

<div class="inscription-page">

  <div class="inscription-hero">
    <div class="inscription-hero-content">
      <p class="inscription-hero-eyebrow">Le Gourmet Parisien</p>
      <h1>Creer un <em>compte</em></h1>
      <p>Rejoignez-nous pour reserver en quelques clics</p>

      <div class="redirect-banner" id="redirect-banner" style="display:none;">
        <span>📍</span>
        <span id="redirect-message">Inscrivez-vous pour continuer</span>
      </div>
    </div>
  </div>

  <div class="inscription-container">
    <div class="inscription-card">

      <p class="card-eyebrow">Nouveau client</p>
      <h2 class="card-title">Inscription</h2>
      <p class="card-subtitle">Remplissez le formulaire ci-dessous pour creer votre compte</p>

      <div class="insc-msg" id="message"></div>

      <form id="inscription-form" class="insc-form">

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Nom *</label>
            <input type="text" name="nom_client" class="form-input" placeholder="Dupont" required>
          </div>
          <div class="form-group">
            <label class="form-label">Prenom *</label>
            <input type="text" name="prenom_client" class="form-input" placeholder="Jean" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Email *</label>
          <input type="email" name="email_client" class="form-input" placeholder="jean.dupont@email.com" required>
        </div>

        <div class="form-group">
          <label class="form-label">Telephone</label>
          <input type="tel" name="telephone_client" class="form-input" placeholder="06 00 00 00 00">
        </div>

        <div class="form-group">
          <label class="form-label">Mot de passe *</label>
          <input type="password" name="mdp_client" class="form-input" id="pwd-input" placeholder="••••••••" required>
          <div class="pwd-strength">
            <div class="pwd-bar" id="bar1"></div>
            <div class="pwd-bar" id="bar2"></div>
            <div class="pwd-bar" id="bar3"></div>
            <div class="pwd-bar" id="bar4"></div>
          </div>
          <span class="form-hint">8 car. min · 1 majuscule · 1 chiffre · 1 symbole</span>
        </div>

        <div class="form-group">
          <label class="form-label">Confirmer le mot de passe *</label>
          <input type="password" name="mdp_confirm" class="form-input" id="pwd-confirm" placeholder="••••••••" required>
        </div>

        <div class="rgpd-notice">
          <div class="rgpd-icon">🔒</div>
          <div class="rgpd-text">
            <strong>Protection de vos donnees</strong><br>
            Vos informations sont collectees par <strong>Le Gourmet Parisien</strong> uniquement pour la gestion de votre compte et de vos reservations. Vous disposez d'un droit d'acces, de rectification et de suppression conformement au RGPD.
            <br>
            <a href="/politique-confidentialite">En savoir plus →</a>
          </div>
        </div>

        <div class="rgpd-consent">
          <input type="checkbox" id="rgpd-consent" name="rgpd_consent" required>
          <label for="rgpd-consent">
            J'accepte la <a href="/politique-confidentialite">politique de confidentialite</a> et le traitement de mes donnees. *
          </label>
        </div>

        <button type="submit" class="btn-submit" id="btn-submit">Creer mon compte</button>

        <div class="form-login-link">
          <p>Deja un compte ?</p>
          <a id="link-login" href="/login">Se connecter →</a>
        </div>

      </form>
    </div>
  </div>
</div>

<script>
  // ═══════════════════════════════════════════════
  // GESTION DU REDIRECT
  // ═══════════════════════════════════════════════
  var ALLOWED_REDIRECTS = ['/reservation', '/espace-client', '/avis', '/contact', '/carte'];

  function getRedirectFromUrl() {
    var params = new URLSearchParams(window.location.search);
    var raw = params.get('redirect');
    if (!raw) return null;
    return ALLOWED_REDIRECTS.indexOf(raw) !== -1 ? raw : null;
  }

  var redirectTo = getRedirectFromUrl();

  if (redirectTo) {
    var labels = {
      '/reservation':   'Inscrivez-vous pour finaliser votre reservation',
      '/espace-client': 'Inscrivez-vous pour acceder a votre espace',
      '/avis':          'Inscrivez-vous pour laisser un avis',
      '/contact':       'Inscrivez-vous pour nous contacter',
      '/carte':         'Inscrivez-vous pour decouvrir notre carte'
    };
    document.getElementById('redirect-message').textContent = labels[redirectTo] || 'Inscrivez-vous pour continuer';
    document.getElementById('redirect-banner').style.display = 'flex';
  }

  var linkLogin = document.getElementById('link-login');
  if (linkLogin && redirectTo) {
    linkLogin.href = '/login?redirect=' + encodeURIComponent(redirectTo);
  }

  // ═══════════════════════════════════════════════
  // Helper pour cookies (identique au login)
  // ═══════════════════════════════════════════════
  function setCookies(token, user) {
    document.cookie = 'token=' + token + '; path=/; max-age=86400; SameSite=Lax';
    document.cookie = 'user=' + encodeURIComponent(JSON.stringify(user)) + '; path=/; max-age=86400; SameSite=Lax';
  }

  // ── Indicateur force mot de passe ────────────────────────
  document.getElementById('pwd-input').addEventListener('input', function() {
    const val = this.value;
    let score = 0;
    if (val.length >= 8)           score++;
    if (/[A-Z]/.test(val))         score++;
    if (/[0-9]/.test(val))         score++;
    if (/[^A-Za-z0-9]/.test(val))  score++;

    const bars  = ['bar1','bar2','bar3','bar4'];
    const cls   = score <= 1 ? 'weak' : score <= 2 ? 'medium' : 'strong';
    bars.forEach((id, i) => {
      const bar = document.getElementById(id);
      bar.className = 'pwd-bar ' + (i < score ? cls : '');
    });
  });

  function showMsg(ok, text) {
    const msg = document.getElementById('message');
    msg.className = 'insc-msg ' + (ok ? 'success' : 'error');
    msg.style.display = 'block';
    msg.innerHTML = (ok ? '✓ ' : '✗ ') + text;
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ── Soumission ────────────────────────────────────────────
  document.getElementById('inscription-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn  = document.getElementById('btn-submit');

    if (!form.rgpd_consent.checked) {
      showMsg(false, 'Vous devez accepter la politique de confidentialite.');
      return;
    }

    if (form.mdp_client.value !== form.mdp_confirm.value) {
      showMsg(false, 'Les mots de passe ne correspondent pas.');
      return;
    }

    btn.disabled    = true;
    btn.textContent = 'Creation en cours...';

    const data = {
      email_client:     form.email_client.value.trim(),
      mdp_client:       form.mdp_client.value,
      nom_client:       form.nom_client.value.trim(),
      prenom_client:    form.prenom_client.value.trim(),
      telephone_client: form.telephone_client.value.trim()
    };

    try {
      const res    = await fetch('/clients', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();

      if (res.ok) {
        // ═══════════════════════════════════════════════════
        // ✅ CONNEXION AUTOMATIQUE après inscription
        // Le backend renvoie maintenant token + user
        // ═══════════════════════════════════════════════════
        if (result.token && result.user) {
          // On pose les cookies = utilisateur connecté
          setCookies(result.token, result.user);

          // Redirection intelligente
          var destination = redirectTo || '/espace-client';
          var prenom = result.user.prenom || 'a vous';
          var msgTxt = redirectTo
            ? 'Bienvenue ' + prenom + ' ! Retour a votre reservation...'
            : 'Bienvenue ' + prenom + ' ! Redirection vers votre espace...';

          showMsg(true, msgTxt);
          form.reset();
          setTimeout(() => window.location.href = destination, 1500);
        } else {
          // Fallback : si pas de token (rare), on redirige vers login
          var loginUrl = redirectTo
            ? '/login?redirect=' + encodeURIComponent(redirectTo)
            : '/login';
          showMsg(true, 'Compte cree ! Connectez-vous pour continuer...');
          form.reset();
          setTimeout(() => window.location.href = loginUrl, 2000);
        }
      } else {
        showMsg(false, result.error || (result.errors && result.errors.join('<br>')) || 'Une erreur est survenue.');
        btn.disabled    = false;
        btn.textContent = 'Creer mon compte';
      }
    } catch (err) {
      showMsg(false, 'Erreur de connexion au serveur.');
      btn.disabled    = false;
      btn.textContent = 'Creer mon compte';
    }
  });
</script>

<%- include('partials/footer') %>