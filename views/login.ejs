<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  .login-page {
    min-height: 100vh;
    background: var(--creme);
    display: flex;
    flex-direction: column;
  }

  /* ── Hero compact ── */
  .login-hero {
    background: var(--bordeaux);
    padding: 3.5rem 2rem 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .login-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .login-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50px;
    background: var(--creme);
    clip-path: ellipse(55% 100% at 50% 100%);
  }
  .login-hero-content { position: relative; z-index: 1; }
  .login-hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.75rem;
  }
  .login-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: #fff;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  .login-hero h1 em { font-style: italic; color: var(--or); }
  .login-hero p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: rgba(255,255,255,0.65);
    font-style: italic;
  }

  /* ── Container ── */
  .login-container {
    max-width: 480px;
    margin: -1.5rem auto 4rem;
    padding: 0 1.5rem;
    position: relative;
    z-index: 10;
    flex: 1;
  }

  /* ── Tabs ── */
  .login-tabs {
    display: flex;
    background: #fff;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
    box-shadow: 0 -4px 20px rgba(61,43,31,0.06);
    border: 1px solid var(--creme-dark);
    border-bottom: none;
  }
  .tab-btn {
    flex: 1;
    padding: 1rem;
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
    background: var(--creme-dark);
    color: var(--brun-light);
    position: relative;
  }
  .tab-btn.tab-active {
    background: #fff;
    color: var(--bordeaux);
    font-weight: 700;
  }
  .tab-btn.tab-active::after {
    content: '';
    position: absolute;
    bottom: 0; left: 20%; right: 20%;
    height: 2px;
    background: var(--bordeaux);
    border-radius: 2px 2px 0 0;
  }

  /* ── Card formulaire ── */
  .login-card {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-top: none;
    border-radius: 0 0 16px 16px;
    padding: 2rem;
    box-shadow: 0 8px 40px rgba(61,43,31,0.1);
  }

  /* ── Message feedback ── */
  .login-msg {
    display: none;
    padding: 0.875rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .login-msg.success { background: #e8f5e9; color: #2e7d32; border: 1px solid rgba(46,125,50,0.2); }
  .login-msg.error   { background: #fdecea; color: #c62828; border: 1px solid rgba(198,40,40,0.2); }

  /* ── Formulaire ── */
  .login-form { display: flex; flex-direction: column; gap: 1.1rem; }
  .login-form.hidden { display: none; }

  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--brun-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .form-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1.5px solid var(--creme-dark);
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--brun);
    background: var(--creme);
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }
  .form-input:focus {
    border-color: var(--bordeaux);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(107,26,42,0.08);
  }

  /* ── Bouton submit ── */
  .btn-submit {
    width: 100%;
    padding: 0.85rem;
    background: var(--bordeaux);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 0.25rem;
  }
  .btn-submit:hover {
    background: #8B2A3A;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(107,26,42,0.3);
  }

  /* ── Liens secondaires ── */
  .form-links {
    text-align: center;
    margin-top: 0.5rem;
  }
  .form-links a {
    color: var(--bordeaux);
    font-size: 0.82rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(107,26,42,0.3);
    transition: border-color 0.2s;
  }
  .form-links a:hover { border-color: var(--bordeaux); }

  .form-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.5rem 0;
    color: var(--brun-light);
    font-size: 0.75rem;
  }
  .form-divider::before, .form-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--creme-dark);
  }

  .form-register {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid var(--creme-dark);
  }
  .form-register p {
    font-size: 0.82rem;
    color: var(--brun-light);
    margin-bottom: 0.3rem;
  }
  .form-register a {
    color: var(--or);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .form-register a:hover { color: var(--bordeaux); }
</style>

<div class="login-page">

  <!-- Hero -->
  <div class="login-hero">
    <div class="login-hero-content">
      <p class="login-hero-eyebrow">Le Gourmet Parisien</p>
      <h1>Bon <em>retour</em></h1>
      <p>Accédez à votre espace personnel</p>
    </div>
  </div>

  <!-- Formulaire -->
  <div class="login-container">

    <!-- Tabs -->
    <div class="login-tabs">
      <button id="tab-client" class="tab-btn tab-active" onclick="switchTab('client')">👤 Client</button>
      <button id="tab-employe" class="tab-btn" onclick="switchTab('employe')">💼 Employé</button>
    </div>

    <div class="login-card">

      <!-- Message feedback -->
      <div class="login-msg" id="message"></div>

      <!-- Form Client -->
      <form id="form-client" class="login-form">

        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="email_client" class="form-input" placeholder="votre@email.com" required>
        </div>

        <div class="form-group">
          <label class="form-label">Mot de passe</label>
          <input type="password" name="mdp_client" class="form-input" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn-submit">Se connecter</button>

        <div class="form-links">
          <a href="/forgot-password">Mot de passe oublié ?</a>
        </div>

        <div class="form-register">
          <p>Pas encore de compte ?</p>
          <a href="/inscription">Créer un compte →</a>
        </div>

      </form>

      <!-- Form Employé -->
      <form id="form-employe" class="login-form hidden">

        <div class="form-group">
          <label class="form-label">Email professionnel</label>
          <input type="email" name="email_employe" class="form-input" placeholder="prenom@restobook.fr" required>
        </div>

        <div class="form-group">
          <label class="form-label">Mot de passe</label>
          <input type="password" name="mdp_employe" class="form-input" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn-submit">Se connecter</button>

      </form>

    </div>
  </div>
</div>

<script>
  function switchTab(type) {
    document.getElementById('message').className = 'login-msg';
    document.getElementById('message').style.display = 'none';
    const isClient = type === 'client';
    document.getElementById('form-client').classList.toggle('hidden', !isClient);
    document.getElementById('form-employe').classList.toggle('hidden', isClient);
    document.getElementById('tab-client').classList.toggle('tab-active', isClient);
    document.getElementById('tab-employe').classList.toggle('tab-active', !isClient);
  }

  function showMsg(ok, text) {
    const msg = document.getElementById('message');
    msg.className = 'login-msg ' + (ok ? 'success' : 'error');
    msg.style.display = 'block';
    msg.innerHTML = (ok ? '✓ ' : '✗ ') + text;
  }

  // ✅ Centralise la création des cookies
  // encodeURIComponent évite que les { } : " du JSON cassent le cookie
  // SameSite=Lax évite la perte du cookie lors de la navigation entre pages
  function setCookies(token, user) {
    document.cookie = `token=${token}; path=/; max-age=86400; SameSite=Lax`;
    document.cookie = `user=${encodeURIComponent(JSON.stringify(user))}; path=/; max-age=86400; SameSite=Lax`;
  }

  // ── Login Client ──────────────────────────────────────────
  document.getElementById('form-client').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn  = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = '⏳ Connexion...';

    try {
      const res = await fetch('/auth/login/client', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email_client: form.email_client.value.trim(),
          mdp_client:   form.mdp_client.value
        })
      });
      const data = await res.json();

      // ✅ return pour stopper — sinon le if(res.ok) s'exécute aussi
      if (data.mustChangePassword) {
        sessionStorage.setItem('tempToken', data.tempToken);
        showMsg(true, 'Changement de mot de passe requis. Redirection...');
        setTimeout(() => window.location.href = '/change-password', 1500);
        return;
      }

      if (res.ok) {
        setCookies(data.token, data.user);
        showMsg(true, 'Connexion réussie ! Redirection...');
        setTimeout(() => window.location.href = '/espace-client', 1200);
      } else {
        showMsg(false, data.error || 'Identifiants incorrects');
        btn.disabled = false;
        btn.textContent = 'Se connecter';
      }
    } catch {
      showMsg(false, 'Erreur de connexion au serveur');
      btn.disabled = false;
      btn.textContent = 'Se connecter';
    }
  });

  // ── Login Employé ─────────────────────────────────────────
  document.getElementById('form-employe').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn  = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.textContent = '⏳ Connexion...';

    try {
      const res = await fetch('/auth/login/employe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email_employe: form.email_employe.value.trim(),
          mdp_employe:   form.mdp_employe.value
        })
      });
      const data = await res.json();

      if (res.ok) {
        setCookies(data.token, data.user);
        showMsg(true, 'Connexion réussie ! Redirection...');
        const role = data.user.role;
        setTimeout(() => {
          window.location.href = role === 'gerant' ? '/espace-admin' : '/espace-serveur';
        }, 1200);
      } else {
        showMsg(false, data.error || 'Identifiants incorrects');
        btn.disabled = false;
        btn.textContent = 'Se connecter';
      }
    } catch {
      showMsg(false, 'Erreur de connexion au serveur');
      btn.disabled = false;
      btn.textContent = 'Se connecter';
    }
  });
</script>

<%- include('partials/footer') %>