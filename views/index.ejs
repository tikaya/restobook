<%- include('partials/header') %>

    <section class="hero">
        <div class="hero-border left"></div>
        <div class="hero-border right"></div>
        <div class="hero-content">
            <div class="hero-ornament">
                <div class="hero-ornament-line"></div>
                <div class="hero-ornament-diamond"></div>
                <div class="hero-ornament-line right"></div>
            </div>
            <h1>Le Gourmet<br>Parisien</h1>
            <div class="hero-divider"></div>
            <p class="hero-subtitle">Une cuisine raffinée au cœur du Marais</p>
            <p class="hero-tagline">Fondé par Sophie et Marc, deux passionnés de gastronomie</p>
            <div class="hero-ctas">
                <a href="/reservation" class="btn-primary" style="width:320px">Réserver une table</a>
                <a href="/carte" class="btn-outline" style="width:320px">Découvrir notre carte</a>
            </div>
        </div>
    </section>

    <div class="sep">
        <div class="sep-line"></div>
        <div class="sep-diamond"></div>
        <div class="sep-line"></div>
    </div>

    <section class="section-info">
        <div class="cards-grid">
            <div class="card reveal">
                <h2 class="card-title">Notre histoire</h2>
                <div class="card-underline"></div>
                <p class="card-text">
                    Fondé il y a trois ans par Sophie et Marc, Le Gourmet Parisien s'est rapidement imposé
                    comme une référence gastronomique dans le quartier du Marais. Notre crédo : une cuisine
                    raffinée à base de produits frais et de saison, accompagnée d'un service client irréprochable.
                </p>
                <div class="info-badges">
                    <span class="badge">📍 12 rue des Archives, 75004</span>
                    <span class="badge">📞 01 23 45 67 89</span>
                </div>
            </div>
            <div class="card reveal" style="transition-delay: 0.15s">
                <h2 class="card-title">Horaires d'ouverture</h2>
                <div class="card-underline"></div>
                <table class="horaires-table">
                    <thead>
                        <tr><th style="text-align:left">Jour</th><th>Horaires</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Lundi</td><td class="fermé">Fermé</td></tr>
                        <tr><td>Mardi – Vendredi</td><td>12h00 – 14h30 / 19h00 – 22h30</td></tr>
                        <tr><td>Samedi</td><td>12h00 – 15h00 / 19h00 – 23h00</td></tr>
                        <tr><td>Dimanche</td><td>12h00 – 15h00</td></tr>
                    </tbody>
                </table>
                <p class="brunch-note">✨ Brunch le dimanche de 11h à 14h</p>
            </div>
        </div>
    </section>

    <section class="section-photos">
        <div class="section-header reveal">
            <h2 class="section-title">Notre restaurant</h2>
            <div class="section-title-line"></div>
        </div>
        <div class="photos-grid">
            <div class="photo-card reveal" style="transition-delay:0.1s">
                <div class="photo-placeholder"><span class="photo-placeholder-icon">🍽️</span></div>
                <div class="photo-label">Notre salle au décor parisien authentique</div>
            </div>
            <div class="photo-card reveal" style="transition-delay:0.2s">
                <div class="photo-placeholder"><span class="photo-placeholder-icon">👨‍🍳</span></div>
                <div class="photo-label">Des créations raffinées et savoureuses</div>
            </div>
            <div class="photo-card reveal" style="transition-delay:0.3s">
                <div class="photo-placeholder"><span class="photo-placeholder-icon">🌿</span></div>
                <div class="photo-label">Un havre de paix au cœur du Marais</div>
            </div>
        </div>
    </section>

    <section class="section-avis">
        <div class="section-header reveal">
            <h2 class="section-title">Ce que disent nos clients</h2>
            <div class="section-title-line"></div>
            <div class="rating-global" style="margin-top:1.5rem">
                <div class="stars-display">★★★★☆</div>
                <p class="rating-text">4.2 / 5 — 127 avis vérifiés</p>
            </div>
        </div>
        <div class="avis-grid">
            <div class="avis-card reveal" style="transition-delay:0.1s">
                <div class="avis-header">
                    <div class="avis-author">
                        <div class="avatar" style="background:#722F37">M</div>
                        <div>
                            <div class="author-name">Marie L.</div>
                            <div class="author-stars">★★★★★</div>
                        </div>
                    </div>
                    <span class="avis-date">8 mars 2026</span>
                </div>
                <p class="avis-text">« Une soirée magique, des plats divins et un service impeccable. »</p>
            </div>
            <div class="avis-card reveal" style="transition-delay:0.2s">
                <div class="avis-header">
                    <div class="avis-author">
                        <div class="avatar" style="background:#2D6A4F">J</div>
                        <div>
                            <div class="author-name">Jean-Pierre D.</div>
                            <div class="author-stars">★★★★☆</div>
                        </div>
                    </div>
                    <span class="avis-date">5 mars 2026</span>
                </div>
                <p class="avis-text">« Excellente carte, belle terrasse. Un peu d'attente mais ça vaut le coup. »</p>
            </div>
            <div class="avis-card reveal" style="transition-delay:0.3s">
                <div class="avis-header">
                    <div class="avis-author">
                        <div class="avatar" style="background:#5B3A8C">S</div>
                        <div>
                            <div class="author-name">Sophie M.</div>
                            <div class="author-stars">★★★★★</div>
                        </div>
                    </div>
                    <span class="avis-date">1 mars 2026</span>
                </div>
                <p class="avis-text">« Le meilleur restaurant du quartier. On y revient chaque semaine ! »</p>
            </div>
        </div>
        <div class="voir-plus reveal">
            <a href="/avis">Voir tous les avis →</a>
        </div>
    </section>

    <section class="cta-band">
        <div class="cta-band-content reveal">
            <h2>Prêt à vivre l'expérience ?</h2>
            <p>Réservez votre table dès maintenant et laissez-vous surprendre</p>
            <a href="/reservation" class="btn-primary" style="width:auto; display:inline-block">Réserver une table</a>
        </div>
    </section>

<%- include('partials/footer') %>