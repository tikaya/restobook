<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  /* ── Hero ── */
  .home-hero {
    position: relative;
    min-height: 92vh;
    background: var(--bordeaux);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 4rem 2rem;
  }

  /* Effets de lumière */
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 20% 30%, rgba(201,168,76,0.15) 0%, transparent 55%),
      radial-gradient(ellipse 50% 70% at 80% 70%, rgba(255,255,255,0.04) 0%, transparent 50%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(201,168,76,0.06) 0%, transparent 60%);
  }

  /* Grain texture */
  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: 0.4;
    pointer-events: none;
  }

  /* Bordures décoratives latérales */
  .hero-border-left,
  .hero-border-right {
    position: absolute;
    top: 2rem; bottom: 2rem;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.3) 30%, rgba(201,168,76,0.3) 70%, transparent);
  }
  .hero-border-left  { left: 2.5rem; }
  .hero-border-right { right: 2.5rem; }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
    animation: heroReveal 1.2s ease both;
  }
  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Ornement haut */
  .hero-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .hero-ornament-line {
    width: 50px;
    height: 1px;
    background: var(--or);
    opacity: 0.6;
  }
  .hero-ornament-diamond {
    width: 8px; height: 8px;
    background: var(--or);
    transform: rotate(45deg);
    opacity: 0.8;
  }

  .hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 1.25rem;
    opacity: 0.9;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: #fff;
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
  .hero-title em {
    font-style: italic;
    color: var(--or);
    display: block;
    font-size: 0.85em;
  }

  .hero-divider {
    width: 60px;
    height: 1px;
    background: var(--or);
    margin: 1.25rem auto;
    opacity: 0.6;
  }

  .hero-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: rgba(255,255,255,0.8);
    font-style: italic;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }
  .hero-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.45);
    margin-bottom: 2.5rem;
    letter-spacing: 0.04em;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--or);
    color: var(--bordeaux);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(201,168,76,0.35);
  }
  .hero-btn-primary:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(201,168,76,0.4);
  }
  .hero-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    border: 1.5px solid rgba(255,255,255,0.3);
    transition: all 0.25s ease;
  }
  .hero-btn-outline:hover {
    border-color: var(--or);
    color: var(--or);
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.3);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
    animation: scrollBounce 2s ease-in-out infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(6px); }
  }
  .hero-scroll::after {
    content: '';
    width: 1px;
    height: 30px;
    background: linear-gradient(to bottom, rgba(201,168,76,0.4), transparent);
  }

  /* Courbe de transition */
  .hero-wave {
    background: var(--bordeaux);
    line-height: 0;
  }
  .hero-wave svg { display: block; width: 100%; }

  /* ── Séparateur ── */
  .sep {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .sep-line { flex: 1; height: 1px; background: var(--creme-dark); }
  .sep-diamond {
    width: 8px; height: 8px;
    background: var(--or);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  /* ── Section info enrichie ── */
  .section-info {
    padding: 4rem 2rem;
    background: var(--creme);
  }
  .info-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  /* ===== Card Histoire ===== */
  .info-card-histoire {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(61,43,31,0.05);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .info-card-histoire:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(107,26,42,0.12);
  }

  /* Badge "Est. 2023" flottant */
  .est-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(201,168,76,0.4);
    border-radius: 50px;
    padding: 0.4rem 0.9rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bordeaux);
    font-weight: 600;
  }
  .est-badge span { color: var(--or); font-weight: 700; }

  .histoire-image {
    position: relative;
    height: 180px;
    overflow: hidden;
    background: linear-gradient(135deg, #8b4a5a 0%, var(--bordeaux) 100%);
  }
  .histoire-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .info-card-histoire:hover .histoire-image img {
    transform: scale(1.05);
  }
  .histoire-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(61,43,31,0.3) 100%);
  }

  .histoire-body {
    padding: 1.75rem 2rem 1.75rem;
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .histoire-quote {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    color: var(--or);
    opacity: 0.25;
    line-height: 0.5;
    margin-bottom: 0.5rem;
    font-style: italic;
  }

  .histoire-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--bordeaux);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .histoire-title em {
    font-style: italic;
    color: var(--or);
    font-weight: 400;
  }

  .histoire-line {
    width: 36px;
    height: 2px;
    background: var(--or);
    margin-bottom: 1rem;
    border-radius: 2px;
  }

  .histoire-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.02rem;
    color: var(--brun-light);
    line-height: 1.7;
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .histoire-signature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--creme-dark);
    margin-bottom: 1.25rem;
  }
  .signature-names {
    font-family: 'Cormorant Garamond', cursive;
    font-size: 1.2rem;
    font-style: italic;
    color: var(--bordeaux);
    font-weight: 600;
  }
  .signature-role {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    color: var(--brun-light);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.15rem;
  }

  .histoire-contact {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: auto;
  }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: var(--creme);
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    color: var(--brun);
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .contact-item:hover {
    background: rgba(201,168,76,0.08);
    transform: translateX(3px);
  }
  .contact-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bordeaux);
    color: var(--or);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  /* ===== Card Horaires ===== */
  .info-card-horaires {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 2px 16px rgba(61,43,31,0.05);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .info-card-horaires:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(107,26,42,0.12);
  }
  /* Motif horloge décoratif */
  .info-card-horaires::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(201,168,76,0.08) 0%, transparent 70%);
    border-radius: 50%;
  }

  .horaires-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
    gap: 1rem;
  }

  .horaires-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--bordeaux);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .horaires-title em {
    font-style: italic;
    color: var(--or);
    font-weight: 400;
  }
  .horaires-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    color: var(--brun-light);
    font-style: italic;
  }

  /* Indicateur Ouvert/Fermé */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(45, 106, 79, 0.1);
    color: #2D6A4F;
    padding: 0.4rem 0.85rem;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-badge.closed {
    background: rgba(198, 40, 40, 0.1);
    color: #c62828;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2D6A4F;
    animation: pulse 2s ease-in-out infinite;
  }
  .status-badge.closed .status-dot { background: #c62828; animation: none; }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(45,106,79,0.5); }
    50%      { box-shadow: 0 0 0 6px rgba(45,106,79,0); }
  }

  .horaires-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    position: relative;
    z-index: 1;
  }
  .horaires-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    transition: all 0.2s ease;
    margin-bottom: 0.2rem;
  }
  .horaires-list li.today {
    background: linear-gradient(135deg, rgba(201,168,76,0.12), rgba(201,168,76,0.04));
    border: 1px solid rgba(201,168,76,0.25);
  }
  .horaires-list li.today .day-name {
    color: var(--bordeaux);
    font-weight: 700;
  }
  .day-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--brun);
    font-weight: 500;
  }
  .day-hours {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    color: var(--brun);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .day-hours.closed {
    color: #c62828;
    font-style: italic;
    font-weight: 500;
  }
  .hours-split {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hours-sep {
    color: var(--or);
    opacity: 0.6;
  }

  .brunch-highlight {
    margin-top: 1.25rem;
    padding: 1rem 1.15rem;
    background: linear-gradient(135deg, var(--bordeaux) 0%, #8b3a4f 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .brunch-highlight::before {
    content: '';
    position: absolute;
    top: -20px; right: -20px;
    width: 80px; height: 80px;
    background: radial-gradient(circle, rgba(201,168,76,0.3), transparent 70%);
  }
  .brunch-icon {
    width: 40px; height: 40px;
    background: var(--or);
    color: var(--bordeaux);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
    font-weight: 700;
    position: relative;
    z-index: 1;
  }
  .brunch-text { position: relative; z-index: 1; }
  .brunch-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .brunch-hours {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    color: #fff;
    font-style: italic;
  }

  /* ── Section photos ── */
  .section-photos {
    padding: 4rem 2rem;
    background: var(--creme);
  }
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .section-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--bordeaux);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .section-title-line {
    width: 50px;
    height: 2px;
    background: var(--or);
    margin: 0 auto;
    border-radius: 2px;
  }

  .photos-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .photo-card {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--creme-dark);
    background: #fff;
    box-shadow: 0 2px 12px rgba(61,43,31,0.05);
    transition: all 0.3s ease;
  }
  .photo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(107,26,42,0.12);
  }
  .photo-placeholder {
    height: 200px;
    background: linear-gradient(135deg, var(--creme-dark) 0%, #e0d4c4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .photo-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 40% 40%, rgba(201,168,76,0.15), transparent 60%);
  }
  .photo-icon {
    font-size: 3rem;
    opacity: 0.2;
    position: relative;
    z-index: 1;
  }
  .photo-label {
    padding: 1rem 1.25rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    color: var(--brun-light);
    font-style: italic;
    text-align: center;
    line-height: 1.5;
  }

  /* ── Section avis ── */
  .section-avis {
    padding: 4rem 2rem;
    background: #fff;
    border-top: 1px solid var(--creme-dark);
    border-bottom: 1px solid var(--creme-dark);
  }

  .rating-global { text-align: center; }
  .stars-display {
    font-size: 1.8rem;
    color: var(--or);
    letter-spacing: 0.1em;
    margin-bottom: 0.3rem;
  }
  .rating-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    font-style: italic;
  }

  .avis-grid {
    max-width: 1100px;
    margin: 2.5rem auto 1.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .avis-card {
    background: var(--creme);
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s ease;
    position: relative;
  }
  .avis-card::before {
    content: '❝';
    position: absolute;
    top: 1rem; right: 1.25rem;
    font-size: 2rem;
    color: var(--or);
    opacity: 0.2;
    font-family: 'Playfair Display', serif;
    line-height: 1;
  }
  .avis-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(107,26,42,0.08);
    border-color: rgba(107,26,42,0.1);
  }

  .avis-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .avis-author { display: flex; align-items: center; gap: 0.75rem; }
  .avis-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  .author-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--brun);
    font-family: 'DM Sans', sans-serif;
  }
  .author-stars {
    color: var(--or);
    font-size: 0.75rem;
    margin-top: 0.1rem;
    letter-spacing: 0.05em;
  }
  .avis-date {
    font-size: 0.72rem;
    color: var(--brun-light);
    font-family: 'DM Sans', sans-serif;
    opacity: 0.7;
    white-space: nowrap;
  }
  .avis-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    font-style: italic;
    line-height: 1.65;
  }

  .voir-plus {
    text-align: center;
    margin-top: 1.5rem;
  }
  .voir-plus a {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--bordeaux);
    text-decoration: none;
    border-bottom: 1px solid rgba(107,26,42,0.3);
    padding-bottom: 2px;
    transition: border-color 0.2s;
    letter-spacing: 0.04em;
  }
  .voir-plus a:hover { border-color: var(--bordeaux); }

  /* ── CTA Band ── */
  .cta-band {
    background: var(--bordeaux);
    padding: 5rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .cta-band-content { position: relative; z-index: 1; }
  .cta-band h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .cta-band p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    color: rgba(255,255,255,0.65);
    font-style: italic;
    margin-bottom: 2rem;
  }
  .cta-band-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--or);
    color: var(--bordeaux);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2.5rem;
    border-radius: 50px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(201,168,76,0.35);
  }
  .cta-band-btn:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(201,168,76,0.4);
  }

  /* ── Reveal animations ── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .info-grid   { grid-template-columns: 1fr; }
    .photos-grid { grid-template-columns: 1fr; }
    .avis-grid   { grid-template-columns: 1fr; }
    .hero-border-left, .hero-border-right { display: none; }
    .histoire-image { height: 160px; }
  }
</style>

