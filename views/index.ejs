<%- include('partials/header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap');

  /* ── Hero ── */
  .home-hero {
    position: relative;
    min-height: 92vh;
    background: var(--bordeaux);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 4rem 2rem;
  }

  /* Effets de lumière */
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 20% 30%, rgba(201,168,76,0.15) 0%, transparent 55%),
      radial-gradient(ellipse 50% 70% at 80% 70%, rgba(255,255,255,0.04) 0%, transparent 50%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(201,168,76,0.06) 0%, transparent 60%);
  }

  /* Grain texture */
  .home-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: 0.4;
    pointer-events: none;
  }

  /* Bordures décoratives latérales */
  .hero-border-left,
  .hero-border-right {
    position: absolute;
    top: 2rem; bottom: 2rem;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.3) 30%, rgba(201,168,76,0.3) 70%, transparent);
  }
  .hero-border-left  { left: 2.5rem; }
  .hero-border-right { right: 2.5rem; }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
    animation: heroReveal 1.2s ease both;
  }
  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Ornement haut */
  .hero-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .hero-ornament-line {
    width: 50px;
    height: 1px;
    background: var(--or);
    opacity: 0.6;
  }
  .hero-ornament-diamond {
    width: 8px; height: 8px;
    background: var(--or);
    transform: rotate(45deg);
    opacity: 0.8;
  }

  .hero-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 1.25rem;
    opacity: 0.9;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: #fff;
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
  .hero-title em {
    font-style: italic;
    color: var(--or);
    display: block;
    font-size: 0.85em;
  }

  .hero-divider {
    width: 60px;
    height: 1px;
    background: var(--or);
    margin: 1.25rem auto;
    opacity: 0.6;
  }

  .hero-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: rgba(255,255,255,0.8);
    font-style: italic;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }
  .hero-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.45);
    margin-bottom: 2.5rem;
    letter-spacing: 0.04em;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--or);
    color: var(--bordeaux);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(201,168,76,0.35);
  }
  .hero-btn-primary:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(201,168,76,0.4);
  }
  .hero-btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    border: 1.5px solid rgba(255,255,255,0.3);
    transition: all 0.25s ease;
  }
  .hero-btn-outline:hover {
    border-color: var(--or);
    color: var(--or);
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.3);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-family: 'DM Sans', sans-serif;
    animation: scrollBounce 2s ease-in-out infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(6px); }
  }
  .hero-scroll::after {
    content: '';
    width: 1px;
    height: 30px;
    background: linear-gradient(to bottom, rgba(201,168,76,0.4), transparent);
  }

  /* Courbe de transition */
  .hero-wave {
    background: var(--bordeaux);
    line-height: 0;
  }
  .hero-wave svg { display: block; width: 100%; }

  /* ── Séparateur ── */
  .sep {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .sep-line { flex: 1; height: 1px; background: var(--creme-dark); }
  .sep-diamond {
    width: 8px; height: 8px;
    background: var(--or);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  /* ── Section info ── */
  .section-info {
    padding: 4rem 2rem;
    background: var(--creme);
  }
  .info-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .info-card {
    background: #fff;
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 2px 16px rgba(61,43,31,0.05);
    transition: all 0.3s ease;
  }
  .info-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(107,26,42,0.1);
  }

  .info-card-icon {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    display: block;
  }
  .info-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--bordeaux);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .info-card-line {
    width: 36px;
    height: 2px;
    background: var(--or);
    margin-bottom: 1rem;
    border-radius: 2px;
  }
  .info-card-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    line-height: 1.7;
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .info-badges {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .info-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--creme);
    border: 1px solid var(--creme-dark);
    border-radius: 50px;
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
    color: var(--brun-light);
    font-family: 'DM Sans', sans-serif;
    width: fit-content;
  }

  /* Horaires */
  .horaires-table { width: 100%; border-collapse: collapse; }
  .horaires-table tr { border-bottom: 1px solid var(--creme-dark); }
  .horaires-table tr:last-child { border-bottom: none; }
  .horaires-table td {
    padding: 0.55rem 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    color: var(--brun);
  }
  .horaires-table td:first-child { color: var(--brun-light); }
  .horaires-table td:last-child  { text-align: right; font-weight: 500; }
  .td-ferme { color: var(--rouge, #c62828) !important; font-style: italic; }
  .brunch-note {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    color: var(--or);
    font-style: italic;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--creme-dark);
  }

  /* ── Section photos ── */
  .section-photos {
    padding: 4rem 2rem;
    background: var(--creme);
  }
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .section-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--or);
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--bordeaux);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .section-title-line {
    width: 50px;
    height: 2px;
    background: var(--or);
    margin: 0 auto;
    border-radius: 2px;
  }

  .photos-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .photo-card {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--creme-dark);
    background: #fff;
    box-shadow: 0 2px 12px rgba(61,43,31,0.05);
    transition: all 0.3s ease;
  }
  .photo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(107,26,42,0.12);
  }
  .photo-placeholder {
    height: 200px;
    background: linear-gradient(135deg, var(--creme-dark) 0%, #e0d4c4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .photo-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 40% 40%, rgba(201,168,76,0.15), transparent 60%);
  }
  .photo-icon {
    font-size: 3rem;
    opacity: 0.2;
    position: relative;
    z-index: 1;
  }
  .photo-label {
    padding: 1rem 1.25rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.95rem;
    color: var(--brun-light);
    font-style: italic;
    text-align: center;
    line-height: 1.5;
  }

  /* ── Section avis ── */
  .section-avis {
    padding: 4rem 2rem;
    background: #fff;
    border-top: 1px solid var(--creme-dark);
    border-bottom: 1px solid var(--creme-dark);
  }

  .rating-global { text-align: center; }
  .stars-display {
    font-size: 1.8rem;
    color: var(--or);
    letter-spacing: 0.1em;
    margin-bottom: 0.3rem;
  }
  .rating-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    font-style: italic;
  }

  .avis-grid {
    max-width: 1100px;
    margin: 2.5rem auto 1.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .avis-card {
    background: var(--creme);
    border: 1px solid var(--creme-dark);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s ease;
    position: relative;
  }
  .avis-card::before {
    content: '❝';
    position: absolute;
    top: 1rem; right: 1.25rem;
    font-size: 2rem;
    color: var(--or);
    opacity: 0.2;
    font-family: 'Playfair Display', serif;
    line-height: 1;
  }
  .avis-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(107,26,42,0.08);
    border-color: rgba(107,26,42,0.1);
  }

  .avis-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .avis-author { display: flex; align-items: center; gap: 0.75rem; }
  .avis-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  .author-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--brun);
    font-family: 'DM Sans', sans-serif;
  }
  .author-stars {
    color: var(--or);
    font-size: 0.75rem;
    margin-top: 0.1rem;
    letter-spacing: 0.05em;
  }
  .avis-date {
    font-size: 0.72rem;
    color: var(--brun-light);
    font-family: 'DM Sans', sans-serif;
    opacity: 0.7;
    white-space: nowrap;
  }
  .avis-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--brun-light);
    font-style: italic;
    line-height: 1.65;
  }

  .voir-plus {
    text-align: center;
    margin-top: 1.5rem;
  }
  .voir-plus a {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--bordeaux);
    text-decoration: none;
    border-bottom: 1px solid rgba(107,26,42,0.3);
    padding-bottom: 2px;
    transition: border-color 0.2s;
    letter-spacing: 0.04em;
  }
  .voir-plus a:hover { border-color: var(--bordeaux); }

  /* ── CTA Band ── */
  .cta-band {
    background: var(--bordeaux);
    padding: 5rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(201,168,76,0.1), transparent);
  }
  .cta-band-content { position: relative; z-index: 1; }
  .cta-band h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .cta-band p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    color: rgba(255,255,255,0.65);
    font-style: italic;
    margin-bottom: 2rem;
  }
  .cta-band-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--or);
    color: var(--bordeaux);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2.5rem;
    border-radius: 50px;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(201,168,76,0.35);
  }
  .cta-band-btn:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(201,168,76,0.4);
  }

  /* ── Reveal animations ── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .info-grid   { grid-template-columns: 1fr; }
    .photos-grid { grid-template-columns: 1fr; }
    .avis-grid   { grid-template-columns: 1fr; }
    .hero-border-left, .hero-border-right { display: none; }
  }
</style>

<!-- ===== HERO ===== -->
<section class="home-hero">
  <div class="hero-border-left"></div>
  <div class="hero-border-right"></div>

  <div class="hero-content">
    <div class="hero-ornament">
      <div class="hero-ornament-line"></div>
      <div class="hero-ornament-diamond"></div>
      <div class="hero-ornament-line"></div>
    </div>

    <p class="hero-eyebrow">Bienvenue au</p>
    <h1 class="hero-title">
      Le Gourmet
      <em>Parisien</em>
    </h1>
    <div class="hero-divider"></div>
    <p class="hero-subtitle">Une cuisine raffinée au cœur du Marais</p>
    <p class="hero-tagline">Fondé par Sophie et Marc, deux passionnés de gastronomie</p>

    <div class="hero-ctas">
      <a href="/reservation" class="hero-btn-primary">Réserver une table →</a>
      <a href="/carte" class="hero-btn-outline">Découvrir la carte</a>
    </div>
  </div>

  <div class="hero-scroll">Scroll</div>
</section>

<!-- Vague de transition -->
<div class="hero-wave">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" height="60">
    <path d="M0,60 C360,0 1080,60 1440,20 L1440,60 Z" fill="var(--creme)"/>
  </svg>
</div>

<!-- ===== SEP ===== -->
<div style="padding: 2rem 2rem 0;">
  <div class="sep" style="max-width:1100px; margin:0 auto;">
    <div class="sep-line"></div>
    <div class="sep-diamond"></div>
    <div class="sep-line"></div>
  </div>
</div>

<!-- ===== INFO ===== -->
<section class="section-info">
  <div class="info-grid">

    <!-- Histoire -->
    <div class="info-card reveal">
      <span class="info-card-icon">🏛️</span>
      <h2 class="info-card-title">Notre histoire</h2>
      <div class="info-card-line"></div>
      <p class="info-card-text">
        Fondé il y a trois ans par Sophie et Marc, Le Gourmet Parisien s'est rapidement imposé
        comme une référence gastronomique dans le quartier du Marais. Notre crédo : une cuisine
        raffinée à base de produits frais et de saison, accompagnée d'un service irréprochable.
      </p>
      <div class="info-badges">
        <span class="info-badge">📍 12 rue des Archives, 75004 Paris</span>
        <span class="info-badge">📞 01 23 45 67 89</span>
      </div>
    </div>

    <!-- Horaires -->
    <div class="info-card reveal" style="transition-delay:0.15s">
      <span class="info-card-icon">🕐</span>
      <h2 class="info-card-title">Horaires d'ouverture</h2>
      <div class="info-card-line"></div>
      <table class="horaires-table">
        <tbody>
          <tr><td>Lundi</td><td class="td-ferme">Fermé</td></tr>
          <tr><td>Mardi – Vendredi</td><td>12h – 14h30 · 19h – 22h30</td></tr>
          <tr><td>Samedi</td><td>12h – 15h · 19h – 23h</td></tr>
          <tr><td>Dimanche</td><td>12h – 15h</td></tr>
        </tbody>
      </table>
      <p class="brunch-note">✨ Brunch dominical de 11h à 14h</p>
    </div>

  </div>
</section>

<!-- ===== PHOTOS ===== -->
<section class="section-photos">
  <div class="section-header reveal">
    <p class="section-eyebrow">Découvrez</p>
    <h2 class="section-title">Notre restaurant</h2>
    <div class="section-title-line"></div>
  </div>

  <div class="photos-grid">
    <div class="photo-card reveal" style="transition-delay:0.1s">
      <img src="/images/restaurant/salle.jpg" alt="Notre salle" style="width:100%;height:200px;object-fit:cover;">
<div class="photo-label">Notre salle au décor parisien authentique</div>
    </div>
    <div class="photo-card reveal" style="transition-delay:0.2s">
      <img src="/images/restaurant/plat.jpg"
     alt="Nos plats"
     style="width:100%;height:200px;object-fit:cover;"
     onerror="this.style.display='none'">
      <div class="photo-label">Des créations raffinées et savoureuses</div>
    </div>
    <div class="photo-card reveal" style="transition-delay:0.3s">
      <img src="/images/restaurant/terrasse.jpg"
     alt="Terrasse"
     style="width:100%;height:200px;object-fit:cover;"
     onerror="this.style.display='none'">
      <div class="photo-label">Un havre de paix au cœur du Marais</div>
    </div>
  </div>
</section>

<!-- ===== AVIS ===== -->
<section class="section-avis">
  <div class="section-header reveal">
    <p class="section-eyebrow">Témoignages</p>
    <h2 class="section-title">Ce que disent nos clients</h2>
    <div class="section-title-line"></div>
    <div class="rating-global" style="margin-top:1.5rem">
      <div class="stars-display">★★★★☆</div>
      <p class="rating-text">4.2 / 5 — 127 avis vérifiés</p>
    </div>
  </div>

  <div class="avis-grid">
    <div class="avis-card reveal" style="transition-delay:0.1s">
      <div class="avis-header">
        <div class="avis-author">
          <div class="avis-avatar" style="background:#722F37">M</div>
